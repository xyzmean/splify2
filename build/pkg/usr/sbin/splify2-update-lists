#!/bin/sh
# Обновляет списки, на которые указывают каналы, и применяет результат.
#
# Обновляются ТОЛЬКО используемые списки. Скачивать всё, что есть в манифесте, значило
# бы тратить трафик и место на то, что никуда не подключено, а на коробке с 6 МБ
# overlay это заметно.
#
# Адресные списки проходят через `steer fit`: движок один знает, сколько элементов
# коробка может держать, и без подгонки первый же большой список (в блоклисте РФ их
# 28 тысяч префиксов) упирается в память на слабом роутере. Доменные не подгоняются —
# у них нет размера в элементах набора, набор заполняет резолвер по мере запросов.
set -u

STEER=/usr/sbin/steer
SPEC=/etc/steer/spec.json
LISTS=/etc/steer/lists
MANIFEST=/etc/splify2/manifest.json
STAMP=/var/lib/splify2/last-update
LOCK=/var/lock/splify2-update.lock

log() { logger -t splify2-update "$*"; [ -t 1 ] && echo "$*"; }

[ -s "$SPEC" ] || { log "спеки нет — обновлять нечего"; exit 0; }

# Одновременно два прогона перезапишут друг другу файлы, и канал в этот момент увидит
# полупустой список. Блокировка каталогом: mkdir атомарен и работает без flock.
if ! mkdir "$LOCK" 2>/dev/null; then
    log "обновление уже идёт, выходим"
    exit 0
fi
trap 'rmdir "$LOCK" 2>/dev/null' EXIT INT TERM

manifest_url() {
    u="$(uci -q get splify2.main.manifest_url)"
    [ -n "$u" ] && printf '%s' "$u" ||
        printf '%s' "https://raw.githubusercontent.com/xyzmean/ru-bypass-ipsets/refs/heads/main/lists/categories.json"
}

download() {  # URL DEST
    tmp="$2.tmp"
    if command -v curl >/dev/null 2>&1; then
        curl -fsSL --max-time 120 -o "$tmp" "$1" || { rm -f "$tmp"; return 1; }
    else
        uclient-fetch -q -T 120 -O "$tmp" "$1" || { rm -f "$tmp"; return 1; }
    fi
    [ -s "$tmp" ] || { rm -f "$tmp"; return 1; }
    mv "$tmp" "$2"
}

# Сколько элементов набора эта коробка может держать. Измерено на 4C: загрузка стоит
# ~1,3 КБ памяти на префикс, и резерв нужен, иначе загрузка сама себя и уронит.
# Считается от СВОБОДНОЙ памяти, а не от общей: на роутере с поднятыми туннелями и
# dnsmasq свободного заметно меньше, чем всего.
budget() {
    avail_kb="$(awk '/^MemAvailable:/ { print $2; exit }' /proc/meminfo 2>/dev/null)"
    case "$avail_kb" in ''|*[!0-9]*) echo 0; return ;; esac
    reserve_kb=8192
    [ "$avail_kb" -le "$reserve_kb" ] && { echo 0; return; }
    echo $(( (avail_kb - reserve_kb) * 1024 / 1300 ))
}

# Файлы, на которые ссылаются каналы — по виду, потому что подгонять надо только
# адресные.
used_files() {  # ip|domains
    if [ "$1" = ip ]; then
        jsonfilter -i "$SPEC" -e '@.channels[*].match.prefixes_files[*]' 2>/dev/null
    else
        jsonfilter -i "$SPEC" -e '@.channels[*].match.domains_files[*]' 2>/dev/null
    fi
}

# id в манифесте по имени файла: url собирается из base_url и поля file, а не из id —
# доменные лежат в domains/<id>.lst, и угадывать путь нельзя.
url_for() {  # BASENAME -> URL или пусто
    base="$(jsonfilter -i "$MANIFEST" -e '@.base_url' 2>/dev/null)"
    [ -n "$base" ] || return 1
    for key in categories domain_lists; do
        f="$(jsonfilter -i "$MANIFEST" -e "@.$key[*].file" 2>/dev/null |
             while read -r p; do [ "$(basename "$p")" = "$1" ] && { echo "$p"; break; }; done)"
        [ -n "$f" ] && { printf '%s/%s' "$base" "$f"; return 0; }
    done
    return 1
}

mkdir -p "$LISTS" "$(dirname "$STAMP")" "$(dirname "$MANIFEST")"

# Манифест первым: без свежего манифеста новые списки не найти, а старые могут
# указывать на переехавшие файлы.
download "$(manifest_url)" "$MANIFEST" || log "манифест не обновился, работаем со старым"

BUDGET="$(budget)"
[ "$BUDGET" -gt 0 ] || log "мало свободной памяти — подгонка отключена, списки берём как есть"

changed=0
failed=0

for kind in ip domains; do
    used_files "$kind" | sort -u | while read -r path; do
        [ -n "$path" ] || continue
        name="$(basename "$path")"
        url="$(url_for "$name")" || { log "$name: нет в манифесте, пропущен"; continue; }

        new=/tmp/splify2-list.$$
        if ! download "$url" "$new"; then
            log "$name: не скачался, оставлен прежний"
            echo failed >> "$LOCK/flags"
            continue
        fi

        # Адресный список подгоняем под память. --truncate НЕ передаётся: обрезка
        # оставляет дыру выше одного адреса, которую человек увидит как «часть сайтов
        # работает, часть нет», и связать это с памятью невозможно. Лучше загрузить
        # как есть и сказать, что не влезло.
        if [ "$kind" = ip ] && [ "$BUDGET" -gt 0 ]; then
            fitted="$new.fit"
            repfile="$new.rep"
            # Отчёт в ОТДЕЛЬНЫЙ файл, а не в /dev/stdout: подогнанный список идёт
            # туда же, и JSON-отчёт оказывался внутри списка ("{"source":68.8.8.0/24"),
            # после чего nft отвергал весь набор правил — то есть обновление списков
            # снимало маршрутизацию целиком.
            "$STEER" fit --budget "$BUDGET" --report "$repfile" "$new" > "$fitted" 2>/dev/null
            rep="$(cat "$repfile" 2>/dev/null)"
            rm -f "$repfile"
            kept="$(echo "$rep" | sed -n 's/.*"kept":\([0-9]*\).*/\1/p')"
            fits="$(echo "$rep" | sed -n 's/.*"fits":\(true\|false\).*/\1/p')"
            if [ -s "$fitted" ]; then
                mv "$fitted" "$new"
                [ "$fits" = false ] &&
                    log "$name: не влезает в бюджет $BUDGET (получилось $kept) — загружаем как есть, следите за памятью"
            else
                rm -f "$fitted"
            fi
        fi

        # Проверка ПЕРЕД подменой. Испорченный файл уже один раз лёг на место
        # рабочего (в него попал JSON-отчёт фиттера), движок отверг весь набор правил,
        # и маршрутизация исчезла целиком. Скачанное — это чужой ввод, и подставлять
        # его под компилятор, не посмотрев, нельзя.
        #
        # Проверяется каждая строка, а не первая: мусор в середине файла ровно так же
        # валит nft, и «начало похоже на список» ничего не гарантирует.
        if [ "$kind" = ip ]; then
            bad="$(grep -vcE '^[[:space:]]*([0-9]{1,3}\.){3}[0-9]{1,3}(/[0-9]{1,2})?([[:space:]]*-[[:space:]]*([0-9]{1,3}\.){3}[0-9]{1,3})?[[:space:]]*$|^[[:space:]]*([#;].*)?$' "$new" 2>/dev/null)"
        else
            bad="$(grep -vcE '^[[:space:]]*[=*]?[A-Za-z0-9_.*-]+\.[A-Za-z]{2,}[[:space:]]*$|^[[:space:]]*(re:.*)?$|^[[:space:]]*([#;].*)?$' "$new" 2>/dev/null)"
        fi
        if [ "${bad:-0}" -gt 0 ]; then
            log "$name: в скачанном $bad строк не похожи на $kind-записи — оставлен прежний"
            rm -f "$new"
            echo failed >> "$LOCK/flags"
            continue
        fi

        # Сравнение с прежним: применять правила ради одинакового содержимого значит
        # моргать маршрутизацией без причины.
        if [ -f "$path" ] && cmp -s "$new" "$path"; then
            rm -f "$new"
            continue
        fi
        # Копия прежнего рядом: если движок всё же откажется, вернуть будет чем.
        [ -f "$path" ] && cp "$path" "$path.prev"
        mv "$new" "$path"
        log "$name: обновлён ($(grep -c . "$path") записей)"
        echo changed >> "$LOCK/flags"
    done
done

# Флаги пишутся в подпроцессах пайплайна, поэтому собираются из файла, а не из
# переменных: `while read` в пайплайне — отдельная оболочка, и её присваивания
# снаружи не видны.
[ -f "$LOCK/flags" ] && {
    grep -q changed "$LOCK/flags" && changed=1
    grep -q failed "$LOCK/flags" && failed=1
    rm -f "$LOCK/flags"
}

if [ "$changed" = 1 ]; then
    if "$STEER" apply --spec "$SPEC"; then
        /etc/init.d/steer reload_dnsd >/dev/null 2>&1
            rm -f "$LISTS"/*.prev
        log "правила применены"
    else
        # Дошли сюда — значит проверка выше что-то пропустила. Правила в этот момент
        # уже сняты неудачным apply, поэтому доводим до рабочего состояния тем, что
        # заведомо компилировалось: копиями, отложенными перед подменой.
        log "движок отверг обновлённые списки — откатываю"
        for b in "$LISTS"/*.prev; do
            [ -f "$b" ] || continue
            mv "$b" "${b%.prev}"
        done
        if "$STEER" apply --spec "$SPEC"; then
            log "откат удался, работают прежние списки"
        else
            log "ОТКАТ НЕ ПОМОГ — маршрутизации нет, нужна ручная проверка spec.json"
        fi
        exit 1
    fi
else
    log "изменений нет"
fi

date -u +%s > "$STAMP"
[ "$failed" = 1 ] && exit 1
exit 0
