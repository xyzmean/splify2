#!/bin/sh
# Счётчики отвалов интерфейсов: ev.iface_down и ev.wan_down в пакете телеметрии.
#
# ЗАЧЕМ. Сборщик (usr/lib/splify2/telemetry.sh, tm_event) уже читает эти два поля из файла
# /var/run/splify2-events строками `имя=число`, но писать их было некому — то есть панель
# получала честный ноль на роутере, где WAN отваливается по десять раз за вечер, и «у них всё
# в порядке» было неотличимо от «мы этого не измеряем».
#
# ПОЧЕМУ /var/run, А НЕ ФЛЕШ. Флапающий WAN даёт десятки срабатываний в минуту; запись такого
# в /etc или /overlay — это убийство флеш-памяти роутера ровно в том случае, который мы и
# хотим измерить. /var/run это tmpfs, и потеря счётчиков при перезагрузке не изъян, а часть
# договора: счётчики кумулятивные С ЗАГРУЗКИ, а `boot` и `uptime` в том же пакете объясняют
# приёмнику, откуда взялся сброс.
#
# ЦЕНА. Скрипт запускается на КАЖДОМ событии netifd, включая пачку ifup на загрузке, поэтому
# ниже нет ни одного вызова uci или ubus, а первой же строкой стоит выход по ACTION: на ifup
# всё выполнение — одно сравнение строк, без единого порождённого процесса.
[ "$ACTION" = ifdown ] || exit 0

# Швы: стенд tests/eventsmatch.sh подставляет свои пути и проверяет ПОЛУЧИВШИЙСЯ файл.
TM_EVENTS=${TM_EVENTS:-/var/run/splify2-events}
FW_CONF=${FW_CONF:-/etc/config/firewall}
# Сборка видимого файла счётчиков живёт в telemetry.sh, а не здесь, и подключается ПОСЛЕ
# выхода по ACTION: писателей у этого файла стало двое (отвалы считаем мы, падения — команда
# отправки), и вторая копия сборки означала бы, что каждый из них затирает счётчики другого.
# На ifup за это не платится ничего — до сюда выполнение не доходит.
#
# Файла может не быть: он приезжает тем же пакетом, что и этот обработчик, но человек мог
# снять пакет наполовину. Тогда события всё равно записываются — истина лежит в тальниках, —
# а видимый файл пересоберёт следующий, кто сможет. Читателя у него в этом случае всё равно
# нет: команда отправки уехала тем же пакетом.
TELEMETRY_SH=${TELEMETRY_SH:-/usr/lib/splify2/telemetry.sh}
# Команда отправки. Падение WAN — не «крашлог», но ровно тот случай, ради которого отправка
# стала внеплановой: у человека начало сыпаться прямо сейчас. Ограничитель потопа сидит в
# самой команде, поэтому флапающий WAN не превращается в десятки запросов наружу.
TELEMETRY_CMD=${TELEMETRY_CMD:-/usr/sbin/splify2-telemetry}

# АТОМАРНОСТЬ БЕЗ ЗАМКА. Обработчики hotplug запускаются параллельно, и два одновременных
# ifdown — это обычное дело (WAN отваливается вместе со своим wan6, `network restart` роняет
# всё разом). Наивное «прочитал число, прибавил, записал» теряет здесь события молча.
#
# flock не годится: в busybox его собирают не всегда, и проверить это на чужом роутере
# нечем — а обработчик, молча ставший пустышкой, ровно то, чего мы избегаем. Замок каталогом
# (mkdir, как в 95-steer соседнего пакета) годился бы, но у него своя цена: проигравший
# обязан ждать, ждать в busybox нечем дешевле форка `sleep`, а сдавшийся по таймауту теряет
# событие — то есть замок делает ровно ту ошибку, ради устранения которой заведён.
#
# Поэтому счётчик — не число в файле, а ДЛИНА файла-тальника: одно событие это один байт,
# дописанный в конец. Дозапись `>>` открывает файл с O_APPEND, а O_APPEND-запись в несколько
# байт ядро выполняет неделимо (смещение и запись под замком инода) — то есть двадцать
# параллельных обработчиков дают ровно двадцать байт без какой-либо договорённости между
# ними. Ни одно событие не теряется даже теоретически.
#
# Дозапись стоит ЗДЕСЬ, а не в подключаемой функции, и нарочно: она обязана случиться даже
# тогда, когда telemetry.sh почему-либо не подключился.
printf x >> "$TM_EVENTS.i" 2>/dev/null || exit 0

# ЧТО СЧИТАЕТСЯ WAN. Сначала имя: `wan`/`wan6`/`wan_4g`/`wwan` — то, как OpenWrt называет
# аплинк по умолчанию, и это сравнение строк без единого процесса.
#
# Если имя другое (человек переименовал интерфейс или у него pppoe-провайдер отдельным
# интерфейсом), спрашиваем ЕДИНСТВЕННЫЙ честный признак «это выход наружу», который есть в
# настройках: членство в зоне фаервола `wan`. Именно им OpenWrt отличает внешний интерфейс от
# внутреннего — по нему включается маскарад, — и именно его показывает красным LuCI. Читается
# файл настройки напрямую одним awk, без uci: uci на этом пути стоил бы разбора всей
# конфигурации ради одного ответа, и на ifup (которых на загрузке пачка) мы его не платим
# вовсе — сюда попадает только ifdown с непривычным именем.
is_wan=0
case "${INTERFACE:-}" in
    wan|wan6|wan_*|wwan|wwan*) is_wan=1 ;;
    ?*)
        if [ -f "$FW_CONF" ] && [ "$(awk -v ifn="$INTERFACE" '
                $1 == "config" { z = ($2 == "zone"); n = 0; m = 0; next }
                !z { next }
                { gsub(/["\047]/, ""); }
                $1 == "option" && $2 == "name" && $3 == "wan" { n = 1 }
                ($1 == "list" || $1 == "option") && $2 == "network" {
                    for (k = 3; k <= NF; k++) if ($k == ifn) m = 1
                }
                n && m { print 1; exit }
            ' "$FW_CONF" 2>/dev/null)" = 1 ]; then
            is_wan=1
        fi
        ;;
esac
[ "$is_wan" = 1 ] && printf x >> "$TM_EVENTS.w" 2>/dev/null

# ПЕРЕСБОРКА ВИДИМОГО ФАЙЛА и, если падение WAN, — внеплановая отправка.
#
# Отправка уходит ОТДЕЛЬНЫМ ПРОЦЕССОМ в фоне: запрос наружу висит до двадцати секунд, а
# netifd ждёт обработчик hotplug. Держать сеть роутера на время разговора с нашей панелью —
# это ровно та цена, которую человек нам не разрешал.
if [ -r "$TELEMETRY_SH" ]; then
    . "$TELEMETRY_SH"
    tm_event_rebuild
    [ "$is_wan" = 1 ] && [ -x "$TELEMETRY_CMD" ] &&
        ("$TELEMETRY_CMD" --now wan_flap --what wan >/dev/null 2>&1 &)
fi

exit 0
