#!/bin/sh
# Обновляет подписки, у которых задан свой интервал.
#
# ЗАЧЕМ ОТДЕЛЬНОЕ ЗАДАНИЕ, А НЕ ХВОСТ НОЧНОГО ОБНОВЛЕНИЯ СПИСКОВ. Списки обновляются раз в
# сутки, а подписка у разных панелей меняется по-разному: у одной узлы стоят неделями, у
# другой сервер переезжает за час. Поэтому интервал задаётся у КАЖДОЙ подписки свой, от
# получаса до трёх суток, а это задание лишь смотрит по часам, кому пора.
#
# ПОЧЕМУ ХОДИТ ЧЕРЕЗ ubus, А НЕ КАЧАЕТ САМО. Скачивание, разбор заголовков панели, выбор
# формата и учёт остатка живут в объекте rpcd (m-sub.sh). Вторая реализация того же здесь
# разошлась бы с первой на первом же изменении соглашения панелей — а разошлась бы молча:
# подписка «обновилась», узлы в ней не те.
#
# ТУННЕЛЬ ПЕРЕЧИТЫВАЕТСЯ ТОЛЬКО ПРИ ИЗМЕНИВШИХСЯ УЗЛАХ — это решает сам метод sub_refresh,
# сравнивая файл до и после. Иначе обновление по часам означало бы обрыв связи по часам.
set -u

UBUS=${UBUS:-ubus}
LOCK=${LOCK:-/var/lock/splify2-update-subs.lock}

log() {
    logger -t splify2-subs "$*"
    [ -t 1 ] && echo "$*"
    return 0
}

# Замок: задание стоит в расписании раз в десять минут, а скачивание с мёртвой панели
# занимает до двадцати секунд на подписку. Два прогона внахлёст ходили бы к панели вдвоём.
if command -v flock >/dev/null 2>&1; then
    exec 9>"$LOCK" 2>/dev/null || true
    flock -n 9 2>/dev/null || { log "прошлый прогон ещё идёт — пропускаю"; exit 0; }
fi

# Кто вообще заведён. Перечень берётся у того же объекта, который их и ведёт: свой обход uci
# здесь означал бы второе мнение о том, какие подписки есть.
list="$("$UBUS" call splify2 sub_list 2>/dev/null)" || {
    log "объект splify2 не отвечает — пропускаю прогон"
    exit 0
}

# Пора ли обновлять, решает сам объект — полем `due` в перечне. Здесь этого не считают
# НАРОЧНО: интервал, отметка о последней попытке и часы живут у него, и вторые такие же
# разошлись бы с первыми молча.
#
# Каждая подписка приезжает отдельной строкой JSON, а не тремя выровненными списками: у
# подписки, которую ещё ни разу не обновляли, поля `auto_at` нет вовсе, и списки разъехались
# бы на одну строку — интервал одной подписки применился бы к другой.
printf '%s' "$list" | jsonfilter -e '@.subs[*]' 2>/dev/null | while read -r row; do
    [ -n "$row" ] || continue
    due="$(jsonfilter -s "$row" -e '@.due' 2>/dev/null)"
    [ "$due" = true ] || [ "$due" = 1 ] || continue
    n="$(jsonfilter -s "$row" -e '@.name' 2>/dev/null)"
    [ -n "$n" ] || continue

    out="$("$UBUS" call splify2 sub_refresh "{\"name\":\"$n\"}" 2>&1)" || {
        log "подписка $n: не обновилась ($(printf '%s' "$out" | head -1))"
        continue
    }
    changed="$(printf '%s' "$out" | jsonfilter -e '@.changed' 2>/dev/null)"
    usable="$(printf '%s' "$out" | jsonfilter -e '@.usable' 2>/dev/null)"
    if [ "$changed" = "true" ] || [ "$changed" = "1" ]; then
        log "подписка $n обновлена: узлы изменились${usable:+, пригодных $usable} — туннель перечитает их при следующем применении"
    else
        log "подписка $n обновлена: узлы прежние${usable:+, пригодных $usable}"
    fi
done

exit 0
