#!/bin/sh
# Обновляет списки, на которые указывают каналы, и применяет результат.
#
# Обновляются ТОЛЬКО используемые списки. Скачивать всё, что есть в манифесте, значило
# бы тратить трафик и место на то, что никуда не подключено, а на коробке с 6 МБ
# overlay это заметно.
#
# Адресные списки проходят через `steer fit`: движок один знает, сколько элементов
# коробка может держать, и без подгонки первый же большой список (в блоклисте РФ их
# 28 тысяч префиксов) упирается в память на слабом роутере. Доменные не подгоняются —
# у них нет размера в элементах набора, набор заполняет резолвер по мере запросов.
set -u

# Пути переопределяемы окружением — иначе скрипт невозможно проверить, не трогая
# рабочую систему: всё, к чему он обращается, задано абсолютными путями. Значения по
# умолчанию прежние, на роутере ничего не меняется; переменные выставляет только
# tests/listsmatch.sh.
STEER=${STEER:-/usr/sbin/steer}
SPEC=${SPEC:-/etc/steer/spec.json}
LISTS=${LISTS:-/etc/steer/lists}
MANIFEST=${MANIFEST:-/etc/splify2/manifest.json}
STAMP=${STAMP:-/var/lib/splify2/last-update}
LOCK=${LOCK:-/var/lock/splify2-update.lock}

# Куда писать отчёт о прогоне, кроме syslog. Пусто — только syslog, как было.
# Заполняет его rpcd (кнопка «Обновить списки» в каталоге): вызов идёт не из терминала,
# поэтому echo молчит, а рассказывать человеку по журналу — значит просить его открыть
# журнал ради ответа на нажатие кнопки.
REPORT=${REPORT:-}

log() {
    logger -t splify2-update "$*"
    [ -n "$REPORT" ] && printf '%s\n' "$*" >> "$REPORT"
    [ -t 1 ] && echo "$*"
    return 0
}

[ -s "$SPEC" ] || { log "спеки нет — обновлять нечего"; exit 0; }

# Одновременно два прогона перезапишут друг другу файлы, и канал в этот момент увидит
# полупустой список. Блокировка каталогом: mkdir атомарен и работает без flock.
if ! mkdir "$LOCK" 2>/dev/null; then
    lock_pid=$(cat "$LOCK/pid" 2>/dev/null)
    if [ -n "$lock_pid" ] && kill -0 "$lock_pid" 2>/dev/null; then
        log "обновление уже идёт (PID $lock_pid), выходим"
        exit 0
    else
        log "Снимаем зависший lock от старого процесса"
        rm -rf "$LOCK"
        mkdir "$LOCK" || exit 1
    fi
fi
echo $$ > "$LOCK/pid"
trap 'rm -rf "$LOCK" 2>/dev/null' EXIT INT TERM

manifest_url() {
    u="$(uci -q get splify2.main.manifest_url)"
    [ -n "$u" ] && printf '%s' "$u" ||
        printf '%s' "https://raw.githubusercontent.com/xyzmean/ru-bypass-ipsets/refs/heads/main/lists/categories.json"
}

# Скачивание — общий файл с rpcd-объектом: обход закрытого издателя (splify2#15) обязан
# быть у обеих половин один. Своя копия здесь уже приводила к тому, что каталог в
# интерфейсе открывался, а ночное обновление тихо не приезжало.
FETCH_TIMEOUT=${FETCH_TIMEOUT:-120}
. "${FETCH_SH:-/usr/lib/splify2/fetch.sh}"

# Сколько элементов набора эта коробка может держать. Измерено на 4C: загрузка стоит
# ~1,3 КБ памяти на префикс, и резерв нужен, иначе загрузка сама себя и уронит.
# Считается от СВОБОДНОЙ памяти, а не от общей: на роутере с поднятыми туннелями и
# dnsmasq свободного заметно меньше, чем всего.
budget() {
    avail_kb="$(awk '/^MemAvailable:/ { print $2; exit }' /proc/meminfo 2>/dev/null)"
    case "$avail_kb" in ''|*[!0-9]*) echo 0; return ;; esac
    reserve_kb=8192
    [ "$avail_kb" -le "$reserve_kb" ] && { echo 0; return; }
    echo $(( (avail_kb - reserve_kb) * 1024 / 1300 ))
}

# Кратная просадка объёма: «записей стало кратно меньше», а не «меньше на N процентов».
# Проценты здесь врут в обе стороны. Состав категории у издателя законно меняется на
# десятки процентов (замер по двенадцати снапшотам: tiktok между двумя ЗДОРОВЫМИ
# сборками разошёлся на 42%), а беда, ради которой этот рубеж и нужен, выглядит иначе —
# пусто или впятеро меньше: на просевших сборках I-118 в geoblock.lst было 77 префиксов
# против 420. Мелкие списки исключены порогом: у списка из восьми префиксов кратное
# падение — обычная жизнь, а не авария.
#
# Роутеру неоткуда знать, было сокращение осознанным, поэтому порог грубый и его можно
# снять: `uci set splify2.main.list_shrink_factor=0`. Иначе законно схлопнутый издателем
# список остался бы лежать прежней копией, а сказать об этом роутер может только
# журналом. Ноль снимает КРАТНЫЙ порог; файл без записей не применяется и с ним.
SHRINK_FACTOR=${SHRINK_FACTOR:-$(uci -q get splify2.main.list_shrink_factor || echo 4)}
SHRINK_MIN=${SHRINK_MIN:-100}
# Из uci приходит что угодно, а нечисло в `$(( ))` — это ошибка оболочки на каждом
# списке, то есть проверка выключилась бы молча (так же, как это сделано в budget()).
case "$SHRINK_FACTOR" in ''|*[!0-9]*) SHRINK_FACTOR=4 ;; esac

records() {  # ФАЙЛ -> сколько в нём записей (пустые строки и комментарии не считаются)
    n="$(grep -cvE '^[[:space:]]*([#;].*)?$' "$1" 2>/dev/null)"
    echo "${n:-0}"
}

shrank() {  # НОВОЕ_ЧИСЛО ПРЕЖНЕЕ_ЧИСЛО
    [ "$2" -gt 0 ] || return 1              # прежнего файла нет — сравнивать не с чем
    # Пусто вместо записей — это не «список стал меньше», а «списка не стало»: канал
    # после такой подмены не совпадёт ни с чем. Порогом этот отказ не снимается.
    [ "$1" -eq 0 ] && return 0
    [ "$SHRINK_FACTOR" -gt 0 ] || return 1  # кратный порог снят через uci
    [ "$2" -ge "$SHRINK_MIN" ] || return 1  # мелкий список: кратность тут ничего не значит
    [ $(( $1 * SHRINK_FACTOR )) -lt "$2" ]
}

# Файлы, на которые ссылаются каналы — по виду, потому что подгонять надо только
# адресные.
used_files() {  # ip|domains
    if [ "$1" = ip ]; then
        jsonfilter -i "$SPEC" -e '@.channels[*].match.prefixes_files[*]' 2>/dev/null
    else
        jsonfilter -i "$SPEC" -e '@.channels[*].match.domains_files[*]' 2>/dev/null
    fi
}

# Ключ карты — путь У ИЗДАТЕЛЯ (`domains/news.lst`, `news.lst`), а не basename. По
# basename два разных списка сливаются в один ключ: в манифесте ru-bypass-ipsets
# `news.lst` и `hodca.lst` есть и среди адресных (`categories`), и среди доменных
# (`domain_lists/domains/news.lst`). `categories` перебирается первым, `url_for` берёт
# первое совпадение — и доменный список качался по адресу адресного. Дальше проверка
# содержимого видела CIDR там, где ждала домены, и оставляла прежний файл: доменные
# списки этих категорий не обновлялись вообще, а в журнале стояло «не похоже на
# domains-записи», то есть обвинение издателя вместо своей ошибки. То же ключевание по
# полному пути уже сделано в rpcd (`local_path`), здесь оно приводится в соответствие.
MANIFEST_MAP=/tmp/splify2-manifest.map
# Карта переименований издателя: СТАРОЕ_ИМЯ НОВОЕ_ИМЯ.
MANIFEST_ALIAS=/tmp/splify2-manifest.alias

parse_manifest() {
    base="$(jsonfilter -i "$MANIFEST" -e '@.base_url' 2>/dev/null)"
    [ -n "$base" ] || return 1
    rm -f "$MANIFEST_MAP" "$MANIFEST_ALIAS"
    for key in categories domain_lists; do
        jsonfilter -i "$MANIFEST" -e "@.$key[*].file" 2>/dev/null |
        while read -r p; do
            echo "$(echo "$p" | sed 's|^/*||') $base/$p" >> "$MANIFEST_MAP"
        done
    done
    # Переименования читаются двумя проходами и склеиваются построчно: jsonfilter отдаёт
    # по одному значению на строку и не умеет доставать пару полей одним выражением.
    jsonfilter -i "$MANIFEST" -e '@.aliases[*].from' 2>/dev/null > "$MANIFEST_ALIAS.from"
    jsonfilter -i "$MANIFEST" -e '@.aliases[*].to' 2>/dev/null > "$MANIFEST_ALIAS.to"
    if [ -s "$MANIFEST_ALIAS.from" ]; then
        # awk, а не paste: paste есть не в каждой сборке busybox, а awk есть везде —
        # на нём же построена вся остальная разборка карты.
        awk 'NR==FNR { a[FNR] = $0; next } { print a[FNR], $0 }' \
            "$MANIFEST_ALIAS.from" "$MANIFEST_ALIAS.to" > "$MANIFEST_ALIAS"
    fi
    rm -f "$MANIFEST_ALIAS.from" "$MANIFEST_ALIAS.to"
}

alias_for() {  # СТАРОЕ_ИМЯ -> НОВОЕ_ИМЯ или пусто
    [ -f "$MANIFEST_ALIAS" ] || return 1
    new="$(awk -v v="$1" '$1 == v { print $2; exit }' "$MANIFEST_ALIAS")"
    [ -n "$new" ] && { printf '%s' "$new"; return 0; }
    return 1
}

# ПУТЬ_У_ИЗДАТЕЛЯ -> URL или пусто.
#
# Если прямого совпадения нет, путь ищется среди переименованных. Это не удобство, а
# защита от тихого отказа: издатель схлопнул семнадцать списков в два, и без разрешения
# имён каждый уже настроенный канал получил бы «нет в манифесте, пропущен» — список
# остался бы лежать последней скачанной копией и перестал обновляться НАВСЕГДА, без
# признака ошибки. Человек видит рабочий канал со списком, которому полгода.
#
# Содержимое кладётся по СТАРОМУ пути (см. вызов): спека продолжает работать как есть,
# правки настроек от человека не требуется, а в журнале переименование названо вслух.
url_for() {
    [ -f "$MANIFEST_MAP" ] || return 1
    url="$(awk -v v="$1" '$1 == v { print $2; exit }' "$MANIFEST_MAP")"
    [ -n "$url" ] && { printf '%s' "$url"; return 0; }
    new="$(alias_for "$1")" || return 1
    url="$(awk -v v="$new" '$1 == v { print $2; exit }' "$MANIFEST_MAP")"
    [ -n "$url" ] && { printf '%s' "$url"; return 0; }
    return 1
}

mkdir -p "$LISTS" "$(dirname "$STAMP")" "$(dirname "$MANIFEST")"

# Манифест первым: без свежего манифеста новые списки не найти, а старые могут
# указывать на переехавшие файлы.
if download "$(manifest_url)" "$MANIFEST"; then
    # Обход называется вслух: иначе разница между «издатель доступен» и «издатель закрыт,
    # спаслись обходом» видна только по времени прогона, а знать её нужно — это она
    # объясняет, почему обновление вдруг стало занимать минуты.
    [ -n "$FETCH_NOTE" ] && log "манифест: $FETCH_NOTE"
else
    log "манифест не обновился, работаем со старым${FETCH_NOTE:+ ($FETCH_NOTE)}"
fi
parse_manifest

BUDGET="$(budget)"
[ "$BUDGET" -gt 0 ] || log "мало свободной памяти — подгонка отключена, списки берём как есть"

changed=0
failed=0

for kind in ip domains; do
    used_files "$kind" | sort -u | while read -r path; do
        [ -n "$path" ] || continue
        # Путь в спеке — это local_path из rpcd, то есть $LISTS плюс путь у издателя.
        # Снимаем префикс и получаем ровно тот ключ, которым карта и построена.
        rel="${path#$LISTS/}"
        name="$(basename "$path")"      # только для сообщений в журнале
        url="$(url_for "$rel")" || { log "$rel: нет в манифесте, пропущен"; continue; }
        # Переименование называется вслух: список продолжит обновляться по прежнему пути,
        # но человек должен знать, что у издателя он теперь называется иначе.
        renamed="$(alias_for "$rel")" && log "$rel: издатель переименовал в $renamed, обновляем по прежнему пути"

        new="$(mktemp /tmp/splify2-list.XXXXXX)"
        if ! download "$url" "$new"; then
            log "$name: не скачался, оставлен прежний${FETCH_NOTE:+ — $FETCH_NOTE}"
            echo failed >> "$LOCK/flags"
            continue
        fi
        [ -n "$FETCH_NOTE" ] && log "$name: $FETCH_NOTE"

        # Записи в скачанном считаются ЗДЕСЬ, до подгонки: подгонка под память сама
        # может кратно сократить список, и тогда проверка объёма ниже обвиняла бы
        # издателя в том, что сделал роутер.
        new_count="$(records "$new")"

        # Адресный список подгоняем под память. --truncate НЕ передаётся: обрезка
        # оставляет дыру выше одного адреса, которую человек увидит как «часть сайтов
        # работает, часть нет», и связать это с памятью невозможно. Лучше загрузить
        # как есть и сказать, что не влезло.
        if [ "$kind" = ip ] && [ "$BUDGET" -gt 0 ]; then
            fitted="$new.fit"
            repfile="$new.rep"
            # Отчёт в ОТДЕЛЬНЫЙ файл, а не в /dev/stdout: подогнанный список идёт
            # туда же, и JSON-отчёт оказывался внутри списка ("{"source":68.8.8.0/24"),
            # после чего nft отвергал весь набор правил — то есть обновление списков
            # снимало маршрутизацию целиком.
            "$STEER" fit --budget "$BUDGET" --report "$repfile" "$new" > "$fitted" 2>/dev/null
            rep="$(cat "$repfile" 2>/dev/null)"
            rm -f "$repfile"
            kept="$(echo "$rep" | sed -n 's/.*"kept":\([0-9]*\).*/\1/p')"
            fits="$(echo "$rep" | sed -n 's/.*"fits":\(true\|false\).*/\1/p')"
            if [ -s "$fitted" ]; then
                mv "$fitted" "$new"
                [ "$fits" = false ] &&
                    log "$name: не влезает в бюджет $BUDGET (получилось $kept) — загружаем как есть, следите за памятью"
            else
                rm -f "$fitted"
            fi
        fi

        # Проверка ПЕРЕД подменой. Испорченный файл уже один раз лёг на место
        # рабочего (в него попал JSON-отчёт фиттера), движок отверг весь набор правил,
        # и маршрутизация исчезла целиком. Скачанное — это чужой ввод, и подставлять
        # его под компилятор, не посмотрев, нельзя.
        #
        # Проверяется каждая строка, а не первая: мусор в середине файла ровно так же
        # валит nft, и «начало похоже на список» ничего не гарантирует.
        if [ "$kind" = ip ]; then
            bad="$(grep -vcE '^[[:space:]]*([0-9]{1,3}\.){3}[0-9]{1,3}(/[0-9]{1,2})?([[:space:]]*-[[:space:]]*([0-9]{1,3}\.){3}[0-9]{1,3})?[[:space:]]*$|^[[:space:]]*([#;].*)?$' "$new" 2>/dev/null)"
        else
            # Последняя метка НЕ обязана быть из одних букв.
            #
            # Прежнее выражение требовало `\.[A-Za-z]{2,}$` и потому объявляло мусором
            # punycode — `xn--80aswg.xn--p1ai`, то есть весь домен .рф, — а заодно шаблоны
            # с `?`. Движок ничего подобного не требует (см. dnsd.c: он принимает любое
            # имя, а также `=`, `re:` и шаблоны). Одной такой строки у издателя хватало,
            # чтобы ВЕСЬ файл был отброшен как непохожий на доменный список: список
            # замирал навсегда, а в журнал уходило обвинение издателя. Для проекта про
            # обход блокировок в РФ появление там .рф — вопрос времени, а не гипотеза.
            #
            # Проверяется то, что действительно важно: строка похожа на имя (есть точка,
            # нет пробелов внутри и запрещённых символов), а не то, из чего состоит
            # доменная зона. Сверено с sanitize_list в rpcd — там punycode принимается.
            bad="$(grep -vcE '^[[:space:]]*[=*]?[A-Za-z0-9_.*?-]+\.[A-Za-z0-9_*?-]{2,}[[:space:]]*$|^[[:space:]]*(re:.*)?$|^[[:space:]]*([#;].*)?$' "$new" 2>/dev/null)"
        fi
        if [ "${bad:-0}" -gt 0 ]; then
            log "$name: в скачанном $bad строк не похожи на $kind-записи — оставлен прежний"
            rm -f "$new"
            echo failed >> "$LOCK/flags"
            continue
        fi

        # Проверка ОБЪЁМА — рядом с проверкой формы и по той же логике: файл, в котором
        # записи выглядят правильно, но их кратно меньше прежних, это просадка на
        # стороне издателя (I-105, I-118 — одиннадцать снапшотов из четырнадцати вышли с
        # четвертью потерянного покрытия). По самим файлам такое не видно: они
        # правильные, просто короткие. Собственного рубежа у роутера до этого не было —
        # всё держалось на том, что гейты генератора беду не пропустят.
        prev_count="$(records "$path")"   # прежнего файла нет — records вернёт 0
        if shrank "$new_count" "$prev_count"; then
            log "$name: записей в скачанном $new_count против $prev_count прежних — оставлен прежний"
            rm -f "$new"
            echo failed >> "$LOCK/flags"
            continue
        fi

        # Сравнение с прежним: применять правила ради одинакового содержимого значит
        # моргать маршрутизацией без причины.
        if [ -f "$path" ] && cmp -s "$new" "$path"; then
            rm -f "$new"
            continue
        fi
        # Копия прежнего рядом: если движок всё же откажется, вернуть будет чем.
        [ -f "$path" ] && cp "$path" "$path.prev"
        mv "$new" "$path"
        log "$name: обновлён ($(grep -c . "$path") записей)"
        echo changed >> "$LOCK/flags"
    done
done

# Флаги пишутся в подпроцессах пайплайна, поэтому собираются из файла, а не из
# переменных: `while read` в пайплайне — отдельная оболочка, и её присваивания
# снаружи не видны.
[ -f "$LOCK/flags" ] && {
    grep -q changed "$LOCK/flags" && changed=1
    grep -q failed "$LOCK/flags" && failed=1
    rm -f "$LOCK/flags"
}

if [ "$changed" = 1 ]; then
    if "$STEER" apply --spec "$SPEC"; then
        /etc/init.d/steer reload_dnsd >/dev/null 2>&1
        # find, а не глоб: доменные списки лежат в подкаталоге domains/, и `"$LISTS"/*.prev`
        # их не видит. Копии там оставались навсегда, то есть каждый доменный список
        # занимал на флеше двойной объём — на overlay в 6,9 МБ это заметно.
        find "$LISTS" -name '*.prev' -type f -delete 2>/dev/null
        log "правила применены"
    else
        # Дошли сюда — значит проверка выше что-то пропустила. Правила в этот момент
        # уже сняты неудачным apply, поэтому доводим до рабочего состояния тем, что
        # заведомо компилировалось: копиями, отложенными перед подменой.
        log "движок отверг обновлённые списки — откатываю"
        # Тоже find: глоб `"$LISTS"/*.prev` не заходит в подкаталоги, а доменные списки
        # лежат именно там (domains/news.lst). Откат поэтому возвращал ТОЛЬКО адресные,
        # повторный apply падал на том же доменном файле, и в журнал уходило «ОТКАТ НЕ
        # ПОМОГ» — при полностью исправном механизме отката.
        find "$LISTS" -name '*.prev' -type f 2>/dev/null | while read -r b; do
            [ -f "$b" ] || continue
            mv "$b" "${b%.prev}"
        done
        if "$STEER" apply --spec "$SPEC"; then
            log "откат удался, работают прежние списки"
        else
            log "ОТКАТ НЕ ПОМОГ — маршрутизации нет, нужна ручная проверка spec.json"
        fi
        exit 1
    fi
else
    log "изменений нет"
fi

date -u +%s > "$STAMP"

# Заодно спрашиваем панель подписки про остаток трафика.
#
# Зачем здесь. Средний расход в сутки на обзоре МЕРЯЕТСЯ по двум обращениям к панели — начала
# периода она не сообщает, а угадывать длину периода нельзя. Пока обращения делал только
# браузер, у человека, заходящего на страницу раз в неделю, темпа не было вовсе. Суточный
# прогон даёт наблюдение в сутки, и темп появляется сам, без открытой страницы.
#
# Через ubus, а не своим разбором заголовка: разбор живёт в объекте rpcd, и вторая его
# реализация здесь разошлась бы с первой на первом же изменении соглашения панелей. Метод
# подписку не подменяет — ни файл узлов, ни выбранный узел, — поэтому его безопасно звать из
# расписания.
#
# Молча и без влияния на код возврата: остаток — не часть обновления списков, и его неудача не
# повод объявлять неудачным весь прогон.
if [ "$(uci -q get splify2.main.sub_kind)" = url ]; then
    if ubus call splify2 sub_quota >/dev/null 2>&1; then
        log "остаток трафика подписки обновлён"
    else
        log "остаток трафика подписки спросить не удалось"
    fi
fi

[ "$failed" = 1 ] && exit 1
exit 0
