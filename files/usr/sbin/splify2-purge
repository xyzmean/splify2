#!/bin/sh
# Полное удаление следов splify2 с роутера — ОТДЕЛЬНОЙ КОМАНДОЙ, а не чисткой в postrm.
#
# ПОЧЕМУ НЕ В POSTRM ПАКЕТА, и это главное, что здесь надо знать. У opkg обновление пакета —
# это удаление старой версии ПЛЮС установка новой, то есть postrm запускается при КАЖДОМ
# обновлении (у apk то же самое, когда пакет заменяется другой версией). Чистка, стоящая
# там, сносила бы человеку спеку, подписку, зону фаервола и расписку каждый раз, когда он
# нажимает «обновить», — и выглядело бы это как «после обновления всё пропало», причём без
# единой строчки о причине. Поэтому следы убирает команда, которую человек зовёт сам и
# осознанно, когда пакеты ему больше не нужны:
#
#     splify2-purge                       показать, что будет удалено, и НЕ делать ничего
#     splify2-purge --yes                 сделать
#     splify2-purge --yes --keep-config   снять правила и зоны, настройки оставить
#
# ПОЧЕМУ ПО УМОЛЧАНИЮ ТОЛЬКО ПОКАЗ, а не вопрос «вы уверены?». Скрипт зовут не только из
# терминала: из ubus (кнопкой на странице) и из ssh-команды терминала нет вовсе, и `read`
# в таком запуске либо мгновенно получает конец файла — то есть читается как «да» на
# необратимое удаление, — либо вешает вызов до срока rpcd. Показ без действия однозначен в
# обоих случаях, и согласие выражается ключом, а не молчанием.
#
# ЧЕГО ЭТОТ СКРИПТ НЕ ДЕЛАЕТ. Он не снимает сами пакеты — это дело apk/opkg, и человек мог
# позвать чистку до снятия, чтобы посмотреть. И он не трогает ничего, чего мы не заводили:
# чужая зона фаервола, чужой конфиг https-dns-proxy, устройство, положенное в нашу зону
# руками, интерфейс с протоколом xsteer — всё это остаётся на месте, и о каждом таком случае
# печатается строка. Молчаливо оставленный мусор ничем не лучше молчаливо удалённой настройки:
# человек должен уйти отсюда, зная, что осталось и почему.
set -u

# ---- пути и швы --------------------------------------------------------------------
# Пути — переменные с прежними значениями по умолчанию, как в /usr/libexec/rpcd/splify2 и
# splify2-update-lists. Причина та же и здесь она весомее всего: скрипт УДАЛЯЕТ, и проверить
# его, не имея возможности увести все пути в песочницу, нельзя вообще никак. На роутере
# окружение чистое, то есть выбирается всегда ветка `:-`.
SPLIFY2_DIR=${SPLIFY2_DIR:-/etc/splify2}
# Расписка фаервола: что в нём сделали МЫ. Разбирается ниже так же, как в m-spec.sh.
FW_OWNED=${FW_OWNED:-$SPLIFY2_DIR/fw-owned}
STEER_DIR=${STEER_DIR:-/etc/steer}
UCI_SPLIFY2=${UCI_SPLIFY2:-/etc/config/splify2}
DOH_CONF=${DOH_CONF:-/etc/config/https-dns-proxy}
# Библиотека DoH нужна ради doh_restore: копия чужой настройки лежит в самом её файле, и
# разбирать её здесь вторым разборщиком значило бы завести второе место, где решается, что
# в этом файле наше. Швом, потому что команду зовут и стендом, и после снятия пакетов —
# тогда файла может не быть вовсе, и это состояние обработано отдельно.
DOH_LIB=${DOH_LIB:-/usr/lib/splify2/doh.sh}
CRONTAB=${CRONTAB:-/etc/crontabs/root}
# По этой строке узнаётся НАША запись в crontab. Ею же её ставит скрипт установки пакета.
CRON_MARK=${CRON_MARK:-splify2-update-lists}
CRON_INITD=${CRON_INITD:-/etc/init.d/cron}
INITD=${INITD:-/etc/init.d/steer}
FW_INITD=${FW_INITD:-/etc/init.d/firewall}
# Зоны — ТОЙ ЖЕ строкой, что у объекта rpcd (FW_ZONES в /usr/libexec/rpcd/splify2), формат
# «имя:виды:masq». Виды и masq здесь не нужны — удалять зону можно, не зная, чем её наполняли,
# — но формат оставлен общим нарочно: строку правят в одном месте и переносят сюда как есть,
# без перевода, на котором и теряются такие правки.
FW_ZONES=${FW_ZONES:-"steer_vless:vless,xsteer:0 steer_iface:interface:1"}
# Таблицы nftables, которые ставим МЫ: правило «DoH через туннель», фикс Zapret Manager и
# изоляция проверки стратегий. Четвёртая, `inet steer`, принадлежит движку и в обычном порядке
# уходит сама: её сносит остановка службы, которая идёт первым делом. Она перечислена здесь
# ЗАТЕМ, что чистку зовут и на роутере, с которого пакеты уже сняты, — а вместе с пакетом ушёл
# и init-скрипт, то есть снять таблицу больше нечем, и она осталась бы метить трафик в никуда
# до перезагрузки. Существование каждой таблицы проверяется перед удалением, так что лишнего
# здесь не происходит.
NFT_TABLES=${NFT_TABLES:-"splify2_doh splify2_zm splify2_ztest steer"}
# Таблица маршрутов и приоритет правила для «DoH через туннель» — те же числа, что в
# common.sh (doh_rules_sync), иначе снималось бы не то, что ставилось.
DOH_RT=${DOH_RT:-290}
DOH_RULE_PREF=${DOH_RULE_PREF:-29000}
# Срок вызова rpcd, который ставит /etc/uci-defaults/99-splify2. Снимается ТОЛЬКО это
# значение: другое поставил администратор, и оно не наше.
RPCD_TIMEOUT=${RPCD_TIMEOUT:-120}
# Состояние и признаки в /var: чьей-либо настройкой они не являются и переживать чистку им
# незачем. Каталог движка (/var/lib/steer) и готовые конфигурации туннелей (/var/run/xsteer)
# тоже здесь: пакеты снимают вместе, и половина следов — это не «убрано».
STATE_PATHS=${STATE_PATHS:-"/var/lib/splify2 /var/lib/steer /var/run/xsteer \
/var/run/splify2-vless-dirty /var/run/splify2-obfs-dirty /var/run/splify2-zapret-dirty \
/var/run/splify2-zapret-autoselect.progress /var/run/splify2-zapret-autoselect.pid \
/var/lock/splify2-update.lock /var/lock/splify2-zapret-autoselect.lock"}

DO=0     # 0 — только показать; 1 — делать
KEEP=0   # 1 — настройки человека оставить
FOUND=0  # нашлось ли вообще хоть что-нибудь

usage() {
    cat <<'USAGE'
splify2-purge — убрать с роутера следы splify2 после снятия пакетов.

    splify2-purge                       показать, что будет удалено (ничего не делает)
    splify2-purge --yes                 удалить
    splify2-purge --yes --keep-config   удалить правила, зоны и расписание,
                                        но оставить /etc/steer и /etc/config/splify2

Убирается только то, что заводили мы: чужая зона фаервола, чужой конфиг https-dns-proxy и
устройство, положенное в нашу зону руками, остаются на месте.
USAGE
}

while [ $# -gt 0 ]; do
    case "$1" in
        -y|--yes)      DO=1 ;;
        --keep-config) KEEP=1 ;;
        -h|--help)     usage; exit 0 ;;
        # Опечатка в ключе не должна читаться как согласие: `--yes-please` — это не «да».
        *) printf 'splify2-purge: неизвестный ключ: %s\n\n' "$1" >&2; usage >&2; exit 2 ;;
    esac
    shift
done

say() { printf 'splify2-purge: %s\n' "$*"; }

# Одна и та же строка в двух наклонениях: показ и работа не могут разойтись описанием, потому
# что описание у них общее. Расхождение здесь читалось бы как «показал одно, сделал другое», а
# это худшее, что может сделать команда удаления.
plan() {  # ОПИСАНИЕ
    FOUND=1
    if [ "$DO" = 1 ]; then say "$1"; else say "будет сделано: $1"; fi
}

# ---- движок ------------------------------------------------------------------------
purge_engine() {
    [ -x "$INITD" ] || return 0
    plan "служба движка останавливается и снимается с автозапуска ($INITD)"
    [ "$DO" = 1 ] || return 0
    # ПЕРВЫМ ДЕЛОМ и до удаления спеки: останавливаясь, движок сам сносит свою таблицу
    # nftables и вычищает свои ip rule, а читает он это из спеки. Убрав спеку раньше, мы
    # оставили бы его таблицу метить трафик в никуда — и снять её было бы уже нечем.
    "$INITD" stop >/dev/null 2>&1
    "$INITD" disable >/dev/null 2>&1
    return 0
}

# ---- фаервол -----------------------------------------------------------------------
# Разбор расписки и зоны — те же выражения, что в m-spec.sh: два разных разбора одного
# формата однажды разошлись бы, и разошлись бы молча, а цена — удалённая чужая зона.
fw_noted() { grep -qxF "$1" "$FW_OWNED" 2>/dev/null; }
zone_index() {  # ИМЯ_ЗОНЫ
    uci show firewall 2>/dev/null | sed -n "s/^firewall\.@zone\[\([0-9]*\)\]\.name='$1'$/\1/p" | head -1
}
zone_devices() {  # ИНДЕКС
    uci -q get "firewall.@zone[$1].device" 2>/dev/null | tr ' ' '\n' | grep . | sort -u
}
zone_forwardings() {  # ИМЯ_ЗОНЫ
    uci show firewall 2>/dev/null |
        sed -n "s/^firewall\.\(@forwarding\[[0-9]*\]\)\.dest='$1'$/\1/p"
}

purge_zone() {  # ИМЯ_ЗОНЫ
    _z="$1"
    _idx="$(zone_index "$_z")"
    [ -n "$_idx" ] || return 0

    # Хоть одно устройство, которого мы не заводили, — и зона не наша. Это ровно то условие,
    # по которому fw_adopt_if_ours (m-spec.sh) отказывается принять зону за свою: имя ещё
    # ничего не доказывает, зону с таким именем мог сделать руками и человек. Своё из чужой
    # зоны всё равно выносим — «убрать только своё» и есть весь ответ, — но ни саму зону, ни
    # проброс в неё не трогаем.
    _alien=""
    for _d in $(zone_devices "$_idx"); do
        fw_noted "dev $_z $_d" || _alien="$_alien $_d"
    done
    if [ -n "$_alien" ]; then
        say "зону $_z заводили не мы — в ней есть устройства$_alien; сама зона и проброс в неё остаются"
        for _d in $(zone_devices "$_idx"); do
            fw_noted "dev $_z $_d" || continue
            plan "устройство $_d выносится из зоны $_z"
            [ "$DO" = 1 ] || continue
            uci -q del_list "firewall.@zone[$_idx].device"="$_d" && FW_CHANGED=1
        done
        [ "$DO" = 1 ] && [ "$FW_CHANGED" = 1 ] && uci -q commit firewall
        return 0
    fi

    for _f in $(zone_forwardings "$_z"); do
        plan "правило проброса $_f (lan -> $_z) удаляется"
    done
    plan "зона фаервола $_z удаляется"
    [ "$DO" = 1 ] || return 0

    # СНАЧАЛА ПРАВИЛА ПРОБРОСА, ПОТОМ САМА ЗОНА, и порядок здесь не вкусовой: forwarding,
    # ссылающийся на несуществующую зону, fw4 при перезагрузке отвергает — то есть роутер
    # остаётся без фаервола целиком. Тот же порядок и по той же причине стоит в fw_zone_sync.
    #
    # Правила ищутся заново на каждом витке: uci перенумеровывает безымянные секции после
    # удаления, и список индексов, добытый один раз, со второго удаления указывал бы не туда.
    while :; do
        _f="$(zone_forwardings "$_z" | head -1)"
        [ -n "$_f" ] || break
        uci -q delete "firewall.$_f" || break
        FW_CHANGED=1
    done
    # По той же причине заново берётся и индекс зоны.
    _idx="$(zone_index "$_z")"
    [ -n "$_idx" ] || return 0
    uci -q delete "firewall.@zone[$_idx]" && FW_CHANGED=1
    [ "$FW_CHANGED" = 1 ] && uci -q commit firewall
    # Расписку здесь не правим: она уходит вместе с $SPLIFY2_DIR ниже, целиком. Вычёркивать
    # строки из файла, который через секунду будет удалён, значило бы завести второе место,
    # где чистка может остановиться на середине.
    return 0
}

purge_firewall() {
    FW_CHANGED=0
    for _z in $FW_ZONES; do
        purge_zone "${_z%%:*}"
    done
    [ "$FW_CHANGED" = 1 ] || return 0
    # Перезагрузка ОДНА на все зоны: fw4 перестраивает набор целиком, и звать её на каждую
    # зону значило бы дважды уронить транзит (тот же довод, что у fw_sync).
    say "правила фаервола перезагружаются"
    fw4 reload >/dev/null 2>&1 || "$FW_INITD" reload >/dev/null 2>&1
    return 0
}

# ---- таблицы nftables и маршрутизация DoH ------------------------------------------
purge_nft() {
    for _t in $NFT_TABLES; do
        # Существование проверяется ДО показа: обещать удалить таблицу, которой нет, значит
        # заставить человека искать её потом руками, чтобы понять, удалилась ли она.
        nft list table inet "$_t" >/dev/null 2>&1 || continue
        plan "таблица nftables inet $_t удаляется"
        [ "$DO" = 1 ] || continue
        nft delete table inet "$_t" 2>/dev/null
    done
    return 0
}

purge_doh_rules() {
    if ip rule show 2>/dev/null | grep -q "^$DOH_RULE_PREF:"; then
        plan "правило маршрутизации pref $DOH_RULE_PREF (DoH через туннель) снимается"
        if [ "$DO" = 1 ]; then
            # Копий может накопиться несколько: `ip rule add` дубликаты не проверяет. Предел
            # витков — оттуда же, откуда и правило (doh_rules_down в common.sh).
            _n=0
            while [ "$_n" -lt 32 ] && ip rule del pref "$DOH_RULE_PREF" 2>/dev/null; do
                _n=$((_n + 1))
            done
        fi
    fi
    if [ -n "$(ip route show table "$DOH_RT" 2>/dev/null)" ]; then
        plan "таблица маршрутов $DOH_RT очищается"
        [ "$DO" = 1 ] && ip route flush table "$DOH_RT" 2>/dev/null
    fi
    return 0
}

# ---- расписание --------------------------------------------------------------------
purge_cron() {
    [ -f "$CRONTAB" ] || return 0
    grep -q "$CRON_MARK" "$CRONTAB" 2>/dev/null || return 0
    plan "запись обновления списков убирается из $CRONTAB"
    [ "$DO" = 1 ] || return 0
    # Код возврата grep здесь не проверяется НАРОЧНО: пустой результат законен — это случай,
    # когда наша строка в crontab единственная, и тогда файл должен остаться пустым, а не
    # прежним. Строки соседей переносятся как есть.
    grep -v "$CRON_MARK" "$CRONTAB" > "$CRONTAB.purge" 2>/dev/null
    if [ -f "$CRONTAB.purge" ]; then
        mv "$CRONTAB.purge" "$CRONTAB" || rm -f "$CRONTAB.purge"
    fi
    [ -x "$CRON_INITD" ] && "$CRON_INITD" restart >/dev/null 2>&1
    return 0
}

# ---- ключи в чужих конфигурациях ---------------------------------------------------
purge_rpcd_timeout() {
    _t="$(uci -q get rpcd.@rpcd[0].timeout 2>/dev/null || true)"
    [ "${_t:-}" = "$RPCD_TIMEOUT" ] || return 0
    plan "срок вызова rpcd ($RPCD_TIMEOUT с) снимается — вернётся штатный"
    [ "$DO" = 1 ] || return 0
    uci -q delete rpcd.@rpcd[0].timeout
    uci -q commit rpcd
    # RPCD ОТСЮДА НЕ ПЕРЕЗАПУСКАЕТСЯ, и это не забывчивость: скрипт могли позвать через ubus,
    # то есть из процесса, которого rpcd и запустил, — перезапуск убил бы чистку на середине.
    # Значение он читает при старте, поэтому просто говорим, когда оно подействует.
    say "новый срок начнёт действовать после перезапуска rpcd или перезагрузки"
    return 0
}

purge_zapret() {
    _v="$(uci -q get zapret.config.run_on_boot 2>/dev/null || true)"
    [ "${_v:-}" = 0 ] || return 0
    plan "zapret.config.run_on_boot возвращается в 1 — ноль там ставили мы"
    [ "$DO" = 1 ] || return 0
    # Ключ принадлежит ЧУЖОМУ пакету, поэтому он не удаляется, а возвращается к значению, с
    # которым zapret приезжает. Ноль в нём — это наше «обход выключен» с нашей вкладки
    # (zp_zapret_off в zapret.sh); уйти, оставив его, значило бы забрать у человека автозапуск
    # обхода — обёртка remittor при run_on_boot = 0 отвечает «service blocked».
    uci -q set zapret.config.run_on_boot=1
    uci -q commit zapret
    return 0
}

purge_doh_conf() {
    [ -s "$DOH_CONF" ] || return 0
    # ПРИЗНАК «ФАЙЛ ПИСАЛИ МЫ» — МЕТКА КОПИИ, а не значение force_dns.
    #
    # Прежний признак (`option force_dns '0'`) казался надёжным: у пакета умолчание 1, и
    # Zapret Manager пишет 1, ноль — наше решение. Но он ломается ровно там, где менеджер
    # стоит рядом: тот правит ключ в 1 в любой момент, и после его правки purge сказал бы
    # «писали не мы» и оставил НАШУ настройку на роутере навсегда. Метка копии
    # (`option splify2_state` в секции splify2_backup) — единственный след, который ставим
    # только мы, и его никто снаружи не трогает.
    if ! grep -q "option splify2_state" "$DOH_CONF"; then
        say "$DOH_CONF писали не мы — оставлен как есть"
        return 0
    fi
    if [ "$KEEP" = 1 ]; then
        say "$DOH_CONF оставлен вместе с копией — просили сохранить настройки"
        return 0
    fi
    # УДАЛЕНИЕ ЗАМЕНЕНО ВОССТАНОВЛЕНИЕМ. `doh_write` переписывает этот файл целиком, и до
    # запуска 65 чужая настройка при этом терялась безвозвратно; теперь она лежит копией в
    # том же файле, и уйти, не вернув её, значило бы наследить ровно тем, чего эта команда
    # и призвана не делать. При состоянии `none` (файла до нас не было) восстановление
    # означает удаление нашего — то есть прежнее поведение сохраняется ровно для того
    # случая, для которого оно и было верным.
    if [ ! -r "$DOH_LIB" ]; then
        # Пакеты могли снять раньше, чем позвали эту команду. Молча снести чужой резолвер
        # здесь хуже, чем оставить наш: удаление необратимо, а оставленный файл человек
        # увидит и уберёт сам.
        say "$DOH_CONF: копия чужой настройки есть, а восстановить нечем — нет $DOH_LIB; файл оставлен"
        return 0
    fi
    # shellcheck disable=SC1090
    . "$DOH_LIB"
    _pd_state="$(doh_backup_state 2>/dev/null)"
    case "$_pd_state" in
        none) plan "$DOH_CONF удаляется — до нас этого файла не было" ;;
        *)    plan "$DOH_CONF: чужая редакция возвращается из копии" ;;
    esac
    [ "$DO" = 1 ] || return 0
    if doh_restore; then
        case "$_pd_state" in
            none) say "https-dns-proxy остался без настройки: он приезжал нашей зависимостью — если он больше не нужен, снимите и сам пакет" ;;
            *)    say "$DOH_CONF возвращён в том виде, в каком был до нас" ;;
        esac
    else
        say "$DOH_CONF восстановить не удалось — файл оставлен как есть"
    fi
    return 0
}

# ---- каталоги и файлы --------------------------------------------------------------
purge_paths() {
    for _p in $STATE_PATHS; do
        [ -e "$_p" ] || continue
        plan "$_p удаляется"
        [ "$DO" = 1 ] && rm -rf "$_p"
    done
    # Каталог с распиской фаервола, манифестом и отметкой набора опций протокола. Настройкой
    # человека здесь не является ничто: манифест скачивается заново, расписка без своей зоны
    # бессмысленна, — поэтому он уходит и при --keep-config.
    if [ -e "$SPLIFY2_DIR" ]; then
        plan "$SPLIFY2_DIR удаляется"
        [ "$DO" = 1 ] && rm -rf "$SPLIFY2_DIR"
    fi
    if [ "$KEEP" = 1 ]; then
        say "$STEER_DIR и $UCI_SPLIFY2 оставлены — просили сохранить настройки"
        return 0
    fi
    # А это уже настройка человека: спека, снимок применённого, подписки, списки и uci. Ради
    # неё и существует --keep-config.
    if [ -e "$STEER_DIR" ]; then
        # Содержимое перечисляется по именам, а не одним каталогом: «/etc/steer удаляется»
        # человек читает как «какие-то служебные файлы», а «spec.json» — как свою работу за
        # полгода. По показу решают, звать ли команду с --yes, и решают по этой строке.
        plan "$STEER_DIR удаляется — вместе со спекой spec.json, подписками и списками"
        [ "$DO" = 1 ] && rm -rf "$STEER_DIR"
    fi
    if [ -e "$UCI_SPLIFY2" ]; then
        plan "$UCI_SPLIFY2 удаляется — настройка пакета (ссылка подписки и прочее)"
        [ "$DO" = 1 ] && rm -rf "$UCI_SPLIFY2"
    fi
    return 0
}

# ---- то, что остаётся человеку -----------------------------------------------------
# Интерфейсы с протоколом xsteer заводил он сам, поэтому они не наши и мы их не трогаем. Но
# молчать о них нельзя: без обработчика протокола netifd их не поднимет и скажет «не
# поддерживаемый тип протокола» — а выглядит это как поломка сети из-за чистки.
warn_xsteer() {
    _ifs="$(uci show network 2>/dev/null |
        sed -n "s/^network\.\([^.]*\)\.proto='xsteer'$/\1/p" | tr '\n' ' ')"
    [ -n "$_ifs" ] || return 0
    say "интерфейсы с протоколом xsteer остаются в настройке сети: $_ifs"
    say "их заводили не мы, поэтому не трогаем — но без обработчика протокола они не поднимутся"
    return 0
}

purge_engine
purge_firewall
purge_nft
purge_doh_rules
purge_cron
purge_rpcd_timeout
purge_zapret
purge_doh_conf
purge_paths
warn_xsteer

if [ "$FOUND" = 0 ]; then
    say "следов не найдено — убирать нечего"
    exit 0
fi
if [ "$DO" = 1 ]; then
    say "готово"
else
    say "ничего не удалено. Чтобы удалить: splify2-purge --yes"
    say "чтобы удалить, но оставить настройки: splify2-purge --yes --keep-config"
fi
exit 0
