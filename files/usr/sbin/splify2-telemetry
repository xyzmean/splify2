#!/bin/sh
# Отправка пакета телеметрии. Контракт — docs/TELEMETRY.md.
#
# ПО УМОЛЧАНИЮ НИЧЕГО НЕ ОТПРАВЛЯЕТ. Без `--send` команда печатает пакет и уходит: то же
# правило, что у splify2-purge и у автоподбора — действие, уводящее данные с роутера, надо
# назвать вслух. Расписание зовёт с `--send` само, и только если человек согласился.
#
# ЗАПУСКАЕТСЯ ИЗ НОЧНОГО ОБНОВЛЕНИЯ СПИСКОВ, а не своим заданием крона: задание там одно, со
# случайной минутой, и второе означало бы второй всплеск обращений и вторую строку, которую
# обязана убирать команда полного удаления.
#
# НЕ КОПИТ ПРИ НЕДОСТУПНОЙ ПАНЕЛИ. Очередь не нужна по построению: счётчики событий
# кумулятивные с загрузки, поэтому пропущенная отправка не теряет ни одного события —
# следующая покажет число побольше, а `boot` и `uptime` объяснят перезагрузку. Очередь на
# диске вдобавок означала бы запись во флеш ради того, что и так восстановится.
set -u

TELEMETRY_SH=${TELEMETRY_SH:-/usr/lib/splify2/telemetry.sh}
[ -r "$TELEMETRY_SH" ] || { echo "нет $TELEMETRY_SH" >&2; exit 2; }
. "$TELEMETRY_SH"

TM_TIMEOUT=${TM_TIMEOUT:-20}
TM_CURL=${TM_CURL:-curl}
# Адрес панели по умолчанию. Зашит в КОМАНДУ, а не только в uci-defaults: ключ настройки
# человек может стереть, а `uci-defaults` отрабатывает один раз при установке и на роутере,
# где настройку правили руками или восстанавливали из архива, его может не быть вовсе. Ключ
# `splify2.main.telemetry_url` при этом остаётся: он ПЕРЕОПРЕДЕЛЯЕТ умолчание, и своя панель
# поднимается одной строкой без правки пакета.
# Подстановка через `-`, а не `:-`, и разница здесь смысловая: ПУСТОЕ значение должно
# оставаться пустым. `:-` подставляет умолчание и на пустое тоже, то есть сборка, нарочно
# собранная без панели или без ключа, молча получала бы наши.
TM_URL_DEF=${TM_URL_DEF-https://splify2-telemetry-panel.vercel.app/api/ingest}
# Общий ключ записи, поставляемый с пакетом. ПУБЛИЧЕН ПО ПОСТРОЕНИЮ и ничего не обещает,
# кроме отсечения случайного мусора: он лежит на роутере, а роутер принадлежит не нам. Тот же
# довод записан в контракте, раздел «Чем панель отличает наш роутер от чужого запроса».
#
# ЗНАЧЕНИЕ ОБЯЗАНО СОВПАДАТЬ с переменной INGEST_KEY панели. Расхождение — худший из отказов:
# панель отвечает 401, а по 401 роутер гасит телеметрию САМ СЕБЕ и больше не пробует.
TM_KEY_DEF=${TM_KEY_DEF-3056a9de05e4085a4f57b0410fc45cb0}

log() { logger -t splify2-telemetry "$*" 2>/dev/null; echo "$*"; return 0; }

send=0
scheduled=0
while [ $# -gt 0 ]; do
    case "$1" in
        --send)      send=1; shift ;;
        --scheduled) scheduled=1; send=1; shift ;;
        --help|-h)
            echo "использование: splify2-telemetry [--send]"
            echo "без --send пакет печатается и никуда не уходит"
            exit 0 ;;
        *) shift ;;
    esac
done

# ---- согласие ---------------------------------------------------------------------------
# Расписание молчит и при отказе, и при «не спрашивали»: второе не значит «можно».
if [ "$scheduled" = 1 ]; then
    [ "$(tm_consent)" = on ] || exit 0
elif [ "$send" = 1 ]; then
    [ "$(tm_consent)" = on ] || { log "телеметрия выключена — включите её в интерфейсе"; exit 1; }
fi

# ---- город и провайдер --------------------------------------------------------------------
# Единственное место, откуда роутер спрашивает их наружу, и стоит оно ПОСЛЕ проверки согласия:
# без согласия внешнего вызова не происходит вовсе. Сборщик сам наружу не ходит — он читает
# кэш, — поэтому предпросмотр остаётся тем, чем должен быть: чтением, а не действием.
#
# Отказ здесь ничего не значит: полей `net` в пакете просто не будет. Обращение к третьей
# стороне не может решать, уедет ли пакет о работе продукта.
[ "$send" = 1 ] && { tm_net_refresh >/dev/null 2>&1 || true; }

url="$(uci -q get splify2.main.telemetry_url 2>/dev/null || true)"
[ -n "$url" ] || url="$TM_URL_DEF"
key="$(uci -q get splify2.main.telemetry_key 2>/dev/null || true)"
[ -n "$key" ] || key="$TM_KEY_DEF"

pkt="$(tm_build 2>/dev/null)" || { log "пакет не собрался: идентификатор считает движок"; exit 1; }

if [ "$send" != 1 ]; then
    printf '%s\n' "$pkt"
    exit 0
fi
[ -n "$url" ] || { log "адрес панели не задан: пуст и ключ настройки, и умолчание"; exit 1; }

# ---- отправка ----------------------------------------------------------------------------
#
# ЛЕСТНИЦА ОБХОДНЫХ ПУТЕЙ GitHub ЗДЕСЬ НЕ ПРИМЕНИМА, и это не упущение: она разбирает адреса
# GitHub и ходит через зеркала, а зеркало нашей телеметрии означало бы третью сторону,
# которой мы отдаём данные человека.
#
# И ОТПРАВЛЯТЬ НЕЧЕМ, КРОМЕ curl. У busybox uclient-fetch нет ни отправки файла телом, ни
# вывода кода ответа — он умеет только скачивать. Значит на роутере без curl телеметрия не
# работает, и это законное состояние; молчание здесь читалось бы как «отправляется».
# Ловушка ставится ДО создания файла, а не после: между созданием и `trap` помещается сигнал,
# и тогда пакет с настройками роутера остаётся лежать в /tmp до перезагрузки.
tmp="/tmp/splify2-telemetry.$$"
trap 'rm -f "$tmp"' EXIT INT TERM
printf '%s\n' "$pkt" > "$tmp" || exit 1

if ! command -v "$TM_CURL" >/dev/null 2>&1; then
    log "нужен curl: отправить пакет нечем"
    exit 1
fi
# КЛЮЧ — В ЗАГОЛОВКЕ, И ОДНИМ АРГУМЕНТОМ. Кавычки внутри `${key:+…}` группируют: `word` в этой
# подстановке остаётся словом оболочки и снятие кавычек к нему применяется, а разбиение на
# слова — уже нет (проверено на dash, busybox ash и bash). Выглядит это ровно как место, где
# заголовок распадётся на три слова, поэтому форму сторожит стенд: он читает аргументы,
# которые увидел curl, и требует, чтобы ключ приехал ОДНОЙ строкой. Уехал бы он словом —
# заголовок ушёл бы пустым, панель ответила бы 401, роутер по 401 погасил бы телеметрию сам
# себе, и виноватым выглядел бы ключ.
code="$("$TM_CURL" -4 -sS -o /dev/null -w '%{http_code}' \
    --connect-timeout 8 --max-time "$TM_TIMEOUT" \
    -H 'Content-Type: application/json' ${key:+-H "X-Splify2-Key: $key"} \
    --data-binary "@$tmp" "$url" 2>/dev/null)"

now="$(date +%s)"
tm_remember() {  # КЛЮЧ ЗНАЧЕНИЕ
    uci -q set "splify2.main.$1=$2" 2>/dev/null
    uci -q commit splify2 2>/dev/null
}
case "${code:-}" in
    200)
        uci -q delete splify2.main.telemetry_error 2>/dev/null
        tm_remember telemetry_at "$now"
        log "отправлено ($(printf '%s' "$pkt" | wc -c | tr -d ' ') байт)"
        ;;
    400)
        # Панель не разобрала пакет. Повторять нечего: повтор пришлёт то же самое. Причина
        # сохраняется для интерфейса — без неё поломку схемы не найти ни с одной стороны.
        tm_remember telemetry_error "пакет не принят (400)"
        log "панель не приняла пакет (400) — схема разошлась"
        exit 1 ;;
    401)
        # НЕ ПРИЗНАН — гасим расписание до следующего включения переключателя. Иначе
        # неисправный ключ превращается в ежедневный стук в чужую дверь.
        tm_remember telemetry 0
        tm_remember telemetry_error "панель не признала ключ (401), отправка выключена"
        log "панель не признала ключ (401) — телеметрия выключена"
        exit 1 ;;
    429)
        log "панель просит подождать (429) — пропускаем сутки"
        exit 0 ;;
    ''|000)
        # `000` — НЕ КОД ОТВЕТА. Так curl печатает «ответа не было вовсе»: не разрешилось имя,
        # отказано в соединении, вышло время. Пустая строка сюда почти не попадает — curl
        # печатает `%{http_code}` даже когда всё сорвалось, — и пока в разборе стояла только
        # она, недоступная панель уходила в общую ветку и записывала в настройку «панель
        # ответила 000». Интерфейс показывал бы это человеку как ответ панели.
        log "панель не ответила — пропускаем сутки"
        exit 0 ;;
    *)
        tm_remember telemetry_error "панель ответила $code"
        log "панель ответила $code — пропускаем сутки"
        exit 0 ;;
esac
exit 0
