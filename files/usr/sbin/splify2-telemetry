#!/bin/sh
# Отправка пакета телеметрии. Контракт — docs/TELEMETRY.md.
#
# ПО УМОЛЧАНИЮ НИЧЕГО НЕ ОТПРАВЛЯЕТ. Без `--send` команда печатает пакет и уходит: то же
# правило, что у splify2-purge и у автоподбора — действие, уводящее данные с роутера, надо
# назвать вслух. Расписание зовёт с `--send` само, и только если человек согласился.
#
# РАЗ В ЧАС, СВОИМ ЗАДАНИЕМ КРОНА. Раньше отправка ехала хвостом ночного обновления списков —
# ради того, чтобы задание было одно, со случайной минутой и одной строкой, которую обязана
# убирать команда полного удаления. Час хвостом суточного задания не сделать, поэтому довод
# отменён решением владельца, а вместе с ним отменена и экономия: строк в crontab теперь две,
# и обе убирает splify2-purge (стенд purgematch на это смотрит отдельно).
#
# ЧЕМ ЭТО ПОДОРОЖАЛО, ЧЕСТНО. Двадцать четыре обращения к панели в сутки вместо одного и
# столько же сборок пакета. Сборка сама по себе дешёвая, но в ней есть две дорогие вещи, и
# обе обязаны считаться не каждый час: идентификатор (600 000 проходов PBKDF2, 3,24 с на
# AX3000T) берётся из запомненного в настройке, а город и номер сети — из кэша со сроком в
# неделю. Обе проверяет стенд по следствию: движок убирают с дороги, а отправка обязана
# состояться; кэш свеж — за городом наружу не ходили.
#
# НЕ КОПИТ ПРИ НЕДОСТУПНОЙ ПАНЕЛИ. Очередь не нужна по построению: счётчики событий
# кумулятивные с загрузки, поэтому пропущенная отправка не теряет ни одного события —
# следующая покажет число побольше, а `boot` и `uptime` объяснят перезагрузку. Очередь на
# диске вдобавок означала бы запись во флеш ради того, что и так восстановится. На часовом
# такте пропуск стоит ещё меньше, чем на суточном: следующая попытка через час.
set -u

TELEMETRY_SH=${TELEMETRY_SH:-/usr/lib/splify2/telemetry.sh}
[ -r "$TELEMETRY_SH" ] || { echo "нет $TELEMETRY_SH" >&2; exit 2; }
. "$TELEMETRY_SH"

TM_TIMEOUT=${TM_TIMEOUT:-20}
TM_CURL=${TM_CURL:-curl}
# Адрес панели по умолчанию. Зашит в КОМАНДУ, а не только в uci-defaults: ключ настройки
# человек может стереть, а `uci-defaults` отрабатывает один раз при установке и на роутере,
# где настройку правили руками или восстанавливали из архива, его может не быть вовсе. Ключ
# `splify2.main.telemetry_url` при этом остаётся: он ПЕРЕОПРЕДЕЛЯЕТ умолчание, и своя панель
# поднимается одной строкой без правки пакета.
# Подстановка через `-`, а не `:-`, и разница здесь смысловая: ПУСТОЕ значение должно
# оставаться пустым. `:-` подставляет умолчание и на пустое тоже, то есть сборка, нарочно
# собранная без панели или без ключа, молча получала бы наши.
TM_URL_DEF=${TM_URL_DEF-https://splify2-telemetry-panel.vercel.app/api/ingest}
# Общий ключ записи, поставляемый с пакетом. ПУБЛИЧЕН ПО ПОСТРОЕНИЮ и ничего не обещает,
# кроме отсечения случайного мусора: он лежит на роутере, а роутер принадлежит не нам. Тот же
# довод записан в контракте, раздел «Чем панель отличает наш роутер от чужого запроса».
#
# ЗНАЧЕНИЕ ОБЯЗАНО СОВПАДАТЬ с переменной INGEST_KEY панели. Расхождение — худший из отказов:
# панель отвечает 401, а по 401 роутер гасит телеметрию САМ СЕБЕ и больше не пробует.
TM_KEY_DEF=${TM_KEY_DEF-3056a9de05e4085a4f57b0410fc45cb0}

log() { logger -t splify2-telemetry "$*" 2>/dev/null; echo "$*"; return 0; }

# ---- внеплановая отправка при падении ------------------------------------------------------
#
# ПРИ ПАДЕНИИ ОТПРАВЛЯЕМ СРАЗУ, не дожидаясь часа: решение владельца, и оно про то, ради чего
# телеметрия вообще заведена — увидеть, что у людей начало сыпаться, пока это происходит.
#
# ОГРАНИЧИТЕЛЕЙ ТРИ, И КАЖДЫЙ ЗАКРЫВАЕТ СВОЁ. Внеплановая отправка нужна ради СКОРОСТИ —
# узнать сразу, а не через час, — а не ради полноты. Первые несколько падений её и дают;
# сотое падение подряд не сообщает ничего нового: состояние роутера в петле перезапусков
# одинаково, а сколько раз это случилось, покажет `crash.count` в ближайшем плановом пакете.
#
# 1. ПРОМЕЖУТОК — пять минут. Флапающий WAN даёт десятки событий в минуту, и без предела
#    каждое стало бы запросом наружу: мы сами устроили бы себе тот всплеск, который потом
#    ищем в графиках, а на роутере человека — десятки запусков curl подряд. Первая новость о
#    падении при этом уезжает В ТУ ЖЕ СЕКУНДУ: гасятся повторы, а не событие.
#
# 2. СУТОЧНЫЙ ПОТОЛОК — двенадцать, и он не украшение к первому. Промежуток ограничивает
#    ЧАСТОТУ, но не КОЛИЧЕСТВО: пять минут между отправками — это до 288 пакетов в сутки,
#    плюс 24 плановых. Панель принимает от одного идентификатора 48 пакетов за скользящие
#    сутки (MAX_PER_DAY в её lib/db.js) и дальше отвечает 429, а по 429 команда пропускает
#    такт ЦЕЛИКОМ — то есть, исчерпав предел внеплановыми, роутер перестал бы присылать и
#    плановые. Ровно на сломанном роутере панель перестала бы видеть состояние, и график
#    показал бы, что беда прекратилась, потому что о ней больше не сообщают. Поднимать предел
#    на панели — не туда: он же ограничивает и подделку, а идентификатор публичен. Поэтому
#    потолок стоит У ИСТОЧНИКА: 24 плановых + 12 внеплановых = 36 из 48, остальное запас.
#
#    Окно СКОЛЬЗЯЩЕЕ, а не календарные сутки, — потому что скользящее оно и у панели.
#    С календарным сбросом двенадцать отправок в 23:59 и ещё двенадцать в 00:01 легли бы в
#    одни и те же сутки её счёта. Поэтому в файле лежат сами отметки времени (не больше
#    двенадцати), а не число: пересчитать по ним окно стоит один проход, а память — дюжину
#    строк.
#
# 3. ПЕРВЫЕ ДВЕ МИНУТЫ ПОСЛЕ ЗАГРУЗКИ внеплановых отправок нет. Отметки лежат в /var/run
#    (tmpfs) — писать их во флеш означало бы убивать память ровно в том случае, который мы и
#    хотим измерить, — а значит перезагрузка обнуляет и промежуток, и потолок. Роутер в петле
#    перезапусков обходил бы оба ограничителя по разу за цикл. Состояние в первую минуту всё
#    равно не установилось, и плановый пакет расскажет о нём честнее.
#
# ПЛАНОВАЯ ОТПРАВКА НИ ОДНИМ ИЗ НИХ НЕ ГАСИТСЯ. Все три про повторы внеплановых, а не про
# расписание: час молчания после падения означал бы дыру в ряде наблюдений там, где он всего
# нужнее, — а суточный потолок, погасив и плановые, привёл бы ровно к тому 429, от которого
# и заведён.
TM_NOW_STAMP=${TM_NOW_STAMP:-/var/run/splify2-telemetry-now}
TM_NOW_GAP=${TM_NOW_GAP:-300}
TM_NOW_MAX=${TM_NOW_MAX:-12}
TM_NOW_MIN_UP=${TM_NOW_MIN_UP:-120}
TM_UPTIME=${TM_UPTIME:-/proc/uptime}

# -> 0, если внеплановую отправку делать можно. Заодно ЗАПИСЫВАЕТ отметку: разделять «можно»
# и «записал» значило бы завести состояние, которое может разойтись само с собой.
tm_now_gate() {
    _g_at="$(date +%s)"
    _g_up="$(cut -d. -f1 "$TM_UPTIME" 2>/dev/null)"
    case "${_g_up:-}" in ''|*[!0-9]*) _g_up="$TM_NOW_MIN_UP" ;; esac
    [ "$_g_up" -ge "$TM_NOW_MIN_UP" ] || return 1
    _g_keep=""
    _g_n=0
    _g_last=0
    if [ -s "$TM_NOW_STAMP" ]; then
        while read -r _g_t; do
            case "${_g_t:-}" in ''|*[!0-9]*) continue ;; esac
            # Отметки старше суток выбрасываются здесь же: файл не растёт, а окно считается
            # по тем же правилам, по которым его считает панель.
            [ "$(( _g_at - _g_t ))" -lt 86400 ] || continue
            _g_keep="$_g_keep$_g_t
"
            _g_n=$((_g_n + 1))
            _g_last="$_g_t"
        done < "$TM_NOW_STAMP"
    fi
    [ "$(( _g_at - _g_last ))" -ge "$TM_NOW_GAP" ] || return 1
    [ "$_g_n" -lt "$TM_NOW_MAX" ] || return 1
    mkdir -p "$(dirname "$TM_NOW_STAMP")" 2>/dev/null
    printf '%s%s\n' "$_g_keep" "$_g_at" > "$TM_NOW_STAMP" 2>/dev/null
    return 0
}

send=0
scheduled=0
now=''
what=''
code=0
signal=0
need() {  # КЛЮЧ ЧИСЛО_ОСТАВШИХСЯ — у ключа обязан быть аргумент
    [ "$2" -ge 2 ] || { log "ключу $1 нужно значение"; exit 2; }
}
while [ $# -gt 0 ]; do
    case "$1" in
        --send)      send=1; shift ;;
        --scheduled) scheduled=1; send=1; shift ;;
        --now)       need "$1" $#; now="$2"; send=1; shift 2 ;;
        --what)      need "$1" $#; what="$2"; shift 2 ;;
        --code)      need "$1" $#; code="$2"; shift 2 ;;
        --signal)    need "$1" $#; signal="$2"; shift 2 ;;
        --help|-h)
            echo "использование: splify2-telemetry [--send] [--now ПРИЧИНА [--what ЧТО] [--code N] [--signal N]]"
            echo "без --send пакет печатается и никуда не уходит"
            echo "--now: внеплановая отправка при падении; ПРИЧИНА только из набора:"
            echo "       steer_down zapret_down xsteer_down wan_flap boot oom apply_failed"
            exit 0 ;;
        *) shift ;;
    esac
done

# ПРИЧИНА ПРОВЕРЯЕТСЯ ДО ВСЕГО ОСТАЛЬНОГО. Свободная строка здесь — это готовый способ увезти
# в пакет что угодно: команду может позвать любой скрипт с правами root, и «причина» уехала бы
# в панель дословно. Сама она в сообщение не подставляется по той же причине.
if [ -n "$now" ]; then
    tm_crash_reason_ok "$now" || { log "причина не из закрытого набора — отправки не будет"; exit 2; }
    [ -n "$what" ] || what="$(tm_crash_what_for "$now")"
    tm_crash_what_ok "$what" || { log "«что упало» не из закрытого набора — отправки не будет"; exit 2; }
fi

# ---- согласие ---------------------------------------------------------------------------
#
# ОДНО РЕШЕНИЕ, ОДНА ФУНКЦИЯ. Отправляем везде, кроме явного отказа: пользуясь splify2,
# человек согласился, а отказ он выражает переключателем в «Настройки → О ПО». Сравнение
# состояния (`tm_consent`) здесь нарочно НЕ повторяется — состояний три, а решений одно, и
# второе сравнение рано или поздно разойдётся с тем, что показывает интерфейс.
#
# Разница между расписанием и рукой только в громкости: расписание уходит молча (человек его
# не звал), позванной руками команде отказ надо назвать вслух — иначе молчание читается как
# «отправлено».
if [ "$scheduled" = 1 ] || [ -n "$now" ]; then
    tm_allowed || exit 0
elif [ "$send" = 1 ]; then
    tm_allowed || { log "телеметрия выключена — включить её можно в «Настройки → О ПО»"; exit 1; }
fi

# ---- падение: сначала записать, потом решать, отправлять ли -------------------------------
#
# ПОРЯДОК ВАЖЕН. Факт падения записывается ВСЕГДА — счётчик с загрузки и «последнее падение»,
# — а ограничитель гасит только отправку. Сделай наоборот, и панель увидела бы одно падение
# там, где их было сорок: «сыпется» стало бы неотличимо от «дёрнулось однажды», хотя разница
# между этими двумя случаями и есть весь смысл затеи. Погашенное событие не теряется: счётчик
# и последнее падение уедут ближайшим плановым пакетом.
if [ -n "$now" ]; then
    tm_crash_record "$what" "$now" "$code" "$signal" || log "падение не записалось"
    tm_now_gate || exit 0
fi

# ---- город и провайдер --------------------------------------------------------------------
# Единственное место, откуда роутер спрашивает их наружу, и стоит оно ПОСЛЕ проверки согласия:
# без согласия внешнего вызова не происходит вовсе. Сборщик сам наружу не ходит — он читает
# кэш, — поэтому предпросмотр остаётся тем, чем должен быть: чтением, а не действием.
#
# И ТОЛЬКО ЕСЛИ КЭШ ПРОТУХ. На суточном такте разницы почти не было, на часовом она решающая:
# без этой проверки третья сторона видела бы наш роутер каждый час, то есть сто шестьдесят
# восемь раз в неделю вместо одного. Город и номер сети меняются с переездом и сменой
# провайдера — раз в годы, — так что неделя здесь с огромным запасом.
#
# Отказ здесь ничего не значит: полей `net` в пакете просто не будет. Обращение к третьей
# стороне не может решать, уедет ли пакет о работе продукта.
[ "$send" = 1 ] && { tm_net_fresh || tm_net_refresh >/dev/null 2>&1 || true; }

url="$(uci -q get splify2.main.telemetry_url 2>/dev/null || true)"
[ -n "$url" ] || url="$TM_URL_DEF"
key="$(uci -q get splify2.main.telemetry_key 2>/dev/null || true)"
[ -n "$key" ] || key="$TM_KEY_DEF"

pkt="$(tm_build 2>/dev/null)" || { log "пакет не собрался: идентификатор считает движок"; exit 1; }

if [ "$send" != 1 ]; then
    printf '%s\n' "$pkt"
    exit 0
fi
[ -n "$url" ] || { log "адрес панели не задан: пуст и ключ настройки, и умолчание"; exit 1; }

# ---- отправка ----------------------------------------------------------------------------
#
# ЛЕСТНИЦА ОБХОДНЫХ ПУТЕЙ GitHub ЗДЕСЬ НЕ ПРИМЕНИМА, и это не упущение: она разбирает адреса
# GitHub и ходит через зеркала, а зеркало нашей телеметрии означало бы третью сторону,
# которой мы отдаём данные человека.
#
# И ОТПРАВЛЯТЬ НЕЧЕМ, КРОМЕ curl. У busybox uclient-fetch нет ни отправки файла телом, ни
# вывода кода ответа — он умеет только скачивать. Значит на роутере без curl телеметрия не
# работает, и это законное состояние; молчание здесь читалось бы как «отправляется».
# Ловушка ставится ДО создания файла, а не после: между созданием и `trap` помещается сигнал,
# и тогда пакет с настройками роутера остаётся лежать в /tmp до перезагрузки.
tmp="/tmp/splify2-telemetry.$$"
trap 'rm -f "$tmp"' EXIT INT TERM
printf '%s\n' "$pkt" > "$tmp" || exit 1

if ! command -v "$TM_CURL" >/dev/null 2>&1; then
    log "нужен curl: отправить пакет нечем"
    exit 1
fi
# КЛЮЧ — В ЗАГОЛОВКЕ, И ОДНИМ АРГУМЕНТОМ. Кавычки внутри `${key:+…}` группируют: `word` в этой
# подстановке остаётся словом оболочки и снятие кавычек к нему применяется, а разбиение на
# слова — уже нет (проверено на dash, busybox ash и bash). Выглядит это ровно как место, где
# заголовок распадётся на три слова, поэтому форму сторожит стенд: он читает аргументы,
# которые увидел curl, и требует, чтобы ключ приехал ОДНОЙ строкой. Уехал бы он словом —
# заголовок ушёл бы пустым, панель ответила бы 401, роутер по 401 погасил бы телеметрию сам
# себе, и виноватым выглядел бы ключ.
code="$("$TM_CURL" -4 -sS -o /dev/null -w '%{http_code}' \
    --connect-timeout 8 --max-time "$TM_TIMEOUT" \
    -H 'Content-Type: application/json' ${key:+-H "X-Splify2-Key: $key"} \
    --data-binary "@$tmp" "$url" 2>/dev/null)"

now="$(date +%s)"
tm_remember() {  # КЛЮЧ ЗНАЧЕНИЕ
    uci -q set "splify2.main.$1=$2" 2>/dev/null
    uci -q commit splify2 2>/dev/null
}
case "${code:-}" in
    200)
        uci -q delete splify2.main.telemetry_error 2>/dev/null
        tm_remember telemetry_at "$now"
        log "отправлено ($(printf '%s' "$pkt" | wc -c | tr -d ' ') байт)"
        ;;
    400)
        # Панель не разобрала пакет. Повторять нечего: повтор пришлёт то же самое. Причина
        # сохраняется для интерфейса — без неё поломку схемы не найти ни с одной стороны.
        tm_remember telemetry_error "пакет не принят (400)"
        log "панель не приняла пакет (400) — схема разошлась"
        exit 1 ;;
    401)
        # НЕ ПРИЗНАН — гасим расписание до следующего включения переключателя. Иначе
        # неисправный ключ превращается в ежедневный стук в чужую дверь.
        tm_remember telemetry 0
        tm_remember telemetry_error "панель не признала ключ (401), отправка выключена"
        log "панель не признала ключ (401) — телеметрия выключена"
        exit 1 ;;
    429)
        log "панель просит подождать (429) — пропускаем час"
        exit 0 ;;
    ''|000)
        # `000` — НЕ КОД ОТВЕТА. Так curl печатает «ответа не было вовсе»: не разрешилось имя,
        # отказано в соединении, вышло время. Пустая строка сюда почти не попадает — curl
        # печатает `%{http_code}` даже когда всё сорвалось, — и пока в разборе стояла только
        # она, недоступная панель уходила в общую ветку и записывала в настройку «панель
        # ответила 000». Интерфейс показывал бы это человеку как ответ панели.
        log "панель не ответила — пропускаем час"
        exit 0 ;;
    *)
        tm_remember telemetry_error "панель ответила $code"
        log "панель ответила $code — пропускаем час"
        exit 0 ;;
esac
exit 0
