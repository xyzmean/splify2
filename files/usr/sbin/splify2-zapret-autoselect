#!/bin/sh
# Автоподбор стратегии обхода DPI: прогнать проверку, отранжировать, применить победителя.
#
# ЧТО ЭТО ЗА КОМАНДА И ЧЕМ ОНА НЕ ЯВЛЯЕТСЯ. Она НЕ проверяет стратегии сама — это делает
# splify2-zapret-test, в изоляции и не трогая ни один чужой пакет. Она НЕ решает, какая
# стратегия лучше, — это правило живёт в zapret.sh (zp_rank, zp_winner), потому что тот же
# ответ нужен вкладке. Здесь склейка из трёх шагов и всё, что к склейке относится: когда
# можно, когда нельзя и что сказать человеку.
#
# ПО УМОЛЧАНИЮ НИЧЕГО НЕ МЕНЯЕТ. Без --apply команда печатает рейтинг и приговор — то же
# правило, что у splify2-purge: действие, меняющее работающий роутер, требуется назвать
# вслух. Расписание зовёт её с --apply само, но только если человек включил автоподбор.
#
# ПОЧЕМУ АВТОПОДБОР ВЫКЛЮЧЕН ПО УМОЛЧАНИЮ. Применение стратегии — это перезапуск обхода на
# живом роутере и смена того, что работает у всех его клиентов. Такое не включают за
# человека. Ключ splify2.main.zapret_autoselect хранит ЧИСЛО ДНЕЙ между подборами (0 или
# пусто — выключено); умолчание при включении из интерфейса — 7.
set -u

ZAPRET_SH=${ZAPRET_SH:-/usr/lib/splify2/zapret.sh}
[ -r "$ZAPRET_SH" ] || { echo "нет $ZAPRET_SH" >&2; exit 2; }
. "$ZAPRET_SH"

ZAPRET_TEST=${ZAPRET_TEST:-/usr/sbin/splify2-zapret-test}
# Ход автоподбора — в /var, как и ход проверки: строка «идёт проверка» живёт минуты.
ZA_PROGRESS=${ZA_PROGRESS:-/var/run/splify2-zapret-autoselect.progress}
ZA_LOCK=${ZA_LOCK:-/var/lock/splify2-zapret-autoselect.lock}
# Признаки покоя. Подбор гоняет три десятка запросов на каждую из полусотни стратегий, то
# есть греет процессор роутера минутами, а применение победителя перезапускает обход. Ни то
# ни другое не должно случаться в момент, когда через роутер идёт кино.
ZA_MAX_LOAD=${ZA_MAX_LOAD:-100}          # средняя загрузка за минуту ×100 (100 = 1.00)
ZA_MAX_KBIT=${ZA_MAX_KBIT:-300}          # трафик на внешнем устройстве, кбит/с
ZA_IDLE_SAMPLE=${ZA_IDLE_SAMPLE:-2}      # сколько секунд мерить трафик
ZA_UCI=${ZA_UCI:-uci}
ZA_LOADAVG=${ZA_LOADAVG:-/proc/loadavg}
ZA_SYSFS=${ZA_SYSFS:-/sys/class/net}

# И в журнал, и на вывод — ВСЕГДА, а не только на терминале.
#
# Прежняя редакция печатала на вывод лишь под `[ -t 1 ]`, как это делает проверка стратегий.
# Там это верно: проверка живёт десятки минут, её зовут фоном, и человек читает файл хода. А
# здесь наоборот: команду зовут и руками, и через `ubus`, и из расписания, — и в двух случаях
# из трёх терминала нет, но ответ нужен. Отказы «роутер занят» и «проверка не удалась»
# уезжали при этом в один syslog: со стороны выглядело так, будто команда молча ничего не
# сделала. Расписание вывод глушит само (`>/dev/null` в splify2-update-lists), так что почту
# крону это не прибавляет.
log() { logger -t splify2-zapret-autoselect "$*" 2>/dev/null; echo "$*"; return 0; }
say() { echo "$*"; }

scope=all
do_apply=0
scheduled=0
run_test=1
while [ $# -gt 0 ]; do
    case "$1" in
        --scope)     scope="${2:-all}"; shift 2 ;;
        --apply)     do_apply=1; shift ;;
        --scheduled) scheduled=1; do_apply=1; shift ;;
        # Ранжировать уже имеющиеся результаты, не гоняя проверку заново. Нужно вкладке и
        # тому, кто хочет увидеть приговор по вчерашнему прогону, ничего не запуская.
        --no-test)   run_test=0; shift ;;
        --help|-h)
            say "использование: splify2-zapret-autoselect [--scope all|flowseal|v|yv] [--apply] [--no-test]"
            say "без --apply ничего не меняется: печатается рейтинг и приговор"
            exit 0 ;;
        *) shift ;;
    esac
done

progress() {  # СОСТОЯНИЕ [ПОЯСНЕНИЕ]
    printf 'state=%s\nat=%s\nscope=%s\n%s' "$1" "$(date +%s)" "$scope" \
        "${2:+note=$2$(printf '\n')}" > "$ZA_PROGRESS" 2>/dev/null
    return 0
}

# ---- когда автоподбор вообще уместен --------------------------------------------------
zp_installed || { log "обход DPI не установлен — подбирать нечего"; progress error "обход не установлен"; exit 2; }

# Расписание спрашивает больше, чем ручной запуск, и каждый вопрос отсекает свой случай.
if [ "$scheduled" = 1 ]; then
    days="$($ZA_UCI -q get splify2.main.zapret_autoselect 2>/dev/null || true)"
    case "${days:-0}" in ''|*[!0-9]*) days=0 ;; esac
    [ "$days" -gt 0 ] || exit 0   # выключено — молча, это не ошибка
    # Срок. Отметка — время ПРИМЕНЕНИЯ из записи автоподбора, а не время последнего прогона:
    # прогон, кончившийся отказом «уже лучшая», сроку не мешает — иначе роутер, у которого
    # всё хорошо, гонял бы проверку каждую ночь.
    last="$(zp_autosel_get at 2>/dev/null || echo 0)"
    case "${last:-0}" in ''|*[!0-9]*) last=0 ;; esac
    now="$(date +%s)"
    if [ "$last" -gt 0 ] && [ $((now - last)) -lt $((days * 86400)) ]; then
        exit 0
    fi
    # Обход выключен целиком — подбирать нечего: победителя некуда применять, а проверка
    # всё равно поднимает свой экземпляр и мерила бы то, чего человек не включал.
    zp_enabled || { log "обход выключен на весь роутер — подбор пропущен"; exit 0; }
fi

# Покой. Проверяется и для расписания, и для ручного --apply: человек, нажавший кнопку в
# момент, когда через роутер идёт трафик, получит внятную строку вместо просадки.
idle_load() {
    [ -r "$ZA_LOADAVG" ] || return 0
    _il="$(awk '{ print int($1 * 100) }' "$ZA_LOADAVG" 2>/dev/null)"
    case "${_il:-0}" in ''|*[!0-9]*) return 0 ;; esac
    [ "$_il" -le "$ZA_MAX_LOAD" ]
}

# Внешнее устройство — то, через которое роутер выходит наружу. Спрашивается у сети, а не
# угадывается по имени: имя устройства человек выбирает сам.
wan_dev() {
    _wd="$(ip -4 route show default 2>/dev/null | awk '/dev/ { for (i = 1; i < NF; i++) if ($i == "dev") { print $(i+1); exit } }')"
    printf '%s' "${_wd:-}"
}

dev_bytes() {  # УСТРОЙСТВО
    _db=0
    for _dbf in "$ZA_SYSFS/${1:-}/statistics/rx_bytes" "$ZA_SYSFS/${1:-}/statistics/tx_bytes"; do
        [ -r "$_dbf" ] || continue
        _dbv="$(cat "$_dbf" 2>/dev/null)"
        case "${_dbv:-}" in ''|*[!0-9]*) continue ;; esac
        _db=$((_db + _dbv))
    done
    printf '%s' "$_db"
}

idle_traffic() {
    _it_dev="$(wan_dev)"
    # Внешнего устройства нет — мерить нечего, и это не повод отказывать: на роутере без
    # маршрута по умолчанию проверка всё равно ничего не откроет и кончится сама.
    [ -n "$_it_dev" ] || return 0
    _it_a="$(dev_bytes "$_it_dev")"
    sleep "$ZA_IDLE_SAMPLE"
    _it_b="$(dev_bytes "$_it_dev")"
    [ "$_it_b" -ge "$_it_a" ] || return 0   # счётчик переполнился — не считаем это трафиком
    _it_kbit=$(( (_it_b - _it_a) * 8 / 1000 / ZA_IDLE_SAMPLE ))
    [ "$_it_kbit" -le "$ZA_MAX_KBIT" ]
}

if [ "$do_apply" = 1 ]; then
    if ! idle_load; then
        log "роутер занят (загрузка выше $ZA_MAX_LOAD/100) — подбор отложен"
        progress skipped "роутер занят"
        exit 0
    fi
    if ! idle_traffic; then
        log "через роутер идёт трафик (больше $ZA_MAX_KBIT кбит/с) — подбор отложен"
        progress skipped "идёт трафик"
        exit 0
    fi
fi

# Два подбора разом — это два экземпляра nfqws на одной очереди и две записи в одну копию.
if [ -e "$ZA_LOCK" ] && kill -0 "$(cat "$ZA_LOCK" 2>/dev/null || echo 0)" 2>/dev/null; then
    log "подбор уже идёт"
    exit 0
fi
mkdir -p "$(dirname "$ZA_LOCK")" "$(dirname "$ZA_PROGRESS")" 2>/dev/null
echo $$ > "$ZA_LOCK"
trap 'rm -f "$ZA_LOCK"' EXIT INT TERM

# ---- шаг 1: проверка ------------------------------------------------------------------
# В ПЕРЕДНЕМ ПЛАНЕ, а не через start-stop-daemon: мы сами уже в фоне (крон или rpcd
# запустили нас отвязанно), и ранжировать надо ПОСЛЕ прогона. Запустить проверку в фон и
# опрашивать её файл хода значило бы завести здесь второй цикл ожидания там, где хватает
# кода возврата.
if [ "$run_test" = 1 ]; then
    [ -x "$ZAPRET_TEST" ] || { log "нет $ZAPRET_TEST"; progress error "нет команды проверки"; exit 2; }
    progress testing
    log "подбор: проверка стратегий ($scope)"
    if ! "$ZAPRET_TEST" --scope "$scope" >/dev/null 2>&1; then
        log "проверка не удалась — подбор прекращён"
        progress error "проверка не удалась"
        exit 1
    fi
fi

# ---- шаг 2: рейтинг -------------------------------------------------------------------
progress ranking
rank="$(zp_rank 2>/dev/null)"
if [ -z "$rank" ]; then
    log "рейтинга нет: результатов проверки не найдено"
    progress error "рейтинга нет"
    exit 1
fi
say "рейтинг (доля, удач из целей, ключей, набор, имя):"
printf '%s\n' "$rank" | awk -F'\t' '{ printf "  %5.1f%%  %2d/%-2d  %2d ключей  %-8s %s\n", $1 / 100, $2, $3, $4, $5, $6 }'

# ---- шаг 3: приговор и применение -----------------------------------------------------
# Без подоболочки: ответ приезжает в ZP_WINNER, причина отказа — в ZP_NOTE (см. zp_winner).
if ! zp_winner; then
    log "$ZP_NOTE"
    progress done "$ZP_NOTE"
    # Не ошибка: «менять не на что» — законный и частый ответ.
    exit 0
fi
w_ok="$(printf '%s' "$ZP_WINNER" | cut -f2)"
w_total="$(printf '%s' "$ZP_WINNER" | cut -f3)"
w_set="$(printf '%s' "$ZP_WINNER" | cut -f5)"
w_name="$(printf '%s' "$ZP_WINNER" | cut -f6)"
say "победитель: $w_name ($w_ok из $w_total, набор $w_set)"

if [ "$do_apply" != 1 ]; then
    say "ничего не изменено — для применения нужен --apply"
    progress done "победитель $w_name, не применён"
    exit 0
fi

if zp_apply_winner "$w_name" "$w_ok" "$w_total" "$w_set" \
        "$([ "$scheduled" = 1 ] && echo auto || echo manual)" "$scope"; then
    # Обход перезапускается, только если он работает: применение стратегии выключенному
    # обходу ничего не должно включать — человек его выключал.
    if zp_running && [ -x "$ZP_INIT" ]; then
        "$ZP_INIT" restart >/dev/null 2>&1 || log "стратегия применена, но перезапуск обхода не удался"
    fi
    log "применена $w_name ($w_ok из $w_total); откат: splify2-zapret-autoselect не нужен, есть zapret_autoselect_undo"
    say "применена $w_name — прежняя настройка сохранена, откат возможен"
    progress done "применена $w_name"
    exit 0
fi
log "применить не удалось: ${ZP_NOTE:-причина не названа}"
progress error "${ZP_NOTE:-применить не удалось}"
exit 1
