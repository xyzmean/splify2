#!/bin/sh
# ubus-объект splify2 — тонкая обёртка над движком.
#
# Здесь сознательно нет собственной модели каналов. Движок уже умеет отвечать на все
# вопросы про своё состояние, и вторая модель означала бы второе место, которое надо
# держать в согласии с контрактом. Поэтому status/explain отдаются дословно, а spec
# только читается и записывается — с обязательной проверкой компилятором перед тем,
# как файл встанет на место.
. /usr/share/libubox/jshn.sh

STEER=/usr/sbin/steer
SPEC=/etc/steer/spec.json
LISTS=/etc/steer/lists
# Подписка VLESS. Один файл на роутер, а не по файлу на выход: узлы в подписке уже
# перечислены списком, и выход выбирает из них номером. Два выхода на одну подписку — это
# два узла одного провайдера, и держать для этого две копии файла было бы странно.
SUB=/etc/steer/sub.txt
MANIFEST=/etc/splify2/manifest.json
# Тот же источник, что и у файлов списков: base_url внутри манифеста указывает на
# raw в main, и брать сам манифест из релиза значило бы, что он описывает одни файлы,
# а скачиваются другие. Расхождение проявилось бы как "список есть в интерфейсе, но
# качается пустым" — то есть в самом непонятном для человека виде.
#
# Цена: raw кеширует минут на пять, поэтому свежий прогон CI видно не мгновенно. Для
# списков, которые обновляются раз в сутки, это дешевле рассинхронизации. Переопределяется
# через uci: splify2.main.manifest_url.
MANIFEST_URL_DEFAULT="https://raw.githubusercontent.com/xyzmean/ru-bypass-ipsets/refs/heads/main/lists/categories.json"

fail() { json_init; json_add_boolean ok 0; json_add_string error "$1"; json_dump; exit 0; }

# Найти файл списка в манифесте по id И ВИДУ.
#
# Вид обязателен, и это не перестраховка: `categories` и `domain_lists` — разные
# пространства имён, и один id законно есть в обоих. У издателя так с `hodca` и `news`:
# адресный `hodca.lst` (5444 подсети) и доменный `domains/hodca.lst` (250 имён).
#
# Прежняя версия искала сначала в доменных, поэтому на запрос АДРЕСНОЙ категории скачивала
# доменный файл. Дальше канал читал домены как подсети, nft отвергал набор целиком — и
# вставала вся маршрутизация. Симптом «включил Хостинги и CDN, всё умерло» — отсюда.
manifest_file() {  # ID ВИД
    case "$2" in
        domains)  jsonfilter -i "$MANIFEST" -e "@.domain_lists[@.id='$1'].file" 2>/dev/null ;;
        prefixes) jsonfilter -i "$MANIFEST" -e "@.categories[@.id='$1'].file" 2>/dev/null ;;
        *)
            # Вид не указан — старый вызов. Тогда порядок обратный прежнему: адресные
            # первыми, потому что доменные лежат в своём подкаталоге и путь у них
            # различим, а вот адресная категория при промахе давала именно ту поломку.
            f="$(jsonfilter -i "$MANIFEST" -e "@.categories[@.id='$1'].file" 2>/dev/null)"
            [ -n "$f" ] || f="$(jsonfilter -i "$MANIFEST" -e "@.domain_lists[@.id='$1'].file" 2>/dev/null)"
            printf '%s' "$f"
            ;;
    esac
}

# Локальный путь списка: ПОВТОРЯЕТ путь у издателя, а не берёт от него имя файла.
#
# `basename` схлопывал `hodca.lst` и `domains/hodca.lst` в один локальный файл, и они
# затирали друг друга. То же правило продублировано в интерфейсе (pathFor) — разойдясь,
# они дадут «список скачан, а канал его не находит».
local_path() {  # ПУТЬ_У_ИЗДАТЕЛЯ
    printf '%s/%s' "$LISTS" "$(echo "$1" | sed 's|^/*||')"
}

manifest_url() {
    u="$(uci -q get splify2.main.manifest_url)"
    [ -n "$u" ] && printf '%s' "$u" || printf '%s' "$MANIFEST_URL_DEFAULT"
}

# Единственный способ скачать: сначала во временный файл, потом переименовать. Иначе
# оборванная загрузка оставляет на месте рабочего списка обрубок, и канал начинает
# маршрутизировать половину.
download() {  # URL DEST
    tmp="$2.tmp"
    if command -v curl >/dev/null 2>&1; then
        curl -fsSL --max-time 60 -o "$tmp" "$1" || { rm -f "$tmp"; return 1; }
    else
        uclient-fetch -q -T 60 -O "$tmp" "$1" || { rm -f "$tmp"; return 1; }
    fi
    [ -s "$tmp" ] || { rm -f "$tmp"; return 1; }
    mv "$tmp" "$2"
}

# Зона фаервола для устройств, которые движок создаёт сам (выходы kind=vless).
#
# Зачем это здесь. fw4 отвергает форвардинг на устройство, не входящее ни в одну зону:
# политика цепочки forward — drop, и клиент получает «Operation not permitted» ещё до
# того, как пакет доберётся до туннеля. Проверено с настоящего клиента, а не выведено.
#
# Почему этого не делает движок. В nftables вердикт accept в своей базовой цепочке
# завершает только ЕЁ: пакет всё равно доходит до цепочки fw4 и там отбрасывается. То
# есть «разрешить заранее» из отдельной таблицы невозможно в принципе, и единственный
# способ — попасть в зону. А зоны — это uci, то есть управляющий слой. Движок про это
# честно предупреждает («not mentioned by the firewall at all»), но починить не может.
#
# masquerade НЕ включается, и это не забывчивость: клиент VLESS завершает TCP у себя и
# соединяется с сервером обычным сокетом, поэтому адрес клиента наружу не уезжает вовсе.
# Включить NAT здесь значило бы добавить трансляцию, которой нечего транслировать.
ZONE=steer_vless
# Признак «настройку vless надо перечитать». Ставится там, где изменилось то, что клиент
# читает ОДИН РАЗ при старте — выбранный узел или файл подписки, — и снимается после
# перезапуска экземпляров.
#
# Через файл, а не переменную: spec_set и apply — два отдельных вызова rpcd, то есть два
# процесса, и между ними ничего не переживает, кроме диска.
VLESS_DIRTY=/var/run/splify2-vless-dirty

# Отпечаток того, от чего зависит выбор узла. Меняется он — надо перезапустить клиента,
# не меняется — трогать туннель нельзя: перезапуск роняет все соединения через него, а
# заново выбранный «первый рабочий» может оказаться другим узлом. Правка списка домены
# не должна менять выходной адрес.
vless_fingerprint() {  # ФАЙЛ_СПЕКИ
    f="$1"
    [ -s "$f" ] || { echo none; return; }
    for o in $("$STEER" outputs --kind vless --spec "$f" 2>/dev/null); do
        printf '%s:%s:%s\n' "$o" \
            "$(jsonfilter -i "$f" -e "@.outputs.$o.sub_file" 2>/dev/null)" \
            "$(jsonfilter -i "$f" -e "@.outputs.$o.node" 2>/dev/null)"
    done | md5sum | awk '{print $1}'
}

zone_index() {
    uci show firewall 2>/dev/null | sed -n "s/^firewall\.@zone\[\([0-9]*\)\]\.name='$ZONE'$/\1/p" | head -1
}

ensure_vless_zone() {  # список устройств
    devs="$1"
    [ -n "$devs" ] || return 0
    changed=0
    idx="$(zone_index)"
    if [ -z "$idx" ]; then
        uci -q add firewall zone >/dev/null
        uci -q set firewall.@zone[-1].name="$ZONE"
        # input REJECT: зона нужна для транзита, а не для доступа к самому роутеру со
        # стороны туннеля. forward ACCEPT — иначе смысла в ней нет.
        uci -q set firewall.@zone[-1].input='REJECT'
        uci -q set firewall.@zone[-1].output='ACCEPT'
        uci -q set firewall.@zone[-1].forward='ACCEPT'
        uci -q set firewall.@zone[-1].masq='0'
        uci -q set firewall.@zone[-1].mtu_fix='1'
        idx="$(zone_index)"
        changed=1
    fi
    [ -n "$idx" ] || return 1
    for d in $devs; do
        uci -q get "firewall.@zone[$idx].device" 2>/dev/null | grep -qw "$d" || {
            uci -q add_list "firewall.@zone[$idx].device"="$d"
            changed=1
        }
    done
    # Разрешение lan -> зона. Без него зона есть, а трафик всё равно не идёт: политика
    # forward у fw4 применяется к паре зон, а не к одной.
    uci show firewall 2>/dev/null | grep -q "\.dest='$ZONE'" || {
        uci -q add firewall forwarding >/dev/null
        uci -q set firewall.@forwarding[-1].src='lan'
        uci -q set firewall.@forwarding[-1].dest="$ZONE"
        changed=1
    }
    if [ "$changed" = 1 ]; then
        uci -q commit firewall
        fw4 reload >/dev/null 2>&1 || /etc/init.d/firewall reload >/dev/null 2>&1
        echo "splify2: устройства $devs добавлены в зону $ZONE (иначе fw4 не пропускает транзит)"
    fi
}

# Архитектура ПАКЕТОВ, а не процессора.
#
# `apk --print-arch` отдаёт `aarch64`, а пакеты OpenWrt называются `aarch64_cortex-a53`:
# по первому имя файла собирается неверно, и скачивание молча не находит релиз. Верный
# источник — DISTRIB_ARCH из /etc/openwrt_release, то же значение, что показывает
# `apk list -I` в колонке архитектуры.
pkg_arch() {
    [ -f /etc/openwrt_release ] || { apk --print-arch 2>/dev/null; return; }
    ( . /etc/openwrt_release; printf '%s' "${DISTRIB_ARCH:-$(apk --print-arch 2>/dev/null)}" )
}

case "$1" in
list)
    json_init
    json_add_object status; json_close_object
    json_add_object spec_get; json_close_object
    json_add_object spec_set; json_add_string spec; json_close_object
    json_add_object apply; json_close_object
    json_add_object explain; json_add_string address; json_close_object
    json_add_object lists; json_close_object
    json_add_object list_fetch; json_add_string id; json_close_object
    json_add_object devices; json_close_object
    json_add_object local_lists; json_close_object
    json_add_object list_remove; json_add_string id; json_close_object
    json_add_object engine; json_close_object
    json_add_object sub_set; json_add_string url; json_close_object
    json_add_object sub_info; json_close_object
    json_add_object dev_stats; json_close_object
    json_add_object vless_nodes; json_add_string output; json_close_object
    json_add_object vless_probe
        json_add_string output; json_add_int node
    json_close_object
    json_add_object steer_versions; json_close_object
    json_add_object steer_install
        json_add_string version; json_add_boolean extended
    json_close_object
    json_dump
    ;;
call)
    case "$2" in
    status)
        # Движок печатает JSON сам. Если он не отвечает — честная ошибка, а не пустой
        # объект, который интерфейс покажет как «всё в порядке».
        out="$("$STEER" status --spec "$SPEC" 2>/dev/null)"
        case "$out" in '{'*) printf '%s\n' "$out" ;; *) fail "движок не ответил" ;; esac
        ;;

    spec_get)
        [ -s "$SPEC" ] && cat "$SPEC" || printf '{"schema":1,"outputs":{},"channels":[]}\n'
        ;;

    spec_set)
        read -r input
        json_load "$input" 2>/dev/null || fail "неразбираемый запрос"
        json_get_var spec spec
        [ -n "$spec" ] || fail "пустая спецификация"
        tmp=/tmp/splify2-spec.$$
        printf '%s' "$spec" > "$tmp"
        # Компилятор — единственный судья: он же будет это применять. Проверка до
        # записи означает, что на диске не окажется спеки, которую движок отвергнет
        # при следующей загрузке.
        if ! err="$("$STEER" apply --dry-run --spec "$tmp" 2>&1 >/dev/null)"; then
            rm -f "$tmp"
            fail "${err:-движок отверг спецификацию}"
        fi
        # Сравниваем ДО подмены: после неё старого отпечатка уже не узнать.
        before="$(vless_fingerprint "$SPEC")"
        after="$(vless_fingerprint "$tmp")"
        mkdir -p "$(dirname "$SPEC")"
        mv "$tmp" "$SPEC"
        [ "$before" = "$after" ] || : > "$VLESS_DIRTY"
        json_init; json_add_boolean ok 1; json_dump
        ;;

    apply)
        # Зона для устройств vless — ДО apply: иначе первый же прогон объявит, что
        # устройство никому не известно, и будет прав.
        zone_msg="$(ensure_vless_zone "$("$STEER" outputs --kind vless --spec "$SPEC" 2>/dev/null | tr '\n' ' ')" 2>&1)"
        out="$("$STEER" apply --spec "$SPEC" 2>&1)"; rc=$?
        [ -n "$zone_msg" ] && out="$zone_msg
$out"

        # Клиент VLESS читает спеку и подписку ОДИН РАЗ при старте, поэтому смена узла или
        # подписки без перезапуска не значит ничего: в интерфейсе выбрано новое, в туннеле
        # работает старое, и понять это невозможно. Перезапускаем — но только когда
        # изменилось именно это, иначе правка любого списка роняла бы соединения через
        # туннель и меняла выходной адрес.
        if [ -f "$VLESS_DIRTY" ]; then
            for o in $("$STEER" outputs --kind vless --spec "$SPEC" 2>/dev/null); do
                # Через ubus, а не procd_send_signal: тот живёт в /lib/functions/procd.sh,
                # которого в rpcd-скрипте нет. Сигнал именно ЭТОМУ экземпляру — резолвер и
                # сторож перезапускать незачем, а '*' однажды уже убивал туннель при каждом
                # сохранении.
                ubus call service signal \
                    "{\"name\":\"steer\",\"instance\":\"vless_$o\",\"signal\":15}" 2>/dev/null
                out="$out
splify2: туннель $o перезапущен — сменился узел или подписка"
            done
            rm -f "$VLESS_DIRTY"
        fi
        # Резолвер обязан перечитать спеку: список файлов у доменного канала он берёт
        # при старте, поэтому после apply он ещё матчит прежние домены. Без этого
        # выбранный в интерфейсе список молча не работает — правила новые, а резолвер
        # старый. Экземпляр перезапускается без снятия правил, маршрутизация не мигает.
        [ "$rc" -eq 0 ] && /etc/init.d/steer reload_dnsd >/dev/null 2>&1
        # Вывод движка отдаётся целиком, включая предупреждения: он знает то, чего
        # интерфейс знать не может — например, что у туннеля нет NAT и трафик в него
        # уедет без возврата.
        json_init
        json_add_boolean ok $([ $rc -eq 0 ] && echo 1 || echo 0)
        json_add_string output "$out"
        json_dump
        ;;

    explain)
        read -r input
        json_load "$input" 2>/dev/null || fail "неразбираемый запрос"
        json_get_var address address
        [ -n "$address" ] || fail "не указан адрес"
        json_init
        json_add_string text "$("$STEER" explain "$address" --spec "$SPEC" 2>&1)"
        json_dump
        ;;

    lists)
        # Манифест отдаётся как есть — превращать его в форму интерфейса здесь значило
        # бы держать разбор в shell, где он дороже и хуже проверяем.
        if [ ! -s "$MANIFEST" ]; then
            mkdir -p "$(dirname "$MANIFEST")"
            download "$(manifest_url)" "$MANIFEST" || fail "манифест не скачался"
        fi
        cat "$MANIFEST"
        ;;

    list_fetch)
        read -r input
        json_load "$input" 2>/dev/null || fail "неразбираемый запрос"
        json_get_var id id
        [ -n "$id" ] || fail "не указан список"
        [ -s "$MANIFEST" ] || fail "манифест не загружен"
        json_get_var kind kind
        base="$(jsonfilter -i "$MANIFEST" -e '@.base_url')"
        file="$(manifest_file "$id" "$kind")"
        [ -n "$file" ] || fail "списка $id нет в манифесте"
        [ -n "$base" ] || fail "в манифесте нет base_url"
        dest="$(local_path "$file")"
        mkdir -p "$(dirname "$dest")"
        download "$base/$file" "$dest" || fail "список не скачался"
        json_init
        json_add_boolean ok 1
        json_add_int count "$(grep -c . "$dest")"
        json_add_string path "$dest"
        json_dump
        ;;

    list_remove)
        read -r input
        json_load "$input" 2>/dev/null || fail "неразбираемый запрос"
        json_get_var id id
        json_get_var kind kind
        [ -n "$id" ] || fail "не указан список"
        file="$(manifest_file "$id" "$kind")"
        [ -n "$file" ] || fail "списка $id нет в манифесте"
        dest="$(local_path "$file")"
        # Канал, указывающий на файл, после удаления не скомпилируется: движок читает
        # список при сборке правил и падает на отсутствующем. Поэтому удаление
        # ОТКАЗЫВАЕТСЯ, пока список кем-то используется, вместо того чтобы оставить
        # спеку, которая перестанет применяться при следующей перезагрузке.
        #
        # Ищем ПОЛНЫЙ путь, а не имя файла: `hodca.lst` встречается и в адресном канале, и
        # внутри `domains/hodca.lst`, и поиск по имени запрещал бы удаление одного из-за
        # другого.
        if [ -s "$SPEC" ] && grep -q "$dest" "$SPEC"; then
            fail "список используется каналом — сначала снимите галочку"
        fi
        rm -f "$dest"
        json_init; json_add_boolean ok 1; json_dump
        ;;

    local_lists)
        # Что уже лежит на диске. Без этого интерфейс не может отличить скачанный
        # список от невыбранного: кнопка "Загрузить" висела и над готовым, а выбрать
        # можно было то, чего на роутере нет.
        json_init
        json_add_object files
        # Ключ — путь ОТНОСИТЕЛЬНО каталога списков, а не имя файла: доменные лежат в
        # подкаталоге, и по имени `hodca.lst` невозможно отличить адресный от доменного.
        # Тот же ключ строит интерфейс из поля `file` манифеста.
        for f in $(find "$LISTS" -name '*.lst' -type f 2>/dev/null); do
            [ -f "$f" ] || continue
            json_add_object "$(echo "${f#$LISTS/}")"
            json_add_int count "$(grep -c . "$f")"
            json_add_int mtime "$(date -r "$f" +%s 2>/dev/null || echo 0)"
            json_close_object
        done
        json_close_object
        json_dump
        ;;

    devices)
        # Кандидаты в выход interface: только туннельные устройства.
        #
        # Отбор по /sys/class/net/*/type, а не по имени. Признак — ARPHRD_NONE (65534):
        # он у wireguard, amneziawg и tun, и его нет ни у мостов, ни у физических портов,
        # ни у wifi. 768 — ARPHRD_TUNNEL (ipip, gre), тоже туннель.
        #
        # Раньше отбор шёл по имени и отсекал eth*, но на современном OpenWrt порты
        # называются lan2, lan3, wan — и они попадали в список. Выход в физический порт
        # молча ничего не маршрутизирует: конфигурация выглядит настроенной, трафик
        # пропадает. Проверено на роутере — предлагались wan и три lan-порта.
        json_init
        json_add_array devices
        for d in /sys/class/net/*; do
            n="$(basename "$d")"
            [ -d "$d" ] || continue
            case "$(cat "$d/type" 2>/dev/null)" in
                65534|768) ;;
                *) continue ;;
            esac
            # Физическое устройство туннелем не бывает: у него есть ссылка device.
            [ -e "$d/device" ] && continue
            json_add_object ""
            json_add_string name "$n"
            json_add_boolean up "$([ "$(cat "$d/operstate" 2>/dev/null)" = down ] && echo 0 || echo 1)"
            json_add_string kind "$(cat "$d/uevent" 2>/dev/null | sed -n 's/^DEVTYPE=//p' | head -1)"
            json_close_object
        done
        json_close_array
        json_dump
        ;;

    engine)
        # Что за движок стоит и умеет ли он VLESS.
        #
        # Спрашивается у самого движка, а не по имени пакета: пакет мог быть поставлен
        # руками, переименован или собран из исходников. Признак — отвечает ли `vless`
        # отказом «нужен steer-extended». Без этой проверки интерфейс предлагал бы выход
        # kind=vless на базовой сборке, и человек получал бы отказ уже при сохранении,
        # не понимая, чего от него хотят.
        # Сначала — есть ли движок вообще. Без этой проверки отсутствие steer выглядело бы
        # как «VLESS поддержан»: сообщение «команда не найдена» тоже не содержит слова
        # steer-extended, и признак по отсутствию сработал бы наоборот.
        if [ ! -x "$STEER" ]; then
            json_init
            json_add_boolean present 0
            json_add_boolean vless 0
            json_dump
            exit 0
        fi
        vless=1
        out="$("$STEER" vless '' 2>&1)"
        case "$out" in *steer-extended*) vless=0 ;; esac
        json_init
        json_add_boolean present 1
        json_add_boolean vless "$vless"
        json_add_string arch "$(pkg_arch)"
        json_add_string version "$(apk list -I 2>/dev/null | sed -n 's/^steer\(-extended\)\{0,1\}-\([0-9][^ ]*\)-r.*/\2/p' | head -1)"
        json_dump
        ;;

    steer_versions)
        # Какие версии движка можно поставить.
        #
        # Спрашиваем у GitHub, а не держим список: зашитая версия означает, что интерфейс
        # ставит прошлое, и узнать об этом можно только заметив, что чего-то не хватает.
        # Отдаём последние десять — больше человеку не нужно, а старые релизы всё равно
        # остаются доступными по прямой ссылке.
        json_init
        json_add_string arch "$(pkg_arch)"
        json_add_array versions
        wget -qO- --timeout=20 "https://api.github.com/repos/xyzmean/steer/releases?per_page=10" 2>/dev/null |
            sed -n 's/.*"tag_name": *"v\{0,1\}\([^"]*\)".*/\1/p' |
            while read -r v; do
                [ -n "$v" ] && json_add_string "" "$v"
            done
        json_close_array
        json_dump
        ;;

    steer_install)
        # Скачать и поставить движок выбранной версии и варианта.
        #
        # Ставит именно ЭТО, а не «что-нибудь»: вариант (базовый или расширенный) — выбор
        # человека, зависящий от того, поднимает ли туннель сам движок, и угадывать за него
        # значит либо положить лишнее, либо не положить нужное и получить «выход vless не
        # работает» без объяснения.
        ver="$(jsonfilter -s "$2" -e '@.version' 2>/dev/null)"
        ext="$(jsonfilter -s "$2" -e '@.extended' 2>/dev/null)"
        arch="$(pkg_arch)"
        json_init
        case "$ver" in
            ''|*[!0-9.]*) json_add_boolean ok 0; json_add_string error "версия не в виде X.Y.Z"; json_dump; exit 0 ;;
        esac
        [ -n "$arch" ] || { json_add_boolean ok 0; json_add_string error "не определилась архитектура"; json_dump; exit 0; }

        case "$ext" in 1|true) name="steer-extended-${ver}-1_${arch}.apk" ;; *) name="steer-${ver}-1_${arch}.apk" ;; esac
        url="https://github.com/xyzmean/steer/releases/download/v${ver}/${name}"
        tmp="/tmp/${name}"
        rm -f "$tmp"
        if ! wget -qO "$tmp" --timeout=60 "$url" 2>/dev/null; then
            rm -f "$tmp"
            json_add_boolean ok 0
            json_add_string error "не скачалось: $name (нет такой версии для $arch?)"
            json_dump; exit 0
        fi
        # --force-overwrite: расширенный и базовый пакеты владеют одним /usr/sbin/steer,
        # и без этого замена одного на другой упирается в «файл принадлежит другому пакету».
        out="$(apk add --allow-untrusted --force-overwrite "$tmp" 2>&1)"
        rc=$?
        rm -f "$tmp"
        if [ "$rc" != 0 ]; then
            json_add_boolean ok 0
            json_add_string error "$out"
            json_dump; exit 0
        fi
        /etc/init.d/steer enable >/dev/null 2>&1 || true
        json_add_boolean ok 1
        json_add_string installed "$name"
        json_dump
        ;;

    sub_set)
        # Две формы одного и того же: ссылка на подписку и сами ссылки vless://.
        #
        # Движок различия не знает вовсе — он читает файл, где по строке на узел, и сам
        # разбирает base64, если это base64 (см. sub.c). Подписка это ровно такой файл,
        # который кто-то другой держит на сервере. Значит «вставить одну vless://» — не
        # новая возможность движка, а отсутствовавшая строчка ЗДЕСЬ: прежний код отвечал
        # «ссылка должна начинаться с http://», то есть человек с одним сервером от
        # знакомого не мог сделать вообще ничего.
        #
        # Ссылок может быть несколько — по одной на строку или через пробел. Пишем как
        # есть: разбирать их здесь значило бы держать вторую реализацию разбора vless://
        # в shell, а у движка она уже есть и она же будет применена.
        read -r input
        json_load "$input" 2>/dev/null || fail "неразбираемый запрос"
        json_get_var url url
        [ -n "$url" ] || fail "не указана ссылка"
        mkdir -p "$(dirname "$SUB")"
        case "$url" in
            https://*|http://*)
                download "$url" "$SUB" || fail "подписка не скачалась"
                kind=url
                ;;
            vless://*)
                # Пробелы между ссылками превращаем в переводы строк: из однострочного
                # поля ввода многострочная вставка приезжает склеенной пробелами.
                printf '%s\n' "$url" | tr ' \t' '\n\n' | grep '^vless://' > "$SUB.tmp" \
                    || fail "в тексте нет ссылок vless://"
                [ -s "$SUB.tmp" ] || { rm -f "$SUB.tmp"; fail "в тексте нет ссылок vless://"; }
                mv "$SUB.tmp" "$SUB"
                kind=links
                ;;
            *) fail "нужна ссылка на подписку (http:// или https://) либо ссылка vless://" ;;
        esac
        # Новая подписка — новые узлы, значит клиента надо перечитать. Иначе туннель
        # продолжает работать по узлу, которого в подписке может уже не быть.
        : > "$VLESS_DIRTY"
        # Ссылка сохраняется, чтобы её можно было обновить одной кнопкой и показать
        # человеку, откуда взялись узлы. В uci, а не в спеке: спека — вход движка, и
        # URL ему не нужен ни для чего.
        #
        # Файл конфигурации создаётся здесь: пакет его не кладёт, а `uci set` в
        # несуществующий файл молча ничего не делает — ссылка «сохранялась» и пропадала,
        # причём sub_set отвечал ok. Тихая потеря настройки хуже отказа.
        #
        # Для vless:// сохраняется ВИД, а не текст: показывать человеку обратно ссылку с
        # его же ключом незачем, а обновлять её нечем — обновляют подписку, не ссылку.
        [ -f /etc/config/splify2 ] || : > /etc/config/splify2
        uci -q get splify2.main >/dev/null 2>&1 || uci -q set splify2.main=splify2
        [ "$kind" = url ] && uci -q set splify2.main.sub_url="$url" || uci -q delete splify2.main.sub_url
        uci -q set splify2.main.sub_kind="$kind"
        uci -q commit splify2
        json_init
        json_add_boolean ok 1
        json_add_string kind "$kind"
        json_add_string path "$SUB"
        json_add_int bytes "$(wc -c < "$SUB" 2>/dev/null || echo 0)"
        json_dump
        ;;

    sub_info)
        json_init
        json_add_string url "$(uci -q get splify2.main.sub_url)"
        # Вид источника: url — подписка, которую можно обновить; links — вставленные
        # руками ссылки, обновлять которые нечем. Интерфейсу это нужно, чтобы не
        # предлагать «Обновить» там, где обновление ничего не значит.
        kind="$(uci -q get splify2.main.sub_kind)"
        [ -n "$kind" ] || { [ -n "$(uci -q get splify2.main.sub_url)" ] && kind=url || kind=none; }
        json_add_string kind "$kind"
        json_add_string path "$SUB"
        if [ -s "$SUB" ]; then
            json_add_boolean present 1
            json_add_int bytes "$(wc -c < "$SUB")"
            json_add_int mtime "$(date -r "$SUB" +%s 2>/dev/null || echo 0)"
        else
            json_add_boolean present 0
        fi
        json_dump
        ;;

    dev_stats)
        # Счётчики САМИХ устройств, а не правил.
        #
        # Понадобилось потому, что счётчик канала в nft отвечает не на тот вопрос, который
        # человек задаёт. Он стоит на правиле, ставящем метку, а метка ставится на пути
        # «из локальной сети наружу»: обратный поток приходит с туннельного устройства и
        # под `ip saddr <локальная сеть>` не подпадает. На живом роутере это выглядело как
        # 4,3 МБ при скачанных 223 МБ — то есть 61 байт на пакет, одни подтверждения.
        #
        # rx у туннельного устройства — это то, что движок ОТДАЛ клиентам, то есть
        # скачанное; tx — то, что он у них забрал. Для wireguard и amneziawg смысл тот же,
        # считает ядро.
        json_init
        json_add_object devices
        for d in /sys/class/net/*/statistics; do
            n="${d%/statistics}"; n="${n##*/}"
            [ "$n" = lo ] && continue
            json_add_object "$n"
            json_add_string rx "$(cat "$d/rx_bytes" 2>/dev/null || echo 0)"
            json_add_string tx "$(cat "$d/tx_bytes" 2>/dev/null || echo 0)"
            json_add_string rx_packets "$(cat "$d/rx_packets" 2>/dev/null || echo 0)"
            json_add_string tx_packets "$(cat "$d/tx_packets" 2>/dev/null || echo 0)"
            json_close_object
        done
        json_close_object
        json_dump
        ;;

    vless_nodes)
        read -r input
        json_load "$input" 2>/dev/null || fail "неразбираемый запрос"
        json_get_var output output
        [ -n "$output" ] || fail "не указан выход"
        # Движок печатает JSON сам — отдаём дословно. Разбирать его здесь значило бы
        # держать вторую модель узла в shell, а имена узлов приходят из подписки и
        # содержат что угодно, включая кавычки.
        out="$("$STEER" vless-nodes "$output" --spec "$SPEC" 2>&1)"
        case "$out" in '{'*) printf '%s\n' "$out" ;; *) fail "${out:-движок не ответил}" ;; esac
        ;;

    vless_probe)
        read -r input
        json_load "$input" 2>/dev/null || fail "неразбираемый запрос"
        json_get_var output output
        json_get_var node node
        [ -n "$output" ] || fail "не указан выход"
        # По одному узлу за вызов: проверка упирается в таймаут, и «проверить все» на
        # подписке из двадцати шести узлов заняло бы дольше, чем живёт вызов ubus.
        # Интерфейс спрашивает по одному и заполняет таблицу постепенно.
        [ -n "$node" ] || node=-1
        out="$("$STEER" vless-probe "$output" --node "$node" --timeout 6 --spec "$SPEC" 2>&1)"
        case "$out" in '{'*) printf '%s\n' "$out" ;; *) fail "${out:-движок не ответил}" ;; esac
        ;;

    *) fail "неизвестный метод" ;;
    esac
    ;;
esac
