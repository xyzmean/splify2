#!/bin/sh
# ubus-объект splify2 — тонкая обёртка над движком.
#
# Здесь сознательно нет собственной модели каналов. Движок уже умеет отвечать на все
# вопросы про своё состояние, и вторая модель означала бы второе место, которое надо
# держать в согласии с контрактом. Поэтому status/explain отдаются дословно, а spec
# только читается и записывается — с обязательной проверкой компилятором перед тем,
# как файл встанет на место.

# КРУГ ОПРОСА УХОДИТ ОТСЮДА ПЕРВОЙ ЖЕ КОМАНДОЙ, и это не украшение.
#
# busybox ash разбирает скрипт ЛЕНИВО, команду за командой. Замер на стенде (mipsel 24kc,
# 880 МГц): `exec` в первой строке 250-килобайтного файла стоит 8 мс, а дойти до конца того
# же файла — 128 мс. У этого объекта разбор тела занимает 84 мс, преамбула ещё 24 мс: 126 мс
# постоянной платы за КАЖДЫЙ вызов при том, что сам ответ считается 30-90 мс. Страница
# опрашивала пять методов раз в пять секунд, то есть 630 мс из 1220 уходило на пятикратный
# разбор одного и того же файла.
#
# Поэтому самые частые и самые дешёвые вызовы обслуживаются ДО того, как разобрано что-либо
# ещё: маленький файл рядом (см. его шапку) разбирается за единицы миллисекунд. Условие стоит
# выше всего остального намеренно — любая команда над ним возвращает эту плату обратно.
#
# Здесь только те, у кого своей работы почти нет: круг опроса и чтение спеки. Метод, который
# сам считает сотню миллисекунд, переносить сюда незачем — на его фоне платы не видно, а файл
# превратился бы во второй склад методов.
case "${1:-}:${2:-}" in
    call:live)        . "${FAST_SH:-/usr/lib/splify2/fast.sh}"; fast_live;        exit 0 ;;
    call:spec_get)    . "${FAST_SH:-/usr/lib/splify2/fast.sh}"; fast_spec_get;    exit 0 ;;
    call:applied_get) . "${FAST_SH:-/usr/lib/splify2/fast.sh}"; fast_applied_get; exit 0 ;;
esac

# JSHN_SH — единственный шов, заведённый исключительно ради стенда. Остальные пути ниже
# переопределяемы по той же причине, но у них есть и второе применение (второй роутер,
# нестандартный префикс); у этого — нет. rpcd запускает объект с чистым окружением, так
# что на роутере ветка `:-` не выбирается никогда. Без шва tests/rpcdmatch.sh не может
# запустить настоящий скрипт: libubox на машине разработчика нет, а подменить путь,
# зашитый в `.`, нечем.
. "${JSHN_SH:-/usr/share/libubox/jshn.sh}"

STEER="${STEER:-/usr/sbin/steer}"
SPEC="${SPEC:-/etc/steer/spec.json}"
# Снимок спеки в момент apply. По нему интерфейс считает «сколько ещё не применено»:
# сравнение с ним переживает перезагрузку страницы, чего память браузера не может.
APPLIED="${APPLIED:-/etc/steer/spec.applied.json}"
LISTS="${LISTS:-/etc/steer/lists}"
# Подписка VLESS. Один файл на роутер, а не по файлу на выход: узлы в подписке уже
# перечислены списком, и выход выбирает из них номером. Два выхода на одну подписку — это
# два узла одного провайдера, и держать для этого две копии файла было бы странно.
SUB="${SUB:-/etc/steer/sub.txt}"
# Остаток трафика подписки, как его назвала панель. Рядом с подпиской, а не в uci: числа
# меняются при каждом обращении к панели, а `uci commit` — это запись в overlay-раздел
# роутера, и держать там счётчик значило бы тереть флеш ради показа на обзоре.
#
# Имя выведено из имени подписки, чтобы при переопределённом SUB оба файла остались рядом.
# Этот же путь перечислен в keep.d движка (steer, /lib/upgrade/keep.d/steer): без него
# обновление прошивки «с сохранением настроек» уносило бы остаток, и обзор показывал бы
# «панель не сообщает остаток» на подписке, которая его сообщает.
SUB_INFO="${SUB_INFO:-${SUB%.txt}.userinfo}"
# Состояние туннелей xsteer: движок пишет по файлу на туннель, «по файлу», а не «по запросу
# процесса», потому что спросить процесс — это запустить процесс, а состояние опрашивают раз в
# пять секунд (см. steer/docs/xsteer.md, раздел про файл состояния). Каталог тот же, что у
# --state-dir движка.
XS_STATE_DIR="${XS_STATE_DIR:-/var/lib/steer}"
# Готовая конфигурация туннеля, собранная обработчиком протокола из uci. Единственный источник,
# из которого печатается ссылка: собирать её здесь во второй раз значило бы завести два места,
# которые превращают uci в настройку, и однажды они разошлись бы.
XS_RUN="${XS_RUN:-/var/run/xsteer}"
# Остальные подписки. Их может быть несколько: у человека бывает две панели, и локации из
# обеих он складывает в один пул. Первая (та, что уже стоит на роутерах) осталась на прежнем
# месте — /etc/steer/sub.txt, — потому что на этот путь ссылаются выходы в спеках, а сдвинуть
# их значило бы сломать маршрутизацию ради переезда файла.
SUBS_DIR="${SUBS_DIR:-/etc/steer/subs}"

# Имя подписки в виде, годном и для имени файла, и для имени секции uci: латиница, цифры и
# подчёркивание. Дефис уходит тоже — uci имён с ним не принимает.
sub_slug() {
    printf '%s' "${1:-}" | tr -c 'A-Za-z0-9_' '_' | cut -c1-24 | sed 's/_*$//'
}

# Переставить SUB и SUB_INFO на нужную подписку. После вызова ВСЕ помощники (sub_fetch,
# sub_quota_ask, sub_userinfo_emit) работают с ней и ни о чём не знают — в этом и смысл:
# «какая подписка выбрана» решается в одном месте, а движку пути называются явно.
sub_use() {
    SUB_NAME="$(sub_slug "${1:-main}")"
    [ -n "$SUB_NAME" ] || SUB_NAME=main
    if [ "$SUB_NAME" = main ]; then
        SUB="${SUB_MAIN:-/etc/steer/sub.txt}"
    else
        SUB="$SUBS_DIR/$SUB_NAME.txt"
    fi
    SUB_INFO="${SUB%.txt}.userinfo"
}
SUB_MAIN="$SUB"
SUB_NAME=main

# Где в uci лежит ссылка подписки. У первой — там же, где лежала всегда: перенос ключа
# означал бы, что после обновления пакета роутер забыл свою подписку.
sub_uci_key() {  # NAME FIELD(url|kind|title)
    if [ "$1" = main ]; then
        case "$2" in
            url)  printf 'splify2.main.sub_url' ;;
            kind) printf 'splify2.main.sub_kind' ;;
            *)    printf 'splify2.main.sub_title' ;;
        esac
    else
        printf 'splify2.sub_%s.%s' "$1" "$2"
    fi
}

sub_get() {  # NAME FIELD
    uci -q get "$(sub_uci_key "$1" "$2")"
}

sub_put() {  # NAME FIELD VALUE
    uci_file || return 1
    if [ "$1" = main ]; then
        uci -q get splify2.main >/dev/null 2>&1 || uci -q set splify2.main=splify2
    else
        uci -q get "splify2.sub_$1" >/dev/null 2>&1 || uci -q set "splify2.sub_$1=subscription"
    fi
    if [ -n "$3" ]; then uci -q set "$(sub_uci_key "$1" "$2")=$3"
    else uci -q delete "$(sub_uci_key "$1" "$2")" 2>/dev/null
    fi
}

# Вид источника: url — подписка, которую есть чем обновить, links — вставленные руками
# ссылки, none — источника нет.
sub_kind_of() {  # NAME
    _k="$(sub_get "$1" kind)"
    [ -n "$_k" ] || { [ -n "$(sub_get "$1" url)" ] && _k=url || _k=none; }
    printf '%s' "$_k"
}

# Все подписки роутера: первая и заведённые после неё. Перечень собирается из uci, а файлы
# лишь дополняют его — подписка, чей файл скачан, но ключ потерян, всё равно должна быть
# видна, иначе её нельзя ни обновить, ни удалить.
sub_names() {
    { [ -s "${SUB_MAIN:-/etc/steer/sub.txt}" ] || [ -n "$(uci -q get splify2.main.sub_url)" ] && echo main
      uci -q show splify2 2>/dev/null | sed -n "s/^splify2\.sub_\([A-Za-z0-9_]*\)=subscription$/\1/p"
      [ -d "$SUBS_DIR" ] && for _f in "$SUBS_DIR"/*.txt; do
          [ -e "$_f" ] || continue
          _b="${_f##*/}"; printf '%s\n' "${_b%.txt}"
      done
    } 2>/dev/null | awk 'NF && !seen[$0]++'
}

# Занята ли подписка выходом. Удалять файл, на который ссылается выход, нельзя молча: движок
# читает его при подъёме, и правило осталось бы вести в туннель без единого узла.
sub_used_by() {  # PATH -> ЧИСЛО
    # Одно число и всегда. Прежняя запись (`grep -c ... || echo 0`) печатала ДВА нуля:
    # grep без совпадений и печатает 0, и выходит с ненулевым кодом, то есть срабатывала и
    # ветка `||`. Дальше это уезжало в json_add_int и роняло весь ответ — метод отдавал
    # пустоту, а интерфейс показывал «подписок нет».
    _u=0
    if [ -s "$SPEC" ]; then
        _u="$(jsonfilter -i "$SPEC" -e '@.outputs[*].sub_file' 2>/dev/null |
              grep -Fx -c -- "$1" 2>/dev/null)"
    fi
    case "${_u:-}" in ''|*[!0-9]*) _u=0 ;; esac
    printf '%s' "$_u"
}
MANIFEST="${MANIFEST:-/etc/splify2/manifest.json}"
# Где выходит трафик выхода: страна и адрес, как их видит внешняя сторона. Хранится по файлу
# на выход и переживает перезагрузку страницы — интерфейс рисует запомненное сразу, не дожидаясь
# ответа из сети.
#
# В /var/lib, а не в /etc: это измерение, а не настройка, и переписывается оно чаще, чем стоит
# трогать overlay-раздел. Переживать перезагрузку РОУТЕРА ему незачем — узел мог смениться.
GEO_DIR="${GEO_DIR:-/var/lib/splify2}"
# Кто отвечает на вопрос «какой у меня адрес и в какой он стране». cdn-cgi/trace выбран за
# три вещи: отвечает любой узел Cloudflare (то есть ближайший), не требует ни ключа, ни
# учётной записи, и отдаёт две строки простого текста вместо JSON — разбирать его в shell
# нечем и не нужно. Адрес переопределяется: `uci set splify2.main.geo_url=...`.
GEO_URL_DEFAULT="https://www.cloudflare.com/cdn-cgi/trace"
# Сколько считать измерение свежим. Узел подписки движок меняет при отказе, но не ежеминутно,
# а каждый опрос — это обращение наружу через туннель со своим таймаутом.
GEO_TTL="${GEO_TTL:-900}"
# Сервис и файл описания системы — абсолютные пути, поэтому подменить их заглушкой в
# PATH нельзя, а стенду нужны оба: через первый идёт вся установка движка, по второму
# выбирается архитектура пакета.
INITD="${INITD:-/etc/init.d/steer}"
RPCD_INITD="${RPCD_INITD:-/etc/init.d/rpcd}"
OPENWRT_RELEASE="${OPENWRT_RELEASE:-/etc/openwrt_release}"
# Тот же источник, что и у файлов списков: base_url внутри манифеста указывает на
# raw в main, и брать сам манифест из релиза значило бы, что он описывает одни файлы,
# а скачиваются другие. Расхождение проявилось бы как "список есть в интерфейсе, но
# качается пустым" — то есть в самом непонятном для человека виде.
#
# Цена: raw кеширует минут на пять, поэтому свежий прогон CI видно не мгновенно. Для
# списков, которые обновляются раз в сутки, это дешевле рассинхронизации. Переопределяется
# через uci: splify2.main.manifest_url.
MANIFEST_URL_DEFAULT="https://raw.githubusercontent.com/xyzmean/ru-bypass-ipsets/refs/heads/main/lists/categories.json"

fail() { json_init; json_add_boolean ok 0; json_add_string error "$1"; json_dump; exit 0; }

# Найти файл списка в манифесте по id И ВИДУ.
#
# Вид обязателен, и это не перестраховка: `categories` и `domain_lists` — разные
# пространства имён, и один id законно есть в обоих. У издателя так с `hodca` и `news`:
# адресный `hodca.lst` (5444 подсети) и доменный `domains/hodca.lst` (250 имён).
#
# Прежняя версия искала сначала в доменных, поэтому на запрос АДРЕСНОЙ категории скачивала
# доменный файл. Дальше канал читал домены как подсети, nft отвергал набор целиком — и
# вставала вся маршрутизация. Симптом «включил Хостинги и CDN, всё умерло» — отсюда.
manifest_file() {  # ID ВИД
    case "$2" in
        domains)  jsonfilter -i "$MANIFEST" -e "@.domain_lists[@.id='$1'].file" 2>/dev/null ;;
        prefixes) jsonfilter -i "$MANIFEST" -e "@.categories[@.id='$1'].file" 2>/dev/null ;;
        *)
            # Вид не указан — старый вызов. Тогда порядок обратный прежнему: адресные
            # первыми, потому что доменные лежат в своём подкаталоге и путь у них
            # различим, а вот адресная категория при промахе давала именно ту поломку.
            f="$(jsonfilter -i "$MANIFEST" -e "@.categories[@.id='$1'].file" 2>/dev/null)"
            [ -n "$f" ] || f="$(jsonfilter -i "$MANIFEST" -e "@.domain_lists[@.id='$1'].file" 2>/dev/null)"
            printf '%s' "$f"
            ;;
    esac
}

# Локальный путь списка: ПОВТОРЯЕТ путь у издателя, а не берёт от него имя файла.
#
# `basename` схлопывал `hodca.lst` и `domains/hodca.lst` в один локальный файл, и они
# затирали друг друга. То же правило продублировано в интерфейсе (pathFor) — разойдясь,
# они дадут «список скачан, а канал его не находит».
#
# ПУТЬ ПРИХОДИТ ИЗ ИНТЕРНЕТА, и проверяется он здесь, в единственном месте, где
# собирается. Поле `file` берётся из манифеста издателя (адрес которого вдобавок
# переопределяется через uci), а срезание ведущих слэшей от `..` не спасает: `file` вида
# `../../../etc/crontabs/root` давал запись файла ОТ ROOT куда угодно, содержимым с того
# же издателя, — крон, rc.local, сам этот скрипт. Тем же путём list_remove удалял любой
# файл: проверка «занят каналом» сравнивала уже подменённый путь.
#
# Для СВОИХ списков эта мысль додумана давно (см. list_put: «без этого ../../etc/passwd
# было бы законным именем»), а для чужих — нет, хотя чужой источник доверия заслуживает
# меньше. Правило одно на оба случая: имя может состоять только из безопасных символов,
# и ни одна его часть не может быть «..».
# Возвращает НЕНУЛЕВОЙ код на негодном пути, а не зовёт fail сама, и это важно: её
# вызывают в подстановке `$( )`, то есть в подоболочке, где exit из fail завершил бы
# только подоболочку. Ответ об ошибке ушёл бы в переменную вместо клиента, а скрипт
# спокойно продолжил бы работу с этой строкой как с путём. Поэтому решение принимает
# вызывающий: `dest="$(local_path "$f")" || fail ...`.
local_path() {  # ПУТЬ_У_ИЗДАТЕЛЯ
    rel="$(echo "$1" | sed 's|^/*||')"
    case "$rel" in
        ''|.|..|*/../*|*/..|../*|*//*) return 1 ;;
        *[!A-Za-z0-9_./-]*)            return 1 ;;
    esac
    printf '%s/%s' "$LISTS" "$rel"
}

manifest_url() {
    u="$(uci -q get splify2.main.manifest_url)"
    [ -n "$u" ] && printf '%s' "$u" || printf '%s' "$MANIFEST_URL_DEFAULT"
}

# Единственный способ скачать: сначала во временный файл, потом переименовать. Иначе
# оборванная загрузка оставляет на месте рабочего списка обрубок, и канал начинает
# маршрутизировать половину.
# Скачивание живёт отдельным файлом: его же подключает splify2-update-lists, а обход
# закрытого издателя (splify2#15) обязан быть у обеих половин одинаковым — иначе каталог
# открывается, а обновление списков молчит. Путь швом, как и у jshn: на машине
# разработчика этого файла нет, стенд подставляет свой.
FETCH_TIMEOUT=${FETCH_TIMEOUT:-60}
. "${FETCH_SH:-/usr/lib/splify2/fetch.sh}"

# Обновлятор списков — тот же, что ходит по расписанию. Путь швом по той же причине, что и
# у fetch.sh: на машине разработчика его нет, стенд подставляет свой.
UPDATE_LISTS=${UPDATE_LISTS:-/usr/sbin/splify2-update-lists}

# Обход DPI и DNS over HTTPS — тоже отдельными файлами, и по тому же доводу, что fetch.sh:
# каталог стратегий читают трое (объект, ночное обновление, фоновая проверка), а настройку
# резолвера — объект и та же ночная работа. Копия в каждом означала бы, что «активная
# стратегия» в одном месте значит одно, а в другом другое, и разошлись бы они молча.
. "${ZAPRET_SH:-/usr/lib/splify2/zapret.sh}"
. "${DOH_SH:-/usr/lib/splify2/doh.sh}"
# Фоновая проверка стратегий — отдельный процесс, а не работа внутри вызова ubus: у вызова
# свой срок жизни (две минуты), а проверка идёт десятки минут, и человек должен иметь право
# закрыть окно. Путь швом по той же причине, что у остальных.
ZAPRET_TEST=${ZAPRET_TEST:-/usr/sbin/splify2-zapret-test}

# ---- идентификатор устройства для панели подписки (HWID) ----------------------------
#
# Считает его ДВИЖОК (`steer sub-hwid`), а не этот файл. Почему так — в
# steer/src/ext/subfetch.c: идентификатор выводится из MAC-адреса шестнадцатеричным хешем, а
# в оболочке для этого приходилось звать внешние `sha256sum`/`md5sum` и обходить каталог
# устройств глобом. Движок и хеширует сам (mbedtls у него в руках), и порядок портов задаёт
# сортировкой, а не порядком обхода каталога — то есть отвечает на тот же вопрос, но без
# второй реализации и с проверкой стендом.
#
# Здесь остаётся один вызов и его кэш на время работы метода: sub_list зовёт идентификатор
# один раз на весь ответ, а sub_info и sub_set — по разу, и лишний запуск движка на каждое
# обращение был бы платой за неменяющееся число.
HWID_CACHED=""
hwid() {
    if [ -z "$HWID_CACHED" ]; then
        HWID_CACHED="$("$STEER" sub-hwid 2>/dev/null | jsonfilter -e '@.hwid' 2>/dev/null)"
        # Пустой ответ законен: «не из чего считать» — ни одного физического порта с
        # постоянным MAC. Признак «уже спрашивали» ставится отдельно, чтобы пустой ответ не
        # приводил к повторному запуску движка при каждом обращении.
        HWID_CACHED="${HWID_CACHED:--}"
    fi
    [ "$HWID_CACHED" = "-" ] && return 1
    printf '%s\n' "$HWID_CACHED"
}

# Тот же каталог, но для перечня СЕТЕЙ КЛИЕНТОВ (метод client_nets, splify2#16). Отдельным# Каталог устройств для перечня СЕТЕЙ КЛИЕНТОВ (метод client_nets, splify2#16). Швом, потому
# что стенд подставляет туда свои наборы устройств.
SYSNET="${SYSNET:-/sys/class/net}"

# И тот же каталог для перечня устройств ВЫХОДА (метод devices) — отдельным именем, а не
# общим с SYSNET: у каждого шва своя подделка, и один общий означал бы, что проверка одного
# пути ломает другой. Здесь подделываются туннельные устройства.
OUT_SYSNET="${OUT_SYSNET:-/sys/class/net}"

# Сеть по адресу с префиксом: 192.168.1.1/24 -> 192.168.1.0/24.
#
# Нужна для ПОДСКАЗКИ рядом с именем устройства в перечне сетей клиентов: сама
# маршрутизация адресов не спрашивает, движок сверяет `iifname`. Показывается сеть, а не
# адрес роутера, потому что человек узнаёт устройство по сети, в которой живут его
# компьютеры, а не по единственному адресу шлюза в ней.
#
# Всё, что не разбирается (не IPv4, мусор вместо длины), возвращается как есть: подставить
# выдуманную сеть хуже, чем показать строку, которую человек узнает.
cidr_net() {  # АДРЕС/ПРЕФИКС
    _cn_a="${1%%/*}"; _cn_p="${1#*/}"
    case "$_cn_p" in ''|*[!0-9]*) printf '%s' "$1"; return 0 ;; esac
    [ "$_cn_p" -le 32 ] || { printf '%s' "$1"; return 0; }
    case "$_cn_a" in
        *.*.*.*) ;;
        *) printf '%s' "$1"; return 0 ;;
    esac
    _cn_o1="${_cn_a%%.*}"; _cn_r="${_cn_a#*.}"
    _cn_o2="${_cn_r%%.*}"; _cn_r="${_cn_r#*.}"
    _cn_o3="${_cn_r%%.*}"; _cn_o4="${_cn_r#*.}"
    case "$_cn_o1$_cn_o2$_cn_o3$_cn_o4" in ''|*[!0-9]*) printf '%s' "$1"; return 0 ;; esac
    _cn_ip=$(( (_cn_o1 << 24) | (_cn_o2 << 16) | (_cn_o3 << 8) | _cn_o4 ))
    if [ "$_cn_p" -eq 0 ]; then _cn_m=0; else _cn_m=$(( 0xFFFFFFFF << (32 - _cn_p) )); fi
    _cn_ip=$(( _cn_ip & _cn_m & 0xFFFFFFFF ))
    printf '%u.%u.%u.%u/%u' "$(( (_cn_ip >> 24) & 255 ))" "$(( (_cn_ip >> 16) & 255 ))" \
        "$(( (_cn_ip >> 8) & 255 ))" "$(( _cn_ip & 255 ))" "$_cn_p"
}

# Остаток трафика в ответ. Ничего не запрашивает — только читает запомненное.
sub_userinfo_emit() {
    [ -s "$SUB_INFO" ] || return 1
    _up=""; _dn=""; _tot=""; _exp=""; _at=""; _at0=""; _used0=""
    while IFS='=' read -r _k _v; do
        case "$_k" in
            upload)   _up="$_v" ;;
            download) _dn="$_v" ;;
            total)    _tot="$_v" ;;
            expire)   _exp="$_v" ;;
            at)       _at="$_v" ;;
            at0)      _at0="$_v" ;;
            used0)    _used0="$_v" ;;
        esac
    done < "$SUB_INFO"
    json_add_object quota
    # Байты — СТРОКАМИ. 200 ГБ это 2·10^11, а json_add_int у jshn 32-битный: подписка на
    # 200 ГБ приехала бы обрезанным числом, и обзор показал бы остаток, которого нет. Тот же
    # довод, по которому строками отдаются счётчики dev_stats.
    json_add_string up "${_up:-}"
    json_add_string down "${_dn:-}"
    json_add_string total "${_tot:-}"
    # Срок и время опроса — unix-время, в int32 оно влезает до 2038 года.
    json_add_int expire "${_exp:-0}"
    json_add_int at "${_at:-0}"
    # Первое наблюдение периода: по нему и по нынешнему считается измеренный темп расхода.
    # Отдаётся вместе с числами, а не вычисляется здесь: делить и предсказывать — работа
    # интерфейса, а второе место, где то же число считается иначе, разойдётся с первым.
    json_add_int since "${_at0:-0}"
    json_add_string since_used "${_used0:-0}"
    json_close_object
    return 0
}

# Скачать подписку и разобрать, что ответила панель, — ОДНИМ вызовом движка.
#
# Всё, что раньше стояло здесь, переехало в steer sub-fetch: заголовки запроса с
# идентификатором устройства, разбор ответных заголовков, base64 названия подписки,
# арифметика остатка трафика, повтор за другим форматом. Причина — в шапке
# steer/src/ext/subfetch.c; коротко: каждый из этих шагов упирался в то, чего у оболочки нет,
# и потому держался второй реализацией того, что у движка уже было готово. Число пригодных
# узлов, по которому решается «не заглушка ли это», оболочка вообще узнавала регулярным
# выражением из JSON отдельного запуска движка — то есть решение принималось по пересказу
# нашего же ответа.
#
# Здесь остались учёт настройки (какая подписка, где её файлы, что в uci) и передача ответа
# движка наверх. Ответ разбирается jsonfilter-ом по полям, а не пересобирается: второй раз
# описать то же состояние — значит однажды описать его иначе.
SUB_ANSWER=""
sub_fetch() {  # URL
    SUB_ANSWER="$("$STEER" sub-fetch "$1" --out "$SUB" --info "$SUB_INFO" 2>/dev/null)"
    case "$SUB_ANSWER" in '{'*) ;; *) return 1 ;; esac
    [ "$(sub_answer ok)" = "true" ]
}

# Поле ответа движка. Пустая строка, если поля нет: у отказа нет ни названия, ни остатка, и
# отличать «поля нет» от «поле пустое» вызывающему здесь не нужно.
sub_answer() {  # ПОЛЕ
    [ -n "$SUB_ANSWER" ] || return 1
    printf '%s' "$SUB_ANSWER" | jsonfilter -e "@.$1" 2>/dev/null
}

# Спросить у панели ОДИН остаток трафика, не подменяя подписку. Тоже вызовом движка: та же
# проба заголовков, та же арифметика периода, тот же файл.
sub_quota_ask() {  # URL
    "$STEER" sub-quota "$1" --info "$SUB_INFO" >/dev/null 2>&1 || return 1
    # Числа теперь лежат в файле — сказать остаётся только, нашлось ли в нём что-нибудь.
    [ -s "$SUB_INFO" ]
}

# Доскачать списки, на которые ссылается спека, но которых нет на диске. Печатает
# предупреждения об НЕскачанном (по строке на файл), код возврата всегда 0: недоступность
# сервера издателя не должна отменять сохранение или применение целиком.
#
# ЗАЧЕМ ОБЩЕЙ ФУНКЦИЕЙ, а не в одной ветке. Движок умирает на отсутствующем файле, и делает
# это ДВАЖДЫ: при `apply --dry-run` в spec_set (проверка до записи) и при настоящем apply.
# Пока доскачивание стояло только в apply, выбор нового сервиса не сохранялся ВООБЩЕ:
# автосохранение вызывало spec_set, тот гонял dry-run, движок не находил файл и отвечал
# «/etc/steer/lists/cloudflare.lst: cannot read a channel's list», правка откатывалась, и
# человек видел ошибку там, где ничего не применял. Момент, когда файл обязан существовать, —
# любая проверка спеки движком, поэтому вызывать надо перед каждой.
fetch_missing_lists() {  # ПУТЬ_К_СПЕКЕ
    _spec="$1"
    [ -s "$MANIFEST" ] || return 0
    _base="$(jsonfilter -i "$MANIFEST" -e '@.base_url')"
    [ -n "$_base" ] || return 0
    for _f in $(jsonfilter -i "$_spec" \
        -e '@.channels[*].match.prefixes_files[*]' \
        -e '@.channels[*].match.domains_files[*]' 2>/dev/null | sort -u); do
        [ -s "$_f" ] && continue
        _rel="${_f#"$LISTS"/}"
        [ "$_rel" = "$_f" ] && continue     # файл вне каталога списков — не наш
        _dest="$(local_path "$_rel")" || continue
        mkdir -p "$(dirname "$_dest")"
        if download "$_base/$_rel" "$_dest"; then
            [ -n "$FETCH_NOTE" ] && echo "список $_rel: $FETCH_NOTE"
        else
            echo "список $_rel не скачался — канал, который на него ссылается, не поднимется${FETCH_NOTE:+ ($FETCH_NOTE)}"
        fi
    done
    return 0
}

# Измерить, где выходит трафик выхода, и запомнить. Ничего не печатает: зовётся и из
# фонового процесса, где печатать некуда, и из синхронной ветки метода, где ответ собирает
# сам метод. Код возврата: 0 — измерили и записали.
#
# Запрос уходит ЧЕРЕЗ УСТРОЙСТВО ВЫХОДА (`curl --interface`), поэтому способ один на все виды
# туннелей: у vless устройство создаёт сам движок, у остальных оно и так есть.
# Чем этот выход был, когда мы мерили. Номер устройства в системе: при смене узла или
# перечитывании подписки движок пересоздаёт TUN, и номер меняется. Ровно это и означает «мы
# теперь выходим в другом месте» — даже когда выбран «первый рабочий» и спека не менялась.
geo_ident() {  # ВЫХОД
    _gi_dev="$("$STEER" status --spec "$SPEC" 2>/dev/null |
        sed -n "s/.*\"$1\":{[^}]*\"device\":\"\([^\"]*\)\".*/\1/p" | head -1)"
    [ -n "$_gi_dev" ] || { printf 'none'; return; }
    printf '%s:%s' "$_gi_dev" "$(cat "/sys/class/net/$_gi_dev/ifindex" 2>/dev/null || echo 0)"
}

geo_refresh() {  # ВЫХОД
    _gr_dev="$("$STEER" status --spec "$SPEC" 2>/dev/null |
        sed -n "s/.*\"$1\":{[^}]*\"device\":\"\([^\"]*\)\".*/\1/p" | head -1)"
    [ -n "$_gr_dev" ] || return 1
    command -v curl >/dev/null 2>&1 || return 1
    _gr_url="$(uci -q get splify2.main.geo_url)"
    [ -n "$_gr_url" ] || _gr_url="$GEO_URL_DEFAULT"
    # ОДИН запрос на всё: адрес, страна и время ответа. Времени здесь взяться неоткуда,
    # кроме как отсюда, — и незачем: соединение через устройство выхода уже установлено,
    # а отдельная проверка отклика (outbound_probe) поднимает его ВТОРОЙ раз и через
    # движок. Замерено на роутере: такая проверка занимает девятнадцать секунд на выход,
    # то есть на четырёх выходах экран больше минуты стоит с надписью «меряем…».
    #
    # `time_total` — это весь путь: установка соединения, TLS и ответ. Оно и есть та
    # задержка, которую человек чувствует, открывая страницу через этот выход; ICMP до
    # узла к ней ближе не становится, а через TUN он и не ходит.
    _gr_out="$(curl -4 -fsS --interface "$_gr_dev" --connect-timeout 4 --max-time 8 \
        -w '\nsplify_ms=%{time_total}\n' "$_gr_url" 2>/dev/null)"
    _gr_ip="$(printf '%s\n' "$_gr_out" | sed -n 's/^ip=\(.*\)$/\1/p' | head -1)"
    _gr_cc="$(printf '%s\n' "$_gr_out" | sed -n 's/^loc=\([A-Za-z][A-Za-z]\)$/\1/p' | head -1)"
    # Секунды с дробью -> миллисекунды целым: считает awk, потому что shell дробей не знает.
    _gr_ms="$(printf '%s\n' "$_gr_out" | sed -n 's/^splify_ms=\(.*\)$/\1/p' | head -1 |
        awk '{ printf "%d", $1 * 1000 }' 2>/dev/null)"
    case "${_gr_ms:-}" in ''|*[!0-9]*) _gr_ms=0 ;; esac
    [ -n "$_gr_ip" ] || return 1
    mkdir -p "$GEO_DIR" 2>/dev/null
    # Время ответа дописано ПЯТЫМ полем, а не вставлено в середину: строки, записанные
    # прежней версией, читаются теми же четырьмя переменными, и пятая просто остаётся пустой.
    printf '%s %s %s %s %s\n' "$(date +%s)" "${_gr_cc:--}" "$_gr_ip" "$(geo_ident "$1")" \
        "$_gr_ms" > "$GEO_DIR/geo-$1" 2>/dev/null
}

# Достать JSON из вывода движка, к которому подмешаны его же человеческие строки.
#
# Движок пишет предупреждения в stderr («соединился, пропущено мёртвых адресов: 2 из 15»), а
# нам нужен и он — когда JSON не пришёл вовсе, только эта строка и объясняет, что случилось.
# Поэтому потоки сливаются, а JSON отсюда ВЫНИМАЕТСЯ, а не проверяется на первый символ.
#
# Проверка первого символа тут и подвела: строка предупреждения оказалась перед JSON, вызов
# посчитал ответ негодным и вернул всю мешанину как ошибку — на экране это выглядело красной
# полосой с сырым JSON внутри вместо «ответ 53 мс».
json_tail() {  # СЫРОЙ_ВЫВОД -> JSON или пусто
    printf '%s\n' "$1" | sed -n '/^{/,$p'
}

# ---- фикс Zapret Manager -------------------------------------------------------------
#
# ЗАЧЕМ. Zapret Manager ставится и обновляется с GitHub, аддоны берёт оттуда же, а у той
# аудитории, ради которой splify2 и существует, GitHub закрыт. Поэтому собственные обращения
# роутера к GitHub уводятся в туннель сами.
#
# ТОЛЬКО РОУТЕР. Устройств сети это не касается вовсе, и это не оговорка, а требование: у них
# свои средства обхода, и уводить их трафик за них никто не просил. Отсюда и способ — метка
# в цепочке `output`: туда попадает только то, что роутер отправил САМ. Пересылаемый трафик
# идёт через `forward` и этой цепочки не видит.
#
# ПОЧЕМУ НЕ ПРАВИЛО В СПЕКЕ. Так было в 1.2.3, и это оказалось неверно дважды: канал
# распространялся на клиентов и появлялся у человека в правилах, хотя тот его не заводил.
# Здесь же — своя таблица nftables рядом с таблицей движка: движок её не трогает, человек её
# не видит, а управление одно — переключатель в настройках.
ZM_LIST="${ZM_LIST:-$LISTS/zm-github.lst}"
ZM_TABLE="${ZM_TABLE:-splify2_zm}"
ZM_CHANNEL=zm_github

# Включён ли фикс. Умолчание — включён: он нужен именно тем, кто ещё ничего не настроил.
zm_fix_on() {
    case "$(uci -q get splify2.main.zm_fix 2>/dev/null)" in
        0|off|no|false) return 1 ;;
        *) return 0 ;;
    esac
}

# Метка и таблица выхода, через который уводить. Первый поднятый выход со своей меткой:
# другого выбора здесь нет и не нужно — фикс имеет смысл там, где напрямую не дойти.
zm_mark() {  # печатает МЕТКУ
    _zm_st="$("$STEER" status --spec "$SPEC" 2>/dev/null)"
    [ -n "$_zm_st" ] || return 1
    for _zm_o in $("$STEER" outputs --spec "$SPEC" 2>/dev/null); do
        [ "$_zm_o" = direct ] && continue
        case "$_zm_o" in *[!a-zA-Z0-9_-]*) continue ;; esac
        _zm_m="$(printf '%s' "$_zm_st" | jsonfilter -e "@.outputs.$_zm_o.mark" 2>/dev/null)"
        case "${_zm_m:-}" in 0x*) printf '%s' "$_zm_m"; return 0 ;; esac
    done
    return 1
}

# Убрать канал, который дописывала версия 1.2.3. Тогда фикс жил правилом в спеке — оно
# касалось клиентов и висело у человека в правилах; теперь его там быть не должно, и молча
# оставить его значило бы, что обновление не исправило ровно то, ради чего вышло.
zm_drop_channel() {
    jsonfilter -i "$SPEC" -e '@.channels[*].name' 2>/dev/null | grep -qx "$ZM_CHANNEL" || return 1
    # Ищем ровно ту форму, которую писала 1.2.3, — мы её и сочиняли. Три случая: канал в
    # середине, последним и единственным; иначе после удаления останется висячая запятая, и
    # спека перестанет быть JSON.
    _zd_re='{"name":"'"$ZM_CHANNEL"'","match":{"prefixes_files":\["[^"]*"\]},"out":"[^"]*"}'
    sed -e "s|$_zd_re,||" -e "s|,$_zd_re||" -e "s|$_zd_re||" "$SPEC" > "$SPEC.zm" 2>/dev/null
    if [ -s "$SPEC.zm" ] && "$STEER" apply --dry-run --spec "$SPEC.zm" >/dev/null 2>&1 &&
       ! jsonfilter -i "$SPEC.zm" -e '@.channels[*].name' 2>/dev/null | grep -qx "$ZM_CHANNEL"; then
        mv "$SPEC.zm" "$SPEC"
        return 0
    fi
    rm -f "$SPEC.zm"
    return 1
}

# Собрать (или снять) таблицу с адресами GitHub.
zm_rules_sync() {
    if ! zm_fix_on || [ ! -s "$ZM_LIST" ]; then
        nft delete table inet "$ZM_TABLE" 2>/dev/null
        return 0
    fi
    _zm_mark="$(zm_mark)" || { nft delete table inet "$ZM_TABLE" 2>/dev/null; return 0; }
    _zm_el="$(grep -oE '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+(/[0-9]+)?' "$ZM_LIST" | tr '\n' ',' | sed 's/,$//')"
    [ -n "$_zm_el" ] || { nft delete table inet "$ZM_TABLE" 2>/dev/null; return 0; }
    nft delete table inet "$ZM_TABLE" 2>/dev/null
    # `type route hook output` — метка ставится ДО решения о маршруте, иначе ядро не станет
    # его пересматривать и пакет уйдёт прежним путём. Маска — та же, что у движка: слово
    # метки общее, и затирать чужие биты нельзя.
    nft -f - <<NFT 2>/dev/null
table inet $ZM_TABLE {
    set gh {
        type ipv4_addr
        flags interval
        auto-merge
        elements = { $_zm_el }
    }
    chain out {
        type route hook output priority mangle + 1; policy accept;
        ip daddr @gh meta mark set mark and 0xf00fffff or $_zm_mark ct mark set mark counter
    }
}
NFT
}

# ---- DoH через туннель --------------------------------------------------------------
#
# ЗАЧЕМ. DoH прячет имена сайтов от провайдера, но сам запрос к резолверу провайдер видит и
# может закрыть — и закрывает: cloudflare-dns.com и dns.google у части аудитории не
# отвечают вовсе. Тогда DoH не поднимается, dnsmasq остаётся без серверов, и «интернет
# пропал» — при исправном туннеле рядом.
#
# КАК. Тем же приёмом, что фикс Zapret Manager выше, и это не совпадение: вопрос один — как
# увести СОБСТВЕННЫЙ трафик роутера в туннель, которым движок метит только транзит. Метка в
# цепочке `type route hook output`, маска движка, чужие биты не тронуты.
#
# ЧЕМ УЗНАЁТСЯ ТРАФИК ПРОКСИ. По владельцу сокета: https-dns-proxy мы сами записываем с
# `option user 'nobody'` (см. doh_write), и других процессов под nobody на стоковом роутере
# нет — dnsmasq, ntp, logd и ubus ходят под своими. Плюс порт назначения 443: DoH это HTTPS
# и ничего кроме. Адрес назначения для отбора не годится в принципе — имя резолвера
# разрешается по bootstrap, и в какой адрес оно разойдётся, заранее не известно.
#
# ЦЕНА, И О НЕЙ НАДО ЗНАТЬ. Если под nobody на роутере появится что-то ещё, ходящее в 443,
# его трафик тоже уйдёт в туннель. Последствие безобидное — это собственный трафик роутера
# через работающий выход, — но назвать его надо, потому что через год этот отбор будет
# читать другой человек.
# ОТБОР ИДЁТ ПРАВИЛОМ МАРШРУТИЗАЦИИ ПО ВЛАДЕЛЬЦУ СОКЕТА, а не меткой в nftables, и это второй
# урок, снятый с живого роутера.
#
# Сначала здесь стояла метка в цепочке `type route hook output` — тем же приёмом работает фикс
# Zapret Manager рядом. Для транзитного трафика приём верен, а для СОБСТВЕННОГО трафика
# роутера — нет: адрес источника ядро выбирает в момент connect(), то есть по таблице main, и
# только потом наша цепочка ставит метку и просит пересмотреть маршрут. Маршрут меняется,
# адрес источника — уже нет. Пакет уходит в туннель с адресом WAN, ответ на этот адрес через
# туннель не возвращается, и снаружи это выглядит как «DoH включён, DNS не работает».
# Проверено счётчиками: правило срабатывало (27 пакетов), ответов не было ни одного.
#
# `ip rule ... uidrange` применяется В САМОМ ПЕРВОМ поиске маршрута, поэтому адрес источника
# выбирается уже из таблицы туннеля. Заодно исчезает вся таблица nftables: одно правило
# вместо цепочки, метки и маски.
#
# ЦЕНА ОТБОРА, и о ней надо знать: через туннель пойдёт ВЕСЬ трафик пользователя nobody, а не
# только HTTPS. На стоковом роутере под nobody ходит только https-dns-proxy (dnsmasq, ntp,
# logd и ubus — под своими), так что это ровно то, что нужно; но если под nobody появится
# что-то ещё, оно тоже уйдёт в туннель.
#
# ТАБЛИЦА СВОЯ, а не таблица выхода, и это первый урок того же дня. Таблица выхода при
# `on_fail: drop` (умолчание) содержит запрет: туннель умер — трафик остановлен. Для трафика
# КЛИЕНТОВ это ровно то, что обещано. Но для собственного DNS роутера получается замкнутый
# круг, и вот он целиком, как он воспроизвёлся на 10.8.1.87:
#
#   клиент vless перезапустился → ему надо разрешить имя своего узла (ru.riotvpn.eu)
#   → запрос идёт в dnsmasq → dnsmasq пересылает его в https-dns-proxy → тот идёт к
#   резолверу по HTTPS → правило уводит это в таблицу выхода → выход ещё не поднят, в
#   таблице запрет → DoH молчит → имя не разрешается → клиент не поднимается никогда.
#
#   В журнале это выглядело как «steer[warn] tunnel: поток к ru.riotvpn.eu не открылся: имя
#   не разрешилось», а снаружи — как «роутер потерял интернет после включения галочки».
#
# Своя таблица содержит РОВНО ОДИН маршрут — default через устройство выхода. Когда
# устройство падает, ядро само убирает из таблицы маршруты через него; таблица пустеет,
# поиск в ней не находит ничего, и ядро ПЕРЕХОДИТ К СЛЕДУЮЩЕМУ правилу, то есть к main. DoH
# идёт напрямую, DNS оживает, туннель разрешает своё имя и поднимается — а правило снова
# начинает работать само. Проверено на роутере: `ip link set vless down` → таблица 290
# пустеет → DNS отвечает.
#
# Отказ здесь ОТКРЫТЫЙ, и это не поблажка: `on_fail: drop` — обещание про трафик КЛИЕНТОВ
# («не утечёт мимо туннеля»), а собственный DNS роутера — другой трафик и другое обещание.
#
# Номер таблицы 290 — ниже 300, с которой движок раздаёт свои; приоритет правила 29000 — выше
# (то есть раньше) его правил, чтобы наш выбор не перебивался меткой выхода.
DOH_RT="${DOH_RT:-290}"
DOH_RULE_PREF="${DOH_RULE_PREF:-29000}"

# uid пользователя nobody. Читается из /etc/passwd, а не зашивается: 65534 — соглашение, а
# не стандарт, и на роутере с чужой прошивкой оно может быть другим. Под этим же именем мы
# сами записываем `option user` в настройку прокси (см. doh_write), так что связь не
# случайная.
doh_uid() {
    _du="$(awk -F: '$1 == "nobody" { print $3; exit }' /etc/passwd 2>/dev/null)"
    case "${_du:-}" in ''|*[!0-9]*) printf '65534' ;; *) printf '%s' "$_du" ;; esac
}

doh_tunnel_on() {
    case "$(uci -q get splify2.main.doh_via_tunnel 2>/dev/null)" in
        1|on|yes|true|always) return 0 ;;
        *) return 1 ;;
    esac
}

# Устройство первого ПОДНЯТОГО выхода с устройством. Печатает «имя устройство».
#
# Именно поднятого, в отличие от zm_mark: маршрут через мёртвое устройство ядро не примет, а
# имя выхода мы показываем человеку — и назвать мёртвый выход значило бы обещать то, чего нет.
doh_out() {
    _do_st="$("$STEER" status --spec "$SPEC" 2>/dev/null)"
    [ -n "$_do_st" ] || return 1
    for _do_o in $("$STEER" outputs --spec "$SPEC" 2>/dev/null); do
        [ "$_do_o" = direct ] && continue
        case "$_do_o" in *[!a-zA-Z0-9_-]*) continue ;; esac
        [ "$(printf '%s' "$_do_st" | jsonfilter -e "@.outputs.$_do_o.up" 2>/dev/null)" = true ] ||
            continue
        _do_d="$(printf '%s' "$_do_st" | jsonfilter -e "@.outputs.$_do_o.device" 2>/dev/null)"
        [ -n "$_do_d" ] || continue
        printf '%s %s' "$_do_o" "$_do_d"
        return 0
    done
    return 1
}

# Снять всё своё: правило (сколько бы копий ни накопилось — `ip rule add` дубликаты не
# проверяет) и таблицу. Прежние версии ставили ещё и таблицу nftables — снимаем и её, иначе
# после обновления пакета она осталась бы висеть и метила бы трафик в никуда.
doh_rules_down() {
    _dd_n=0
    while [ "$_dd_n" -lt 32 ] && ip rule del pref "$DOH_RULE_PREF" 2>/dev/null; do
        _dd_n=$((_dd_n + 1))
    done
    ip route flush table "$DOH_RT" 2>/dev/null
    nft delete table inet splify2_doh 2>/dev/null
    return 0
}

doh_rules_sync() {
    if ! doh_tunnel_on || ! doh_installed; then
        doh_rules_down
        return 0
    fi
    _dr_pair="$(doh_out)" || { doh_rules_down; return 0; }
    _dr_dev="${_dr_pair#* }"
    doh_rules_down
    ip route replace default dev "$_dr_dev" table "$DOH_RT" 2>/dev/null ||
        { doh_rules_down; return 0; }
    _dr_uid="$(doh_uid)"
    ip rule add uidrange "$_dr_uid-$_dr_uid" table "$DOH_RT" pref "$DOH_RULE_PREF" 2>/dev/null ||
        { doh_rules_down; return 0; }
    return 0
}

# Зона фаервола для устройств, которые движок создаёт сам (выходы kind=vless).
#
# Зачем это здесь. fw4 отвергает форвардинг на устройство, не входящее ни в одну зону:
# политика цепочки forward — drop, и клиент получает «Operation not permitted» ещё до
# того, как пакет доберётся до туннеля. Проверено с настоящего клиента, а не выведено.
#
# Почему этого не делает движок. В nftables вердикт accept в своей базовой цепочке
# завершает только ЕЁ: пакет всё равно доходит до цепочки fw4 и там отбрасывается. То
# есть «разрешить заранее» из отдельной таблицы невозможно в принципе, и единственный
# способ — попасть в зону. А зоны — это uci, то есть управляющий слой. Движок про это
# честно предупреждает («not mentioned by the firewall at all»), но починить не может.
#
# Имена зон и их политики — ниже, у FW_ZONES: их две, и различает их нужда в трансляции
# адресов, а не вкус.

# Файл настройки uci. Пакет его не кладёт, а `uci set` в несуществующий файл молча ничего не
# делает — ссылка подписки «сохранялась» и пропадала, причём метод отвечал ok. Тихая потеря
# настройки хуже отказа, поэтому файл заводится здесь.
#
# `touch`, а не `: > файл`, и это не вкус: отказ перенаправления у СПЕЦИАЛЬНОЙ встроенной
# команды завершает оболочку целиком (так требует POSIX и так делает ash). То есть там, где
# каталога нет или на overlay кончилось место, метод умирал БЕЗ ОТВЕТА вовсе — ни ok, ни
# ошибки, и интерфейс показывал «нет ответа» на пустом месте. Урок был записан в запуске 46 у
# backup_put и там же исправлен, а два других места остались с прежней строкой: sub_set и
# ui_set. Теперь оно одно на все три, потому что три копии одного правила — это три места,
# где его можно забыть по-разному.
UCI_SPLIFY2="${UCI_SPLIFY2:-/etc/config/splify2}"
uci_file() {
    [ -f "$UCI_SPLIFY2" ] && return 0
    mkdir -p "$(dirname "$UCI_SPLIFY2")" 2>/dev/null
    touch "$UCI_SPLIFY2" 2>/dev/null
    [ -f "$UCI_SPLIFY2" ]
}
# Признак «настройку vless надо перечитать». Ставится там, где изменилось то, что клиент
# читает ОДИН РАЗ при старте — выбранный узел или файл подписки, — и снимается после
# перезапуска экземпляров.
#
# Через файл, а не переменную: spec_set и apply — два отдельных вызова rpcd, то есть два
# процесса, и между ними ничего не переживает, кроме диска.
VLESS_DIRTY="${VLESS_DIRTY:-/var/run/splify2-vless-dirty}"

# Признак НАКАПЛИВАЕТСЯ: слово в файле, по строке на повод. Пишет его сохранение, читает
# применение, а сохранений между двумя применениями бывает много — автосохранение зовёт
# spec_set после каждой правки, кнопку «Применить» нажимают один раз. Пока признак
# перезаписывался, ранний повод терялся поздним: завели выход vless (instances), тут же
# выбрали ему узел (params) — и apply сигналил экземпляру, которого ещё нет, вместо того
# чтобы пересобрать набор. Туннель при этом не поднимался до перезапуска движка, а в
# интерфейсе выглядел настроенным; ровно с этой жалобой пришёл пользователь (splicicd#20).
dirty_mark() {  # ФАЙЛ_ПРИЗНАКА СЛОВО
    grep -qx "$2" "$1" 2>/dev/null || echo "$2" >> "$1"
}
dirty_has() {  # ФАЙЛ_ПРИЗНАКА СЛОВО
    grep -qx "$2" "$1" 2>/dev/null
}

# Отпечаток того, от чего зависит выбор узла. Меняется он — надо перезапустить клиента,
# не меняется — трогать туннель нельзя: перезапуск роняет все соединения через него, а
# заново выбранный «первый рабочий» может оказаться другим узлом. Правка списка домены
# не должна менять выходной адрес.
vless_fingerprint() {  # ФАЙЛ_СПЕКИ
    f="$1"
    [ -s "$f" ] || { echo none; return; }
    for o in $("$STEER" outputs --kind vless --spec "$f" 2>/dev/null); do
        printf '%s:%s:%s\n' "$o" \
            "$(jsonfilter -i "$f" -e "@.outputs.$o.sub_file" 2>/dev/null)" \
            "$(jsonfilter -i "$f" -e "@.outputs.$o.node" 2>/dev/null)"
    done | md5sum | awk '{print $1}'
}

# То же для обфускации транспорта (WireGuard поверх TCP). Отдельный признак, а не общий с
# vless: перезапускать надо разные экземпляры, и по разным поводам.
OBFS_DIRTY="${OBFS_DIRTY:-/var/run/splify2-obfs-dirty}"

# Обфускатор читает адрес сервера и локальный порт ОДИН РАЗ при старте — как клиент vless
# читает узел. Правка любого другого поля выхода (устройства, on_fail, списки каналов) его
# не касается, и трогать процесс из-за неё нельзя: перезапуск рвёт сессию, а с ней и
# рукопожатие WireGuard поверх неё.
obfs_fingerprint() {  # ФАЙЛ_СПЕКИ
    f="$1"
    [ -s "$f" ] || { echo none; return; }
    for o in $("$STEER" outputs --obfs --spec "$f" 2>/dev/null); do
        printf '%s:%s:%s\n' "$o" \
            "$(jsonfilter -i "$f" -e "@.outputs.$o.obfs.server" 2>/dev/null)" \
            "$(jsonfilter -i "$f" -e "@.outputs.$o.obfs.listen" 2>/dev/null)"
    done | md5sum | awk '{print $1}'
}

obfs_names() {  # ФАЙЛ_СПЕКИ
    [ -s "$1" ] || return 0
    "$STEER" outputs --obfs --spec "$1" 2>/dev/null | tr '\n' ' '
}

# То же для vless, и по той же причине, что у обфускации: смена узла лечится сигналом
# живому экземпляру, а появление НОВОГО выхода — нет, потому что экземпляра ещё нет.
vless_names() {  # ФАЙЛ_СПЕКИ
    [ -s "$1" ] || return 0
    "$STEER" outputs --kind vless --spec "$1" 2>/dev/null | tr '\n' ' '
}

# Расписка: что в фаерволе сделали МЫ, а что было до нас.
#
# Файл, а не пометка в самой зоне: fw4 на незнакомую опцию в секции ругается («specifies
# unknown option») при каждой перезагрузке правил, и человек читал бы это как дефект. А судить
# по одному имени нельзя: зону с тем же именем мог сделать руками и человек — тогда она его.
#
# Записи двух видов, и вторая не менее важна первой:
#   zone ЗОНА           — зону создали мы, значит нам её и убирать;
#   dev ЗОНА УСТРОЙСТВО — это устройство в эту зону добавили мы.
#
# Учёт ПО КАЖДОМУ устройству нужен затем же, зачем и учёт зоны: в нашу зону человек мог руками
# положить своё устройство, а правило «убрать всё, чего нет в спеке» вынесло бы его молча.
FW_OWNED="${FW_OWNED:-/etc/splify2/fw-owned}"

fw_note() {  # СТРОКА
    mkdir -p "$(dirname "$FW_OWNED")" 2>/dev/null
    grep -qxF "$1" "$FW_OWNED" 2>/dev/null || printf '%s\n' "$1" >> "$FW_OWNED"
}
fw_noted() { grep -qxF "$1" "$FW_OWNED" 2>/dev/null; }
fw_unnote() {  # СТРОКА
    [ -f "$FW_OWNED" ] || return 0
    grep -vxF "$1" "$FW_OWNED" > "$FW_OWNED.tmp" 2>/dev/null
    mv "$FW_OWNED.tmp" "$FW_OWNED" 2>/dev/null || rm -f "$FW_OWNED.tmp"
}

# ДВЕ зоны, а не одна, и различает их НУЖДА В ТРАНСЛЯЦИИ АДРЕСОВ.
#
# steer_vless — устройства, которые создаёт сам движок (kind=vless и kind=xsteer). NAT там не
# нужен и вреден: клиент завершает TCP у себя и соединяется с сервером обычным сокетом, адрес
# клиента наружу не уезжает вовсе, а трансляция на входе в устройство подменила бы адреса, по
# которым движок и различает клиентов.
#
# steer_iface — устройства выходов kind=interface, то есть WireGuard, AmneziaWG и всё, что
# поднимает netifd. Здесь наоборот: пакет уходит в туннель как есть и уносит адрес из локальной
# сети, а обратно не возвращается ничего. Движок это и говорит своим «no masquerade/snat rule
# found for wgN: packets leave with LAN addresses and the channel goes quiet while its counter
# still rises». Значит masq здесь обязателен — и именно поэтому зона отдельная: смешав их, мы
# либо оставили бы wg без NAT, либо навязали NAT туннелю движка.
#
# Имя steer_vless сохранено, хотя теперь оно уже не про один vless: на него могли сослаться
# собственные правила человека, а переименование сломало бы их молча.
FW_ZONES="steer_vless:vless,xsteer:0 steer_iface:interface:1"

zone_index() {  # ИМЯ_ЗОНЫ
    uci show firewall 2>/dev/null | sed -n "s/^firewall\.@zone\[\([0-9]*\)\]\.name='$1'$/\1/p" | head -1
}

# В какой зоне уже лежит это устройство. Пусто — ни в какой.
#
# Нужно потому, что устройство в ДВУХ зонах fw4 не прощает, а устройство выхода kind=interface
# человек мог назначить в зону сам — страница интерфейса в LuCI это предлагает. Молча добавив
# его во вторую, мы получили бы отказ перезагрузки правил и неработающий фаервол целиком.
fw_zone_of_device() {  # ИМЯ_УСТРОЙСТВА
    uci show firewall 2>/dev/null |
        sed -n "s/^firewall\.@zone\[\([0-9]*\)\]\.device=.*'\?$1'\?.*$/\1/p" | head -1
}

# Устройства выходов перечисленных видов. Имена спрашиваются у движка флагом --devices, а не
# берутся как имена выходов: устройство выводится из имени выхода, НО может быть задано в спеке
# явно, и тогда «имя выхода» — это молча неверный список ровно там, где по нему настраивают
# фаервол. kind=direct отсеивается сам: устройства у него нет, и --devices ничего не печатает.
fw_devices_of() {  # ВИДЫ_ЧЕРЕЗ_ЗАПЯТУЮ
    for k in $(printf '%s' "$1" | tr ',' ' '); do
        "$STEER" outputs --kind "$k" --devices --spec "$SPEC" 2>/dev/null
    done | grep . | sort -u
}

fw_zone_devices() {  # ИНДЕКС
    uci -q get "firewall.@zone[$1].device" 2>/dev/null | tr ' ' '\n' | grep . | sort -u
}

# Принять существующую зону за свою, если отличить её от нашей нельзя.
#
# Зона steer_vless заводилась и прежними версиями, когда расписок ещё не было. Без принятия она
# навсегда осталась бы «чужой» и перестала бы убираться вместе с последним туннельным выходом —
# ровно та накопительная беда, от которой и просили избавить.
#
# Условие строгое: в зоне нет НИ ОДНОГО устройства, которого мы не завели бы сами. Есть
# постороннее — значит зону правили руками, и она чужая: дополняем, но не чистим и не удаляем.
fw_adopt_if_ours() {  # ЗОНА ИНДЕКС СПИСОК_НУЖНЫХ
    fw_noted "zone $1" && return 0
    for d in $(fw_zone_devices "$2"); do
        printf '%s\n' "$3" | grep -qx "$d" || return 1
    done
    fw_note "zone $1"
    for d in $(fw_zone_devices "$2"); do fw_note "dev $1 $d"; done
    return 0
}

# Одна зона: создать, дополнить, убрать ушедшее, удалить саму зону, когда её устройств не
# осталось. Удаляет ТОЛЬКО записанное за нами. Печатает, что сделала; код 1 — изменения были.
fw_zone_sync() {  # ЗОНА ВИДЫ MASQ
    _z="$1"; _kinds="$2"; _masq="$3"
    want="$(fw_devices_of "$_kinds")"
    idx="$(zone_index "$_z")"
    changed=0
    msg=""
    skipped=""

    # Устройства, которым зона УЖЕ назначена человеком, отсеиваются здесь — до решения
    # создавать нашу. Иначе на роутере, где все туннели человек развёл по своим зонам,
    # оставалась бы пустая зона с пробросом в неё: мусор, который выглядит как недоделка.
    #
    # Отсев именно тут, а не при добавлении: там мы бы уже создали зону, а отменять
    # созданное — лишний путь, на котором легко оставить половину.
    if [ -n "$want" ]; then
        _keep=""
        for d in $want; do
            other="$(fw_zone_of_device "$d")"
            if [ -n "$other" ] && { [ -z "$idx" ] || [ "$other" != "$idx" ]; }; then
                skipped="$skipped $d"
                continue
            fi
            _keep="$_keep$d
"
        done
        want="$(printf '%s' "$_keep" | grep . | sort -u)"
    fi
    # Говорится СРАЗУ, а не в конце: после отсева зона может оказаться ненужной вовсе, и
    # тогда работа кончится раньше, а человек так и не узнает, почему его туннель в нашу
    # зону не попал. Молчание здесь читается как «сделали и не помогло».
    [ -n "$skipped" ] &&
        echo "устройства$skipped уже в своих зонах фаервола — оставлены как есть"

    if [ -z "$want" ]; then
        [ -n "$idx" ] || { fw_unnote "zone $_z"; return 0; }
        fw_adopt_if_ours "$_z" "$idx" "" || return 0
        # Сначала правила проброса на зону, потом сама зона: удалив зону первой, мы оставили бы
        # forwarding, ссылающийся в пустоту, и fw4 отказался бы перезагружаться.
        while :; do
            f="$(uci show firewall 2>/dev/null | sed -n "s/^firewall\.\(@forwarding\[[0-9]*\]\)\.dest='$_z'$/\1/p" | head -1)"
            [ -n "$f" ] || break
            uci -q delete "firewall.$f" || break
            changed=1
        done
        for d in $(fw_zone_devices "$idx"); do fw_unnote "dev $_z $d"; done
        uci -q delete "firewall.@zone[$idx]" && changed=1
        if [ "$changed" = 1 ]; then
            uci -q commit firewall
            fw_unnote "zone $_z"
            echo "зона $_z удалена — выходов с такими устройствами в спеке больше нет"
        fi
        return "$changed"
    fi

    if [ -z "$idx" ]; then
        uci -q add firewall zone >/dev/null
        uci -q set firewall.@zone[-1].name="$_z"
        # input REJECT: зона нужна для транзита, а не для доступа к самому роутеру со стороны
        # туннеля. forward ACCEPT — иначе смысла в ней нет.
        uci -q set firewall.@zone[-1].input='REJECT'
        uci -q set firewall.@zone[-1].output='ACCEPT'
        uci -q set firewall.@zone[-1].forward='ACCEPT'
        uci -q set firewall.@zone[-1].masq="$_masq"
        uci -q set firewall.@zone[-1].mtu_fix='1'
        idx="$(zone_index "$_z")"
        [ -n "$idx" ] || return 0
        fw_note "zone $_z"
        changed=1
        msg="зона $_z создана (NAT: $_masq)"
    else
        fw_adopt_if_ours "$_z" "$idx" "$want" || true
    fi

    have="$(fw_zone_devices "$idx")"
    added=""
    for d in $want; do
        printf '%s\n' "$have" | grep -qx "$d" && continue
        uci -q add_list "firewall.@zone[$idx].device"="$d"
        fw_note "dev $_z $d"
        added="$added $d"
        changed=1
    done

    # Убираем только записанное за нами: устройство, положенное в эту зону руками, спека не
    # описывает и описывать не должна — вынести его значило бы поломать чужую настройку молча.
    removed=""
    for d in $have; do
        printf '%s\n' "$want" | grep -qx "$d" && continue
        fw_noted "dev $_z $d" || continue
        uci -q del_list "firewall.@zone[$idx].device"="$d"
        fw_unnote "dev $_z $d"
        removed="$removed $d"
        changed=1
    done

    # Разрешение lan -> зона. Без него зона есть, а трафик всё равно не идёт: политика forward
    # у fw4 применяется к паре зон, а не к одной.
    uci show firewall 2>/dev/null | grep -q "\.dest='$_z'" || {
        uci -q add firewall forwarding >/dev/null
        uci -q set firewall.@forwarding[-1].src='lan'
        uci -q set firewall.@forwarding[-1].dest="$_z"
        changed=1
        msg="${msg:+$msg, }проброс lan -> $_z добавлен"
    }

    if [ "$changed" = 1 ]; then
        uci -q commit firewall
        [ -n "$added" ] && msg="${msg:+$msg, }добавлены устройства:$added"
        [ -n "$removed" ] && msg="${msg:+$msg, }убраны ушедшие устройства:$removed"
        fw_noted "zone $_z" || msg="$msg (зона $_z не наша — только дополняем, ничего не удаляем)"
        echo "$msg"
    fi
    return "$changed"
}

# Привести фаервол в соответствие со спекой. Перезагрузка правил ОДНА на все зоны: fw4 reload
# перестраивает набор целиком, и звать его на каждую зону значило бы дважды уронить транзит.
fw_sync() {
    any=0
    for z in $FW_ZONES; do
        _n="${z%%:*}"; _rest="${z#*:}"
        _k="${_rest%%:*}"; _m="${_rest##*:}"
        out="$(fw_zone_sync "$_n" "$_k" "$_m")" || any=1
        # По строке: fw_zone_sync печатает и «что сделали», и «что не тронули», а один
        # printf на многострочное значение оставил бы вторую строку без имени того, кто
        # говорит, — в общем выводе apply она читалась бы как сообщение движка.
        [ -n "$out" ] && printf '%s\n' "$out" | while IFS= read -r l; do
            [ -n "$l" ] && printf 'splify2: %s\n' "$l"
        done
    done
    if [ "$any" = 1 ]; then
        fw4 reload >/dev/null 2>&1 || /etc/init.d/firewall reload >/dev/null 2>&1
    fi
}

# Архитектура ПАКЕТОВ, а не процессора.
#
# `apk --print-arch` отдаёт `aarch64`, а пакеты OpenWrt называются `aarch64_cortex-a53`:
# по первому имя файла собирается неверно, и скачивание молча не находит релиз. Верный
# источник — DISTRIB_ARCH из /etc/openwrt_release, то же значение, что показывает
# `apk list -I` в колонке архитектуры.
# Фолбэка на `apk --print-arch` здесь СОЗНАТЕЛЬНО нет, хотя он напрашивается. Он отдаёт
# `aarch64`, а в релизе нет ни одного файла с таким именем: имя собирается неверно,
# скачивание не находит пакет и отвечает «нет такой версии для aarch64» — то есть винит
# издателя в том, чего не делал. Пустой ответ честнее: и steer_versions, и steer_install
# на нём говорят «не определилась архитектура», и это правда.
pkg_arch() {
    [ -f "$OPENWRT_RELEASE" ] || return 0
    ( . "$OPENWRT_RELEASE"; printf '%s' "${DISTRIB_ARCH:-}" )
}

# Релизы GitHub: версия, которой ставится пакет, и НАЗВАНИЕ, которым выпуск называют.
#
# Это две разные строки, и разные они по необходимости. Версия участвует в имени файла пакета
# (`luci-app-splify2-26.9-1_noarch.apk`) и в теге (`v26.9`), поэтому в ней могут быть только
# цифры и точки — пробелу там места нет ни у apk, ни у opkg, ни в URL. А выпуск называется
# «26.9 Andromeda»: так он подписан на странице релизов и так о нём говорят.
#
# Пока бэкенд отдавал одни числа, список версий не сходился ни со страницей релизов, ни с
# разговором о выпуске: человек читал «Обновить до 26.9», а искал «Andromeda». Теперь версия
# и название едут рядом, сравнение по-прежнему идёт по числам, а установка — по версии.
#
# Отбор версий тот же, каким установка версию отвергает: тег с суффиксом («0.9.5-rc1»,
# «nightly») иначе доезжает до выпадающего списка, встаёт первым — то есть помечается
# «свежая» — и получает отказ собственного бэкенда при нажатии «Установить» (I-052). Число
# составляющих при этом не проверяется: «26.9» — такая же законная версия, как «1.2.0», и
# требовать три части значило бы отвергать собственный выпуск.
#
# Спрашиваем у GitHub, а не держим список: зашитая версия означает, что интерфейс ставит
# прошлое, и узнать об этом можно только заметив, что чего-то не хватает. Последние десять —
# больше человеку не нужно, старые релизы остаются доступны по прямой ссылке.

# Версии через пробел, от новых к старым. Пробелов в них не бывает по условию отбора выше,
# поэтому список безопасно перебирать словами.
GH_VERS=""
# Названия: «|версия=название|версия=название|». Своя разметка, а не массив, потому что
# массивов у POSIX sh нет, а `while read` в конвейере ушёл бы в подоболочку — и всё, что jshn
# накопил в переменных, там бы и осталось.
GH_NAMES=""
# Почему список версий такой короткий — одной строкой для человека. Пусто, когда перечень
# приехал обычным путём: примечание на здоровом пути читалось бы как «что-то не так».
GH_NOTE=""

gh_load() {  # ВЛАДЕЛЕЦ/РЕПОЗИТОРИЙ
    GH_VERS=""
    GH_NAMES="|"
    GH_NOTE=""
    gh_load_api "$1" && return 0
    gh_load_version "$1"
}

gh_load_api() {  # ВЛАДЕЛЕЦ/РЕПОЗИТОРИЙ
    _f="${GH_CACHE:-/tmp/splify2-releases.json}"
    rm -f "$_f"
    wget -qO "$_f" --timeout=20 \
        "https://api.github.com/repos/$1/releases?per_page=10" 2>/dev/null || {
            rm -f "$_f"; return 1; }
    [ -s "$_f" ] || { rm -f "$_f"; return 1; }
    _nl='
'
    _i=0
    while [ "$_i" -lt 10 ]; do
        # Два поля ОДНИМ запуском jsonfilter: он печатает по строке на выражение и в порядке
        # выражений. Двадцать запусков вместо десяти стоили бы роутеру вдвое больше процессов
        # ради того же ответа. Разбор по строкам — подстановкой, а не sed: ещё двадцать
        # процессов на то, что оболочка умеет сама.
        _both="$(jsonfilter -i "$_f" -e "@[$_i].tag_name" -e "@[$_i].name" 2>/dev/null)"
        _tag="${_both%%"$_nl"*}"
        [ -n "$_tag" ] || break
        _name="${_both#*"$_nl"}"
        # Строки одна — значит названия у релиза нет вовсе (в ответе `null`): jsonfilter в
        # этом случае не печатает ничего, и вторая строка не появляется.
        [ "$_name" != "$_both" ] || _name=""
        _ver="${_tag#v}"
        _i=$((_i + 1))
        case "$_ver" in ''|*[!0-9.]*) continue ;; esac
        # Название с вертикальной чертой сломало бы разметку GH_NAMES — тогда обходимся
        # числом. Отказываться от релиза из-за его заголовка было бы хуже: ставится он всё
        # равно по версии.
        case "$_name" in ''|*"|"*) _name="$_ver" ;; esac
        GH_VERS="$GH_VERS$_ver "
        GH_NAMES="$GH_NAMES$_ver=$_name|"
    done
    rm -f "$_f"
    [ -n "$GH_VERS" ]
}

# Запасной источник перечня: файл VERSION в главной ветке репозитория.
#
# ЗАЧЕМ. splify2#15. Пакеты и списки обход блокировки уже имеют — их берёт общая download()
# с лестницей «зеркало gitlab.com → contents API → архив через codeload → туннель». А сам
# ПЕРЕЧЕНЬ версий спрашивался у одного-единственного хоста, api.github.com. Там, где его
# закрыли, и там, где за CGNAT соседи выбрали неавторизованный лимит в 60 запросов в час
# (так и пришла splify2#5), обе карточки показывали пустой список: обновиться из интерфейса
# было нельзя, хотя пакет с зеркала скачался бы прекрасно. Установщик этот путь имеет
# давно (R-048), бэкенд — не имел, и асимметрия была ровно наоборот полезной: установить
# получалось, а обновить нет.
#
# ПОЧЕМУ VERSION, А НЕ СПИСОК РЕЛИЗОВ С ЗЕРКАЛА. Зеркалирование копирует коммиты, ветки и
# теги; релизы GitHub живут вне репозитория и на зеркало не переезжают. Зато VERSION в
# главной ветке содержит ровно то число, которое релизный workflow записал перед выкладкой
# пакетов, — и берётся оно через ту же download(), то есть все обходы достаются даром.
#
# ЧТО ЭТОТ ПУТЬ НЕ ДАЁТ. Одну версию вместо десяти и без названия выпуска: выбрать старую
# отсюда нельзя. Это честно сказано полем `note` — молчание здесь читалось бы как «релиз
# всего один».
gh_load_version() {  # ВЛАДЕЛЕЦ/РЕПОЗИТОРИЙ
    _vf="${GH_CACHE:-/tmp/splify2-releases.json}.version"
    rm -f "$_vf"
    download "https://raw.githubusercontent.com/$1/main/VERSION" "$_vf" || {
        rm -f "$_vf"; return 1; }
    # Первая строка без хвостовых пробелов. Состав проверяется целиком: в VERSION бывают
    # только цифры и точки (на это стоит барьер в build.sh), и подставить в имя файла
    # пакета что-то другое хуже, чем остаться без версии и сказать об этом.
    _vv="$(sed -n '1{s/[[:space:]]*$//;p;}' "$_vf" 2>/dev/null)"
    rm -f "$_vf"
    case "${_vv:-}" in ''|*[!0-9.]*) return 1 ;; esac
    GH_VERS="$_vv "
    GH_NAMES="|$_vv=$_vv|"
    GH_NOTE="список релизов не отдали — версия взята из VERSION в main${FETCH_NOTE:+ ($FETCH_NOTE)}"
    return 0
}

# Название выпуска по его версии — в GH_NAME. Через переменную, а не печатью: `$(...)` на
# каждую версию это ещё десять подоболочек там, где хватает подстановки.
gh_name_of() {  # ВЕРСИЯ
    GH_NAME="$1"
    _t="${GH_NAMES#*|$1=}"
    [ "$_t" = "$GH_NAMES" ] || GH_NAME="${_t%%|*}"
}

# Оба поля ответа: `versions` — чем ставить, `names` — как называется. Массив и объект, а не
# два массива: параллельные списки расходятся молча, а по версии название находится всегда.
gh_add_releases() {
    json_add_array versions
    for _v in $GH_VERS; do json_add_string "" "$_v"; done
    json_close_array
    json_add_object names
    for _v in $GH_VERS; do gh_name_of "$_v"; json_add_string "$_v" "$GH_NAME"; done
    json_close_object
    # Почему список такой, какой есть. Только когда есть что сказать: примечание на здоровом
    # пути было бы шумом, а на больном — единственным объяснением, почему версия одна.
    [ -n "$GH_NOTE" ] && json_add_string note "$GH_NOTE"
}

# Какой менеджер пакетов на этом роутере.
#
# Определяется, а не предполагается: релизы обоих проектов теперь содержат и .apk, и
# .ipk, установщик ставит через тот, что есть, — и бэкенд обязан уметь ровно то же.
# Иначе на OpenWrt 23.05 карточка движка показывала бы пустую версию, «Установить»
# возвращало бы пустое сообщение об ошибке (apk нет, rc 127, вывод пуст), а
# самообновление интерфейса не работало бы вовсе.
#
# Единожды на запуск скрипта: ниже это спрашивают трижды.
# PM_FIXTURE — шов для стенда: на машине разработчика есть только заглушки, и обе сразу,
# поэтому иначе ветка opkg (а именно на ней и случаются беды с зависимостями) не проверяется
# никогда. На роутере переменной нет, и всё решает наличие менеджера.
if [ -n "${PM_FIXTURE:-}" ]; then PM="$PM_FIXTURE"
elif command -v apk >/dev/null 2>&1; then PM=apk
elif command -v opkg >/dev/null 2>&1; then PM=opkg
else PM=none
fi

# Расширение файла пакета для этого менеджера и суффикс архитектуры у пакета без
# бинарного кода: apk называет такой noarch, opkg — all.
pkg_ext()    { if [ "$PM" = apk ]; then echo apk; else echo ipk; fi; }
pkg_noarch() { if [ "$PM" = apk ]; then echo noarch.apk; else echo all.ipk; fi; }

# Установленная версия пакета по его имени.
#
# Форматы вывода разные: `apk list -I` печатает «имя-1.2.3-r1 ...», `opkg list-installed`
# — «имя - 1.2.3-1». Разбирается каждый своим выражением, а не одним «на всякий случай»:
# общее выражение здесь молча выдавало бы пустоту на одном из двух.
pkg_version() {  # ИМЯ_ПАКЕТА
    case "$PM" in
        apk)  apk list -I 2>/dev/null | sed -n "s/^$1-\([0-9][^ ]*\)-r.*/\1/p" | head -1 ;;
        opkg) opkg list-installed 2>/dev/null | sed -n "s/^$1 - \([0-9][^ ]*\)/\1/p" | head -1 ;;
    esac
}

# Поставить скачанный пакет, не оставив роутер без того, что работало.
#
# Порядок здесь — не стиль, а разница между «установка не удалась» и «роутер больше не
# маршрутизирует». `apk del` запускает pre-deinstall снимаемого пакета, а тот
# останавливает и ОТКЛЮЧАЕТ сервис; stop_service движка сносит таблицу nft и вычищает
# ip rule. Пока удаление стояло первым, любой отказ apk add — не та архитектура,
# кончилось место, битый файл — оставлял роутер без движка, без правил и со снятым
# автозапуском, то есть перезагрузка уже не спасала. И всё это в ответ на «обновить»,
# то есть на действие, которое ничего ломать не собиралось (I-049).
#
# Поэтому сначала ставим. Обновление в пределах одного варианта — самый частый путь —
# при этом вообще не проходит через удаление: apk заменяет пакет на месте.
#
# --force-overwrite нужен потому, что расширенный и базовый пакеты движка владеют одним
# /usr/sbin/steer. Но конфликт ИМЁН пакетов (provides/conflicts) он не снимает — вот на
# нём удаление и остаётся законным, уже вторым шагом.
#
# Возвращает код apk; заполняет PKG_OUT (вывод apk) и PKG_REMOVED (снимался ли пакет).
# Поставить локальный файл тем менеджером, который есть. --force-overwrite понимают оба
# и нужен обоим (см. выше про общий /usr/sbin/steer); --allow-untrusted — только apk:
# у opkg проверки подписи для локального файла нет вовсе, и такого флага он не знает.
#
# У opkg есть беда, которой нет у apk: зависимости локального файла он ищет в СПИСКАХ
# ПАКЕТОВ, а на свежей прошивке их нет — списки не переживают перезагрузку. Тогда установка
# падает на «cannot find dependency ip-full for steer», хотя пакет скачан и лежит рядом.
# Списки обновляются и установка повторяется ровно один раз: если зависимости нет и после
# обновления, дело не в списках.
pkg_add_file() {  # ФАЙЛ
    if [ "$PM" = apk ]; then
        apk add --allow-untrusted --force-overwrite "$1" 2>&1
        return $?
    fi
    _pa_out="$(opkg install --force-overwrite "$1" 2>&1)"
    _pa_rc=$?
    if [ "$_pa_rc" != 0 ]; then
        case "$_pa_out" in
            *"cannot find dependency"*|*"unresolved"*|*"incompatible with the architectures"*)
                opkg update >/dev/null 2>&1
                _pa_out="$(opkg install --force-overwrite "$1" 2>&1)
списки пакетов были пусты — обновил их (opkg update) и повторил"
                _pa_rc=$?
                ;;
        esac
    fi
    printf '%s' "$_pa_out"
    return $_pa_rc
}

pkg_del() {  # ИМЯ
    if [ "$PM" = apk ]; then apk del "$1" >/dev/null 2>&1
    else opkg remove "$1" >/dev/null 2>&1
    fi
}

# Поставить пакет ПО ИМЕНИ, из репозитория. Не то же, что pkg_install: тот ставит СКАЧАННЫЙ
# ФАЙЛ (движок и интерфейс приезжают из GitHub Releases), а здесь речь про обычные пакеты
# OpenWrt — unzip и curl, без которых половина работы с обходом DPI невозможна.
#
# Списки пакетов обновляются при неудаче и ровно один раз. Причина та же, что у pkg_add_file:
# на свежей прошивке списков нет — они не переживают перезагрузку, — и установка падает не
# потому, что пакета нет, а потому, что о нём нечего знать. У apk это ровно так же, как у
# opkg, хотя беда с зависимостями локального файла у него не воспроизводится.
pkg_add_name() {  # ИМЯ
    if [ "$PM" = apk ]; then
        apk add "$1" >/dev/null 2>&1 && return 0
        apk update >/dev/null 2>&1
        apk add "$1" >/dev/null 2>&1
    else
        opkg install "$1" >/dev/null 2>&1 && return 0
        opkg update >/dev/null 2>&1
        opkg install "$1" >/dev/null 2>&1
    fi
}

pkg_install() {  # ФАЙЛ [ИМЯ_ДЛЯ_СНЯТИЯ...]
    file="$1"; shift
    PKG_OUT="$(pkg_add_file "$file")"
    rc=$?
    PKG_REMOVED=0
    [ "$rc" = 0 ] && return 0
    # Шаблон намеренно узкий — только слово «конфликт». `unable to select packages` сюда
    # не годится, хотя apk печатает его и при конфликте тоже: это его общий текст на
    # любую неудовлетворимую зависимость, включая «нет nftables». Снимать по нему
    # рабочий пакет значило бы вернуть ровно ту поломку, ради которой порядок и
    # переставлен.
    case "$PKG_OUT" in
        *conflict*|*Conflict*|*КОНФЛИКТ*|*конфликт*) ;;
        *) return "$rc" ;;
    esac
    [ "$#" -gt 0 ] || return "$rc"
    for n in "$@"; do pkg_del "$n"; done
    PKG_REMOVED=1
    PKG_OUT="$(pkg_add_file "$file")"
    return $?
}

# Свои списки лежат отдельным подкаталогом, а не вперемешку со списками издателя.
#
# Иначе их не отличить: local_lists отдаёт всё, что лежит на диске, и «мой файл» от
# «файла из манифеста» отличался бы только тем, есть ли такое имя в манифесте — то есть
# менялся бы сам по себе при обновлении манифеста.
CUSTOM=custom
# Предел размера. Не перестраховка: overlay на роутере из отчётов теста — 6.9 МБ, и
# список, который туда не влезет, положит не только себя. Мегабайта хватает на ~70 тысяч
# доменов, чего для ручного списка заведомо достаточно.
LIST_MAX_BYTES=1048576
# По сколько байт отдавать список обратно (list_get). Тот же порядок величины, что у кусков
# архива настроек, и по той же причине: ubus не резиновый, а свой список разрешён до
# LIST_MAX_BYTES — целиком он в одно сообщение не влезает.
#
# Шов, как у BACKUP_MAX_BYTES, и ровно с тем же доводом: стенду надо проверить, что кусок
# приезжает БАЙТ В БАЙТ и что смещение считается по считанному, а генерировать для этого
# шестнадцать килобайт списка было бы проверкой размера фикстуры, а не логики. rpcd запускает
# объект с чистым окружением, так что на роутере ветка `:-` не выбирается никогда.
LIST_CHUNK="${LIST_CHUNK:-16384}"

# Путь своего списка. Доменные лежат в подкаталоге, адресные — рядом, как у издателя.
custom_path() {  # ИМЯ ВИД
    case "$2" in
        domains) printf '%s/%s/domains/%s.lst' "$LISTS" "$CUSTOM" "$1" ;;
        *)       printf '%s/%s/%s.lst'         "$LISTS" "$CUSTOM" "$1" ;;
    esac
}

# ОТКУДА ВЗЯЛСЯ СВОЙ СПИСОК — рядом с ним, отдельным файлом.
#
# ЗАЧЕМ. Завести список можно тремя способами: набрать записи руками, выбрать файл, дать
# ссылку. Изменить его после этого было НЕЧЕМ: единственная кнопка рядом со списком —
# удалить и завести заново. А правка нужна ровно по тому же разделению, каким список
# завели: у файла меняют файл, у ссылки — ссылку, у набранного руками — сами записи. Не зная
# происхождения, интерфейс вынужден предлагать все три способа всем, и человек, положивший
# файл на 20 тысяч строк, получает предложение отредактировать его в текстовом поле.
#
# ПОЧЕМУ ФАЙЛОМ, А НЕ В uci. Список — это файл на диске, и его происхождение обязано
# лежать там же: список, положенный руками в /etc/steer/lists/custom, и его запись в uci
# разошлись бы при первом же `rm`. Плюс так происхождение переживает то же, что и сам
# список, и теряется вместе с ним, а не отдельно.
#
# ФОРМАТ — «ключ=значение» по строке, как у SUB_INFO: разбирается тем же `while read`, а
# вторая реализация разбора JSON в оболочке не нужна ни здесь, ни там.
#
# Расширение НЕ «.lst»: `local_lists` и сборка архива обходят каталог по `*.lst`, и файл
# происхождения, попавший в эту выборку, стал бы виден как ещё один список — с записями
# вида «source=file», которые санитайзер отбросит все до одной.
custom_meta_path() {  # ИМЯ ВИД
    printf '%s.src' "$(custom_path "$1" "$2")"
}

# Запомнить происхождение. Пустые значения пишутся тоже: «файл выбран, а имени его мы не
# знаем» — это не то же, что «происхождение неизвестно», и различать их надо.
custom_meta_put() {  # ИМЯ ВИД ИСТОЧНИК ССЫЛКА ИМЯ_ФАЙЛА
    _cm="$(custom_meta_path "$1" "$2")"
    mkdir -p "$(dirname "$_cm")"
    {
        printf 'source=%s\n' "$3"
        printf 'url=%s\n' "$4"
        printf 'file=%s\n' "$5"
        printf 'at=%s\n' "$(date +%s)"
    } > "$_cm.tmp" && mv "$_cm.tmp" "$_cm"
}

# Прочитать происхождение в CM_SOURCE / CM_URL / CM_FILE / CM_AT.
#
# Файла нет — CM_SOURCE остаётся пустым, и это законное состояние, а не поломка: так
# выглядят списки, заведённые до появления этого файла, положенные в каталог руками и
# вернувшиеся из архива настроек (архив происхождения не носит — см. backup_build).
# Интерфейс тогда предлагает все три способа, как предлагал всегда.
custom_meta_get() {  # ИМЯ ВИД
    CM_SOURCE=""; CM_URL=""; CM_FILE=""; CM_AT=""
    _cm="$(custom_meta_path "$1" "$2")"
    [ -s "$_cm" ] || return 1
    while IFS='=' read -r _k _v; do
        case "$_k" in
            source) CM_SOURCE="$_v" ;;
            url)    CM_URL="$_v" ;;
            file)   CM_FILE="$_v" ;;
            at)     CM_AT="$_v" ;;
        esac
    done < "$_cm"
    [ -n "$CM_SOURCE" ]
}

# Чужой текст на входе движка. Проверяется ЗДЕСЬ, а не в интерфейсе: интерфейс можно
# обойти, а последствие непроверенного списка молчаливое — спека применится, nft отвергнет
# набор, и канал останется пустым без единого слова о причине.
#
# Что делаем с почти-верным: одиночный адрес дополняем до /32 (человек пишет 1.2.3.4, имея
# в виду именно его), домены приводим к нижнему регистру и снимаем ведущее «*.» — то есть
# принимаем распространённые записи вместо того, чтобы отвергать их из принципа. Что
# отбросили — считаем и говорим числом: молчаливая потеря строк здесь была бы худшим из
# возможных поведений.
sanitize_list() {  # ВИД ВХОД ВЫХОД ФАЙЛ_СЧЁТЧИКОВ
    awk -v kind="$1" -v stat="$4" '
    # Октет 0..255 и длина префикса 0..32 — то, чего не выражает регулярное выражение.
    function ip_ok(a,   p, i) {
        split(a, p, ".")
        for (i = 1; i <= 4; i++) if (p[i] + 0 > 255 || p[i] == "" || length(p[i]) > 3) return 0
        return 1
    }
    function cidr_ok(a,   q) {
        split(a, q, "/")
        if (!ip_ok(q[1])) return 0
        return (q[2] + 0 <= 32 && q[2] != "" && length(q[2]) <= 2)
    }
    {
        line = $0
        sub(/\r$/, "", line)
        sub(/#.*/, "", line)
        gsub(/^[ \t]+|[ \t]+$/, "", line)
        if (line == "") next
        if (kind == "prefixes") {
            # Проверяются и ДИАПАЗОНЫ значений, а не только форма. Раньше «10.0.0.256» и
            # «192.168.0.0/40» проходили как верные, движок их тоже пропускает (он смотрит
            # только на цифры, точки и слэши), и отвергал их уже nft — целиком весь
            # ruleset одной транзакцией, сообщением про синтаксис nft. Человек при этом
            # видел «Список «x»: строк 12» и не знал, какая строка виновата.
            if (line ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/)         { if (ip_ok(line))       { print line "/32"; ok++; next } bad++; next }
            if (line ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+\/[0-9]+$/) { if (cidr_ok(line))     { print line;       ok++; next } bad++; next }
            bad++; next
        }
        line = tolower(line)
        sub(/^\*\./, "", line)
        sub(/\.$/, "", line)
        if (line ~ /^[a-z0-9]([a-z0-9._-]*[a-z0-9])?$/ && line ~ /\./) { print line; ok++; next }
        bad++
    }
    END { printf "%d %d\n", ok+0, bad+0 > stat }
    ' "$2" > "$3"
}

# ---- архив настроек: экспорт и восстановление (R-005) -------------------------
#
# Что уезжает в архив: спека (/etc/steer/spec.json), подписка (/etc/steer/sub.txt), СВОИ
# списки (/etc/steer/lists/custom/**) и те поля uci, без которых восстановленная настройка
# неполна — адрес подписки, её вид и память мастера.
#
# Чего в архиве нет ещё: ПРОИСХОЖДЕНИЯ своих списков (файлы `<список>.lst.src`, см.
# custom_meta_path). Причина — формат: разборщик присланного файла строгий и отвергает
# незнакомый раздел целиком, поэтому новый раздел сделал бы новые архивы нечитаемыми для уже
# установленных версий, а цена этого выше пользы. Восстановленный список поэтому приезжает без
# происхождения, то есть с «неизвестно», и интерфейс предлагает для него все три способа
# правки — ровно как для списков, заведённых до появления этой записи.
#
# Чего в архиве НЕТ и не будет: зеркал категорий издателя в /etc/steer/lists (на стенде
# 43 файла, 284 КБ — измерено в I-037). Это не настройка, а копия того, что публикуется
# upstream: одинакова у всех, обновляется суточным cron и доскачивается сама перед каждой
# проверкой спеки (fetch_missing_lists). Носить её между роутерами значило бы возить
# 284 КБ, которые роутер всё равно возьмёт сам, да ещё и в виде заведомо устаревающего
# среза чужих данных. Свои списки — обратный случай: их не публикует никто, кроме самого
# человека, поэтому без них архив бесполезен.
#
# Формат — строчный, с разделами в квадратных скобках, а не один JSON. Причина
# практическая: разбирать присланный файл приходится ЗДЕСЬ, в shell, и построчный разбор
# в awk можно прочитать глазами, а вторая реализация разбора JSON в оболочке — нет.
# Содержимое разделов при этом дословное: спека внутри остаётся спекой, список — списком,
# файл читается и правится любым редактором. Строка, которую понимает разборщик как
# заголовок, в валидном JSON и в списке доменов встретиться не может — `[spec]` не JSON,
# а `[options]` не имя домена, — поэтому неоднозначности разделов не возникает.
BACKUP_FORMAT=1
# Через ubus одним куском едет только то, что заведомо влезает: тот же порядок величины,
# что у порций своего списка (CustomLists шлёт по 1000 строк ≈ 20 КБ). Остальное — по
# кускам, как файл списка. Куски нарезаются ПО БАЙТАМ, а не по строкам: подписка бывает
# одним base64-блоком в одну строку, и по строкам такой файл не режется вовсе.
BACKUP_CHUNK=16384
# Пределы недоверенного ввода. Проверяются ДО записи чего бы то ни было: overlay на
# роутере из отчётов теста — 6,9 МБ, и «принять, а посмотреть потом» здесь означает
# забитый флеш, после которого не пишется ни спека, ни журнал.
# Предел на весь архив — шов, как пути выше: стенду надо проверить, что предел считается
# по НАКОПЛЕННОМУ, а не по куску, и генерировать для этого четверть мегабайта JSON было бы
# проверкой размера файла с фикстурой, а не проверкой логики. rpcd запускает объект с
# чистым окружением, так что на роутере ветка `:-` не выбирается никогда.
# Предел на весь архив. Два мегабайта, а не «сколько-нибудь разумно для настроек»: свой
# список сам по себе разрешён размером до LIST_MAX_BYTES (1 МБ), и предел на архив ниже
# этого числа означал бы настройку, которую МОЖНО завести, но НЕЛЬЗЯ вернуть из бекапа.
# Накопленный архив живёт в /tmp, то есть в оперативной памяти, а не на overlay.
BACKUP_MAX_BYTES="${BACKUP_MAX_BYTES:-2097152}"
BACKUP_SPEC_MAX=65536
BACKUP_SUB_MAX=131072
BACKUP_OPT_MAX=8192
# Швы ради стенда, как JSHN_SH: на роутере ветка `:-` не выбирается никогда.
BACKUP_OUT="${BACKUP_OUT:-/tmp/splify2-backup.out}"
BACKUP_IN="${BACKUP_IN:-/tmp/splify2-backup.in}"

# Строка, которая станет словом shell или частью имени: имена устройств, выходов и
# каналов. Проверяется потому, что импорт делает спеку МЕНЕЕ доверенным источником, а на
# том конце её строки попадают в командные строки: движок подставляет lan_device в
# popen("ip -4 -o addr show ...") без фильтрации (I-003), а этот самый скрипт подставляет
# имена выходов vless в `ubus call service signal {"instance":"vless_$o"}`, а имена их
# устройств — в настройку зоны фаервола (fw_sync). Пока спеку писал только root через
# spec_set, это была теоретическая
# слабость; принятый файл делает её входом.
backup_safe_word() {  # СТРОКА
    case "$1" in
        '') return 1 ;;
        *[!A-Za-z0-9_.:@-]*) return 1 ;;
    esac
    return 0
}

# Путь внутри каталогов настроек — и никуда больше. Спека несёт пути к файлам списков и к
# файлу подписки, то есть присланный файл может попросить движок читать что угодно
# («отсутствие путей за пределы каталогов настроек»). Правило то же, что у local_path для
# путей от издателя: только под $LISTS (или ровно $SUB) и без '..' в любом виде.
backup_safe_path() {  # ПУТЬ
    case "$1" in
        *..*) return 1 ;;
    esac
    case "$1" in
        "$SUB") return 0 ;;
        "$LISTS"/*) return 0 ;;
    esac
    return 1
}

# Собрать архив в stdout.
backup_build() {
    printf 'splify2-backup %s\n' "$BACKUP_FORMAT"
    printf '# Настройки splify2: спека, подписка, свои списки, поля uci.\n'
    printf '# Восстанавливается тем же интерфейсом. Зеркал категорий издателя здесь нет:\n'
    printf '# роутер скачивает их сам, они одинаковы у всех и обновляются по расписанию.\n'
    printf '# ВНИМАНИЕ: внутри ссылки vless:// с ключами. Файл секретен, как пароль.\n'
    if [ -s "$SPEC" ]; then
        printf '[spec]\n'
        # awk 1, а не cat: файл без завершающего перевода строки склеил бы свою последнюю
        # строку с заголовком следующего раздела.
        awk 1 "$SPEC"
    fi
    if [ -s "$SUB" ]; then
        printf '[sub]\n'
        awk 1 "$SUB"
    fi
    for f in "$LISTS/$CUSTOM"/*.lst "$LISTS/$CUSTOM"/domains/*.lst; do
        [ -f "$f" ] || continue
        n="${f##*/}"; n="${n%.lst}"
        # Имя проверяется и на выходе: в каталог мог положить файл не интерфейс, а руки,
        # и тогда заголовок раздела получился бы таким, какой сам же разборщик отвергнет.
        case "$n" in ''|*[!A-Za-z0-9_-]*) continue ;; esac
        case "$f" in *"/$CUSTOM/domains/"*) printf '[list domains %s]\n' "$n" ;;
                     *) printf '[list prefixes %s]\n' "$n" ;; esac
        awk 1 "$f"
    done
    printf '[options]\n'
    for k in sub_url sub_kind wizard; do
        v="$(uci -q get "splify2.main.$k")"
        [ -n "$v" ] && printf '%s=%s\n' "$k" "$v"
    done
    return 0
}

# Разложить присланный файл по разделам в каталог-песочницу. Печатает причину и
# возвращает 1 на негодном файле.
#
# Разбор строгий и с отказом, а не «что понял — то и взял»: непонятный раздел означает
# либо чужой формат, либо файл от версии, которой этот интерфейс не знает, и в обоих
# случаях молча восстановить половину хуже, чем не восстановить ничего. Имена файлов в
# песочнице собираются ЗДЕСЬ из проверенных регулярным выражением частей — из присланного
# файла ни один путь не берётся.
backup_split() {  # ФАЙЛ КАТАЛОГ
    awk -v dir="$2" -v ver="$BACKUP_FORMAT" '
    NR == 1 {
        if ($0 !~ /^splify2-backup [0-9]+$/) { print "это не файл настроек splify2"; exit 1 }
        if ($2 != ver) { print "файл версии " $2 ", этот интерфейс понимает " ver; exit 1 }
        next
    }
    /^#/ { next }
    /^\[/ {
        if ($0 == "[spec]")         { cur = dir "/spec" }
        else if ($0 == "[sub]")     { cur = dir "/sub" }
        else if ($0 == "[options]") { cur = dir "/options" }
        else if ($0 ~ /^\[list (domains|prefixes) [A-Za-z0-9_-]+\]$/) {
            split(substr($0, 2, length($0) - 2), p, " ")
            cur = dir "/list." p[2] "." p[3]
        }
        else { print "непонятный раздел: " substr($0, 1, 40); exit 1 }
        if (seen[cur]++) { print "раздел повторяется: " substr($0, 1, 40); exit 1 }
        printf "" > cur
        next
    }
    {
        if (cur == "") {
            if ($0 ~ /^[ \t]*$/) next
            print "строка вне раздела: " substr($0, 1, 40)
            exit 1
        }
        print > cur
    }
    ' "$1"
}

# ПОРЯДОК ПЕРЕНАПРАВЛЕНИЙ У `wc -c`. Ниже везде `wc -c 2>/dev/null < файл`, а не
# `wc -c < файл 2>/dev/null`, и это не вкус.
#
# Оболочка применяет перенаправления СЛЕВА НАПРАВО и делает это САМА, до запуска команды.
# В написании `< файл 2>/dev/null` отсутствующий файл разбирается тогда, когда stderr ещё
# свой, — и жалобу печатает оболочка, а не `wc`: «cannot open …». Проверено опытом: первая
# форма молчит, вторая говорит вслух.
#
# Куда попадает эта строка. Метод rpcd отвечает СТАНДАРТНЫМ ВЫВОДОМ, и жалоба уезжает
# рядом с ответом — в журнал rpcd, а на части сборок и клиенту, который ждёт JSON.
# Значение при этом уцелело бы (`|| echo 0`), поэтому находка и прожила долго: ответ верный,
# а рядом мусор, которого никто не искал.
#
# Там, где `|| echo 0` не было вовсе (sub_info, backup_get, backup_put), цена выше: между
# проверкой существования и чтением файл может исчезнуть, и тогда в `json_add_int` уезжает
# ПУСТАЯ строка — то есть уже не мусор рядом с ответом, а битый JSON вместо ответа.
#
# Вторая половина той же находки (I-085) — `: > файл` в несуществующем каталоге, которое
# завершает ash целиком, — закрыта раньше: файл настройки заводит uci_file, и стенд следит,
# чтобы перенаправление не вернулось.

# Спека из архива. Судья по-прежнему компилятор движка (--dry-run), но ДО него проверяется
# то, о чём компилятор не знает: размер, экранированные управляющие символы, набор
# символов в именах и пути, уходящие за каталоги настроек.
backup_check_spec() {  # ФАЙЛ
    sz="$(wc -c 2>/dev/null < "$1" || echo 0)"
    [ "$sz" -le "$BACKUP_SPEC_MAX" ] || { echo "спека больше $((BACKUP_SPEC_MAX / 1024)) КБ"; return 1; }
    # Экранированный перевод строки внутри строки JSON — не опечатка, а способ разложить
    # одно значение на две строки там, где строки читаются по одной (jsonfilter печатает
    # по совпадению на строку, и оболочка режет вывод по строкам). Интерфейс таких
    # значений не пишет: в спеке нет ни одного поля, где перевод строки был бы осмыслен.
    if grep -q '\\[nrtu]' "$1"; then
        echo "в спеке экранированные управляющие символы — так интерфейс не пишет"
        return 1
    fi
    json_load "$(cat "$1")" 2>/dev/null || { echo "спека не разбирается как JSON"; return 1; }
    # Переменные обнуляются ПЕРЕД каждым чтением: json_get_var на отсутствующем ключе
    # оставляет прежнее значение, и без этого выход без device унаследовал бы device
    # предыдущего — то есть проверка смотрела бы не на то, что проверяет.
    lan=''
    json_get_var lan lan_device
    if [ -n "$lan" ] && ! backup_safe_word "$lan"; then
        echo "lan_device «$lan»: имя устройства так не выглядит"
        return 1
    fi
    # Множественная форма того же поля (splify2#16). Проверять только одиночную значило бы
    # оставить дыру ровно того вида, ради которого проверка и написана: поле в спеке новое,
    # проверка старая, и недоверенный архив снова проезжает в командную строку. Имя отсюда
    # уходит и в текст правил nftables, и в командные строки движка.
    if json_select lan_devices 2>/dev/null; then
        json_get_keys lan_idx
        for i in $lan_idx; do
            lan=''
            json_get_var lan "$i"
            if [ -n "$lan" ] && ! backup_safe_word "$lan"; then
                echo "lan_devices «$lan»: имя устройства так не выглядит"
                json_select ..
                return 1
            fi
        done
        json_select ..
    fi
    if json_select outputs 2>/dev/null; then
        json_get_keys onames
        for o in $onames; do
            # Проверка двойная, и вторая половина не лишняя: имена приезжают из
            # json_get_keys одной строкой через пробел, поэтому имя С ПРОБЕЛОМ приехало
            # бы двумя годными на вид словами. Такого ключа в объекте нет, значит
            # json_select по нему не пройдёт — и файл будет отвергнут.
            backup_safe_word "$o" || { echo "имя выхода «$o» — только латиница, цифры, точка, двоеточие, дефис"; return 1; }
            json_select "$o" 2>/dev/null || { echo "имя выхода «$o» не читается как ключ — пробел или кавычка внутри?"; return 1; }
            dev=''; sf=''
            json_get_var dev device
            if [ -n "$dev" ] && ! backup_safe_word "$dev"; then
                echo "устройство «$dev» у выхода $o: так имя устройства не выглядит"
                return 1
            fi
            json_get_var sf sub_file
            if [ -n "$sf" ] && ! backup_safe_path "$sf"; then
                echo "файл подписки «$sf» у выхода $o лежит вне каталогов настроек"
                return 1
            fi
            json_select ..
        done
        json_select ..
    fi
    # Каналы — массивом, поэтому через jsonfilter, а не через jshn: у него для массивов
    # своя нумерация ключей, и полагаться на неё в проверке недоверенного ввода незачем.
    for v in $(jsonfilter -i "$1" -e '@.channels[*].name' -e '@.channels[*].out' 2>/dev/null); do
        backup_safe_word "$v" || { echo "«$v» в канале — только латиница, цифры, точка, двоеточие, дефис"; return 1; }
    done
    # Оба написания списочных полей: короткое документировано контрактом v1 и движком
    # реализовано (см. normalizeSpec в интерфейсе), значит присланный файл вправе его
    # содержать — и проверять его надо тоже.
    for p in $(jsonfilter -i "$1" \
        -e '@.channels[*].match.prefixes_files[*]' -e '@.channels[*].match.domains_files[*]' \
        -e '@.channels[*].match.prefixes_file'    -e '@.channels[*].match.domains_file' 2>/dev/null); do
        backup_safe_path "$p" || { echo "список «$p» лежит вне каталога списков"; return 1; }
    done
    return 0
}

# Подписка из архива: либо ссылки vless:// по строке, либо один блок base64 (подписка
# ровно так и приезжает от провайдера). Файл читает движок, разбор base64 у него свой —
# здесь проверяется только то, что это вообще похоже на подписку, а не на что-то ещё.
backup_check_sub() {  # ФАЙЛ
    sz="$(wc -c 2>/dev/null < "$1" || echo 0)"
    [ "$sz" -le "$BACKUP_SUB_MAX" ] || { echo "подписка больше $((BACKUP_SUB_MAX / 1024)) КБ"; return 1; }
    lines="$(grep -c "[^[:space:]]" "$1")"
    [ "$lines" -gt 0 ] || { echo "раздел подписки пуст"; return 1; }
    [ "$(grep -c '^vless://' "$1")" = "$lines" ] && return 0
    grep -qvE '^[A-Za-z0-9+/=]*$' "$1" || return 0
    echo "подписка: ждём строки vless:// или один блок base64"
    return 1
}

# Поля uci. Ключи — по белому списку: непонятное поле здесь означало бы, что архив
# принесён из другой версии и его смысл нам неизвестен.
backup_check_options() {  # ФАЙЛ
    sz="$(wc -c 2>/dev/null < "$1" || echo 0)"
    [ "$sz" -le "$BACKUP_OPT_MAX" ] || { echo "раздел настроек больше $((BACKUP_OPT_MAX / 1024)) КБ"; return 1; }
    while IFS= read -r ln; do
        [ -n "$ln" ] || continue
        k="${ln%%=*}"; v="${ln#*=}"
        case "$k" in
            sub_url)
                case "$v" in http://*|https://*) ;; *) echo "sub_url: нужна ссылка http:// или https://"; return 1 ;; esac
                # Ссылка уезжает в uci и оттуда в командную строку загрузчика. Пробелы,
                # кавычки и подстановки в ней не значат ничего хорошего ни в одном из
                # этих мест.
                case "$v" in *[\ \"\'\`\$\;\|\&\<\>]*) echo "sub_url: недопустимые символы в ссылке"; return 1 ;; esac
                ;;
            sub_kind)
                case "$v" in url|links|none) ;; *) echo "sub_kind: ждём url, links или none"; return 1 ;; esac
                ;;
            wizard) ;;
            *) echo "непонятная настройка: $k"; return 1 ;;
        esac
    done < "$1"
    return 0
}

# Отказ с уборкой за собой: развёрнутый архив и накопленный файл убираются, причина уезжает
# человеку. Отдельной функцией потому, что проверок восемь, и «забыть убрать» в одной из них
# означало бы файл в /tmp, переживший отказ.
backup_giveup() {  # ПРИЧИНА
    rm -rf "$D"
    rm -f "$BACKUP_IN"
    fail "$1"
}

# Включён ли автозапуск. Именно это, а не «работает ли», меняет кнопка «Остановить всё»:
# без снятого автозапуска перезагрузка вернула бы движок, и человек, нажавший «остановить
# всё», получил бы его обратно молча.
engine_enabled() {
    "$INITD" enabled >/dev/null 2>&1 && printf 1 || printf 0
}

# Работает ли хоть один экземпляр. Спрашивается у procd, а не по наличию процесса:
# у движка их несколько (сам steer и клиенты vless), и «жив ли процесс с таким именем»
# на это не отвечает.
#
# ВНИМАНИЕ: внутри json_load, поэтому вызывать только ДО json_init своего ответа — тот же
# порядок, что уже соблюдает engine_state.
engine_running() {
    r=0
    state="$(ubus call service list '{"name":"steer","verbose":true}' 2>/dev/null)"
    if [ -n "$state" ] && json_load "$state" 2>/dev/null &&
       json_select steer 2>/dev/null && json_select instances 2>/dev/null; then
        json_get_keys inames
        for nm in $inames; do
            json_select "$nm" 2>/dev/null || continue
            json_get_var run running
            [ "$run" = 1 ] && r=1
            json_select ..
        done
    fi
    printf '%s' "$r"
}

case "$1" in
list)
    json_init
    json_add_object status; json_close_object
    # Круг опроса одним вызовом. `diag` — по просьбе: проверки движка стоят вдвое дороже
    # состояния и меняются реже, поэтому спрашивает их страница, а не мы решаем за неё.
    #
    # `fast` — по той же логике и с тем же доводом: движок помнит свой последний полный ответ
    # и умеет отдать запомненное немедленно, а решать, когда память годится вместо измерения,
    # обязан спрашивающий. Страница просит её ровно на первом круге, чтобы нарисовать экран
    # без ожидания, и тут же идёт вторым кругом за свежим. Ответ на быстрый круг несёт
    # `status.cached` и `status.at` — по ним видно, что это память и какой она давности.
    json_add_object live; json_add_boolean diag; json_add_boolean fast; json_close_object
    json_add_object spec_get; json_close_object
    json_add_object applied_get; json_close_object
    json_add_object spec_set; json_add_string spec; json_close_object
    json_add_object apply; json_close_object
    json_add_object explain; json_add_string address; json_close_object
    json_add_object lists; json_close_object
    # kind объявлен обязательно, хотя реализация его читала и раньше: rpcd отсекает
    # поля, которых нет в сигнатуре, и без него доменный запрос уходил бы в фолбэк
    # manifest_file, где адресные категории проверяются ПЕРВЫМИ. У издателя `news` и
    # `hodca` есть в обоих пространствах имён, так что доменный запрос скачивал бы
    # адресный файл в news.lst — при том что правило ждёт domains/news.lst. Ответ при
    # этом ok, а падает потом apply, далеко от причины. Это дословно I-011, для
    # list_remove ниже сигнатуру расширили, а здесь забыли.
    json_add_object list_fetch; json_add_string id; json_add_string kind; json_close_object
    json_add_object devices; json_close_object
    # Сети клиентов — противоположный вопрос к `devices`: не куда выпустить трафик, а
    # откуда он приходит (splify2#16).
    json_add_object client_nets; json_close_object
    json_add_object local_lists; json_close_object
    json_add_object lists_update; json_close_object
    json_add_object list_remove
        json_add_string id; json_add_string kind; json_add_string name
    json_close_object
    json_add_object list_put
        json_add_string name; json_add_string kind
        json_add_string text; json_add_string url; json_add_boolean append
        # Откуда список и как он назывался у человека. Нужно правке: у файла меняют файл,
        # у ссылки — ссылку, у набранного руками — сами записи (см. custom_meta_path).
        json_add_string source; json_add_string filename
    json_close_object
    # Чем список стал на диске и откуда он взялся — для правки. Отдельным методом, а не
    # полем local_lists: тот считается awk-ом по всему каталогу и зовётся на каждое открытие
    # настроек, а происхождение нужно только своим спискам и только когда их правят.
    json_add_object list_custom; json_close_object
    # Записи списка обратно, порциями: редактор набранного руками должен показать то, что
    # лежит на роутере, а не пустое поле.
    json_add_object list_get
        json_add_string name; json_add_string kind; json_add_int offset
    json_close_object
    json_add_object engine; json_close_object
    # `name` — какая из подписок. Поля нет — первая (main), и это же значение приходит от
    # интерфейсов, которые про несколько подписок ещё не знают.
    json_add_object sub_set
        json_add_string url; json_add_string name; json_add_string title
    json_close_object
    json_add_object sub_info; json_add_string name; json_close_object
    json_add_object sub_list; json_close_object
    json_add_object sub_del; json_add_string name; json_close_object
    # Ссылку метод берёт из uci — второй источник той же ссылки означал бы, что остаток
    # можно спросить у панели, которой роутер не пользуется.
    json_add_object sub_quota; json_add_string name; json_close_object
    # Архив настроек. offset/append/final — куски: ubus не резиновый, и целиком архив в
    # одно сообщение не влезает (тот же довод, что у порций list_put).
    #
    # append и final объявлены БУЛЕВЫМИ, значит и приезжать обязаны булевыми: blobmsg_parse
    # молча отбрасывает атрибут, тип которого не совпал с политикой, и число 1 здесь дошло бы
    # до скрипта как отсутствующее поле — то есть каждый кусок замещал бы предыдущий, а
    # последний не запускал бы восстановление вовсе. Ровно это уже случилось с list_put.
    json_add_object backup_get; json_add_int offset; json_close_object
    json_add_object backup_put
        json_add_string text; json_add_boolean append; json_add_boolean final
    json_close_object
    json_add_object dev_stats; json_close_object
    json_add_object diag; json_close_object
    json_add_object net_info; json_close_object
    json_add_object outbound_probe; json_add_string output; json_close_object
    json_add_object outbound_geo
        json_add_string output; json_add_boolean fresh
    json_close_object
    json_add_object leases; json_close_object
    json_add_object engine_state; json_close_object
    json_add_object ui_get; json_close_object
    json_add_object ui_set; json_add_string state; json_close_object
    json_add_object xsteer_state; json_close_object
    json_add_object xsteer_link
        json_add_string iface; json_add_string link
    json_close_object
    json_add_object xsteer_link_put
        json_add_string iface; json_add_string link
    json_close_object
    json_add_object zm_fix; json_close_object
    json_add_object zm_fix_set; json_add_boolean on; json_close_object
    # ---- DNS over HTTPS ----
    json_add_object doh_state; json_close_object
    json_add_object doh_set; json_add_string provider; json_close_object
    json_add_object doh_off; json_close_object
    json_add_object doh_tunnel_set; json_add_boolean on; json_close_object
    # ---- обход DPI ----
    json_add_object zapret_state; json_close_object
    json_add_object zapret_install; json_close_object
    json_add_object zapret_remove; json_close_object
    json_add_object zapret_sync; json_close_object
    json_add_object zapret_strategies; json_close_object
    # `out` — какому выходу kind=zapret. Пусто означает «всему роутеру», то есть
    # /etc/config/zapret: это два разных места применения одной и той же стратегии, и
    # различать их полем дешевле, чем двумя методами с одинаковым телом.
    json_add_object zapret_apply; json_add_string name; json_add_string out; json_close_object
    json_add_object zapret_test_start; json_add_string scope; json_close_object
    json_add_object zapret_test_stop; json_close_object
    # Ход проверки отдельным методом, а не полем zapret_state: состояние спрашивает пакетный
    # менеджер про версию (это десятки миллисекунд), а ход опрашивают раз в две секунды,
    # пока проверка идёт. Один метод на оба означал бы плату за версию на каждом опросе.
    json_add_object zapret_test; json_close_object
    # Результаты отдаются ДОСЛОВНО тем файлом, который написала проверка. Пересобирать их
    # здесь через jshn значило бы разбирать и собирать пятьдесят объектов на каждый запрос
    # ради того же самого JSON — тот же довод, по которому `status` движка отдаётся как есть.
    json_add_object zapret_results; json_close_object
    json_add_object fetch_mode; json_close_object
    json_add_object fetch_mode_set; json_add_string mode; json_close_object
    json_add_object vless_nodes; json_add_string output; json_close_object
    json_add_object vless_probe
        json_add_string output; json_add_int node
    json_close_object
    json_add_object engine_stop; json_close_object
    json_add_object engine_start; json_close_object
    json_add_object splify2_versions; json_close_object
    json_add_object splify2_install; json_add_string version; json_close_object
    json_add_object steer_versions; json_close_object
    json_add_object steer_install
        json_add_string version; json_add_boolean extended
    json_close_object
    json_dump
    ;;
call)
    case "$2" in
    status)
        # Движок печатает JSON сам. Если он не отвечает — честная ошибка, а не пустой
        # объект, который интерфейс покажет как «всё в порядке».
        out="$("$STEER" status --spec "$SPEC" 2>/dev/null)"
        case "$out" in '{'*) printf '%s\n' "$out" ;; *) fail "движок не ответил" ;; esac
        ;;

    spec_get)
        # Сюда доходит только вызов в обход быстрого пути (см. первые строки файла): тем же
        # кодом, а не вторым — две копии чтения спеки разошлись бы молча.
        . "${FAST_SH:-/usr/lib/splify2/fast.sh}"
        fast_spec_get
        ;;

    applied_get)
        . "${FAST_SH:-/usr/lib/splify2/fast.sh}"
        fast_applied_get
        ;;

    spec_set)
        read -r input
        json_load "$input" 2>/dev/null || fail "неразбираемый запрос"
        json_get_var spec spec
        [ -n "$spec" ] || fail "пустая спецификация"
        # Временный файл РЯДОМ с целевым, а не в /tmp, и это не мелочь. /tmp на OpenWrt —
        # tmpfs, а спека лежит на overlay; mv между разными файловыми системами busybox
        # делает копированием с удалением, а не rename(). Значит подмена НЕ атомарна:
        # обрыв на середине (кончился overlay — а он 6,9 МБ) оставлял на месте рабочей
        # спеки обрубок, и интерфейс при этом отвечал «Сохранено». Внутри одной ФС mv —
        # это rename, то есть либо старый файл, либо новый, третьего не бывает.
        # Ровно так уже сделано в download() выше, по той же причине.
        mkdir -p "$(dirname "$SPEC")"
        tmp="$SPEC.new.$$"
        printf '%s' "$spec" > "$tmp" || { rm -f "$tmp"; fail "не удалось записать спецификацию — кончилось место?"; }
        # Списки, на которые ссылается ПРИСЛАННАЯ спека, доскачиваем ДО проверки: движок
        # умирает на отсутствующем файле, и без этого выбор нового сервиса не сохранялся вовсе
        # (см. fetch_missing_lists). Предупреждения о нескачанном не отменяют сохранение —
        # спека с недоступным списком остаётся верной, просто её канал не поднимется.
        set_warn="$(fetch_missing_lists "$tmp")"
        # Компилятор — единственный судья: он же будет это применять. Проверка до
        # записи означает, что на диске не окажется спеки, которую движок отвергнет
        # при следующей загрузке.
        if ! err="$("$STEER" apply --dry-run --spec "$tmp" 2>&1 >/dev/null)"; then
            rm -f "$tmp"
            # Если список не скачался, ПРИЧИНА в этом, и её надо назвать первой. Сообщение
            # движка называет следствие — «cannot read a channel's list» — и отправляет
            # человека искать испорченный файл, которого никогда не было на диске. Проверено:
            # при недоступном списке ответ был ровно таким, без единого слова о загрузке.
            fail "${set_warn:+$set_warn; }${err:-движок отверг спецификацию}"
        fi
        # Сравниваем ДО подмены: после неё старого отпечатка уже не узнать.
        before="$(vless_fingerprint "$SPEC")"
        after="$(vless_fingerprint "$tmp")"
        # Обфускация: важно не только «изменилось», но и «изменился ли НАБОР выходов».
        # Смена адреса сервера лечится сигналом живому экземпляру, а появление нового
        # выхода с obfs — нет: экземпляра ещё не существует, и сигнал уходить некому.
        # Такой выход выглядел бы настроенным и молча не работал бы до перезагрузки.
        obfs_before="$(obfs_fingerprint "$SPEC")"
        obfs_after="$(obfs_fingerprint "$tmp")"
        obfs_before_n="$(obfs_names "$SPEC")"
        obfs_after_n="$(obfs_names "$tmp")"
        vless_before_n="$(vless_names "$SPEC")"
        vless_after_n="$(vless_names "$tmp")"
        # Код возврата mv проверяется: без этого «Сохранено» печаталось независимо от
        # того, легла спека на диск или нет.
        mv "$tmp" "$SPEC" || { rm -f "$tmp"; fail "не удалось заменить спецификацию"; }
        # Признак пишется СЛОВОМ, как у обфускации, а не пустым файлом: экземпляру,
        # которого ещё нет, сигналить некому — см. развёрнутое объяснение в ветке apply.
        # Помета ДОБАВЛЯЕТСЯ к уже накопленным, а не заменяет их (см. dirty_mark).
        # Развилка внутри одного сохранения при этом остаётся прежней: смена НАБОРА не
        # сигналит живым туннелям, иначе добавление второго выхода перезапускало бы
        # первый — а это смена выходного адреса, которой никто не просил.
        if [ "$vless_before_n" != "$vless_after_n" ]; then
            dirty_mark "$VLESS_DIRTY" instances
        elif [ "$before" != "$after" ]; then
            dirty_mark "$VLESS_DIRTY" params
        fi
        if [ "$obfs_before" != "$obfs_after" ]; then
            if [ "$obfs_before_n" != "$obfs_after_n" ]; then
                dirty_mark "$OBFS_DIRTY" instances
            else
                dirty_mark "$OBFS_DIRTY" params
            fi
        fi
        # Предупреждение о нескачанном списке едет В ОТВЕТЕ, а не в журнал: сохранение
        # прошло, спека верна, но канал, ссылающийся на недоступный список, не поднимется —
        # и узнать об этом человек должен там же, где нажимал, а не догадываться позже по
        # неработающему каналу.
        json_init; json_add_boolean ok 1
        [ -n "$set_warn" ] && json_add_string warn "$set_warn"
        json_dump
        ;;

    apply)
        # Зона туннельных устройств приводится в порядок ДО apply: иначе первый же прогон
        # объявит, что устройство никому не известно, и будет прав. Синхронизация в обе
        # стороны — добавить появившееся и убрать ушедшее вместе с самой зоной, когда
        # туннельных выходов не осталось (см. fw_sync).
        zone_msg="$(fw_sync 2>&1)"
        # То же доскачивание, что и при сохранении: спеку могли положить на диск в обход
        # интерфейса (splify2 spec_set — не единственный способ), да и файл мог быть удалён
        # уборкой между сохранением и применением.
        fetch_warn="$(fetch_missing_lists "$SPEC")"

        # Фикс Zapret Manager версии 1.2.3 жил правилом в спеке — убираем его оттуда, если
        # он там остался: теперь фикс касается только самого роутера (см. zm_rules_sync).
        zm_drop_channel || true
        out="$("$STEER" apply --spec "$SPEC" 2>&1)"; rc=$?
        # Снимок — только на успехе: неудавшийся apply ничего не изменил в ядре, и счётчик
        # обязан продолжать это показывать.
        [ "$rc" -eq 0 ] && cp "$SPEC" "$APPLIED" 2>/dev/null
        # Свои таблицы собираются ПОСЛЕ движка: тот сносит и ставит свою заново, а наши
        # ссылаются на его метку — до его применения ссылаться было бы не на что. Обе рядом
        # потому, что делают одно и то же для двух разных поводов (фикс GitHub и DoH), и
        # забыть одну из них при правке apply — самый простой способ выкатить настройку,
        # которая включена в интерфейсе и не действует.
        zm_rules_sync
        doh_rules_sync
        # И третье, из той же семьи: force_dns у https-dns-proxy обязан согласиться с тем,
        # нужен ли движку свой резолвер. Ровно здесь, потому что ровно здесь доменные каналы
        # появляются и исчезают, а два перенаправления порта 53 в одной точке дают гонку, из
        # которой проигравший выходит молча (см. doh_force_sync).
        doh_force_sync
        [ -n "$fetch_warn" ] && out="$fetch_warn
$out"
        [ -n "$zone_msg" ] && out="$zone_msg
$out"

        # Клиент VLESS читает спеку и подписку ОДИН РАЗ при старте, поэтому смена узла или
        # подписки без перезапуска не значит ничего: в интерфейсе выбрано новое, в туннеле
        # работает старое, и понять это невозможно. Перезапускаем — но только когда
        # изменилось именно это, иначе правка любого списка роняла бы соединения через
        # туннель и меняла выходной адрес.
        if [ -f "$VLESS_DIRTY" ]; then
            # Два повода с разной ценой — ровно как у обфускации ниже, и раньше здесь был
            # только второй:
            #
            #   instances — набор выходов vless изменился (выход появился, исчез или его
            #               переименовали, а имя экземпляра это `vless_<выход>`).
            #               Экземпляра для нового выхода ещё НЕТ, и сигнал уходит в
            #               никуда. `start` на работающем сервисе заставляет procd
            #               сверить описанные экземпляры с запущенными и завести разницу.
            #   params    — сменился узел или подписка у существующего выхода: хватит
            #               сигнала живому экземпляру. `start` здесь бесполезен: описание
            #               экземпляра от номера узла не зависит, procd видит его
            #               неизменившимся и процесс не трогает — подписку никто не
            #               перечитает.
            #
            # Поводы НЕ исключают друг друга: между двумя применениями бывает и то и
            # другое, и тогда нужны оба действия. Порядок обязателен именно этот —
            # сигнал живым, потом сборка набора: наоборот только что созданный
            # экземпляр получал бы TERM через мгновение после запуска.
            #
            # Прежде спасал побочный эффект: reload_dnsd ниже при отсутствии экземпляра
            # dnsd делает start всего сервиса. То есть новый туннель поднимался, ТОЛЬКО
            # если в спеке нет доменных каналов, — а они есть в самой обычной
            # конфигурации этого продукта. С ними экземпляр dnsd существует, start не
            # случается, и туннель не появлялся до перезагрузки роутера, выглядя
            # настроенным. Для обфускации этот же сценарий давно назван недопустимым.
            #
            # Пустой файл — от версий, где sub_set помечал смену подписки без слова:
            # читается как params, ровно так он тогда и работал.
            [ -s "$VLESS_DIRTY" ] || dirty_mark "$VLESS_DIRTY" params
            if dirty_has "$VLESS_DIRTY" params; then
                for o in $("$STEER" outputs --kind vless --spec "$SPEC" 2>/dev/null); do
                    # Через ubus, а не procd_send_signal: тот живёт в
                    # /lib/functions/procd.sh, которого в rpcd-скрипте нет. Сигнал именно
                    # ЭТОМУ экземпляру — резолвер и сторож перезапускать незачем, а '*'
                    # однажды уже убивал туннель при каждом сохранении.
                    ubus call service signal \
                        "{\"name\":\"steer\",\"instance\":\"vless_$o\",\"signal\":15}" 2>/dev/null
                    out="$out
splify2: туннель $o перезапущен — сменился узел или подписка"
                done
            fi
            if dirty_has "$VLESS_DIRTY" instances; then
                "$INITD" start >/dev/null 2>&1
                out="$out
splify2: набор туннелей изменился — экземпляры пересобраны"
            fi
            rm -f "$VLESS_DIRTY"
        fi
        # Обфускаторы. Два разных случая с разной ценой:
        #
        #   params    — сменился адрес сервера или локальный порт: хватит сигнала живому
        #               экземпляру, procd поднимет его заново с новой спекой;
        #   instances — набор выходов с obfs изменился: экземпляра для нового выхода ещё
        #               не существует, и сигналить некому. `start` на работающем сервисе
        #               заставляет procd СВЕРИТЬ описанные экземпляры с запущенными и
        #               завести/снять разницу — без этого новый выход молча не работал бы
        #               до перезагрузки роутера, выглядя настроенным.
        if [ -f "$OBFS_DIRTY" ]; then
            # Тот же порядок и та же причина, что у vless выше: поводы складываются,
            # сигнал живым уходит раньше сборки набора.
            [ -s "$OBFS_DIRTY" ] || dirty_mark "$OBFS_DIRTY" params
            if dirty_has "$OBFS_DIRTY" params; then
                for o in $("$STEER" outputs --obfs --spec "$SPEC" 2>/dev/null); do
                    ubus call service signal \
                        "{\"name\":\"steer\",\"instance\":\"obfs_$o\",\"signal\":15}" 2>/dev/null
                    out="$out
splify2: обфускатор $o перезапущен — сменился сервер или порт"
                done
            fi
            if dirty_has "$OBFS_DIRTY" instances; then
                "$INITD" start >/dev/null 2>&1
                out="$out
splify2: набор обфускаторов изменился — экземпляры пересобраны"
            fi
            rm -f "$OBFS_DIRTY"
        fi
        # Резолвер обязан перечитать спеку: список файлов у доменного канала он берёт
        # при старте, поэтому после apply он ещё матчит прежние домены. Без этого
        # выбранный в интерфейсе список молча не работает — правила новые, а резолвер
        # старый. Экземпляр перезапускается без снятия правил, маршрутизация не мигает.
        [ "$rc" -eq 0 ] && "$INITD" reload_dnsd >/dev/null 2>&1
        # Вывод движка отдаётся целиком, включая предупреждения: он знает то, чего
        # интерфейс знать не может — например, что у туннеля нет NAT и трафик в него
        # уедет без возврата.
        json_init
        json_add_boolean ok $([ $rc -eq 0 ] && echo 1 || echo 0)
        json_add_string output "$out"
        json_dump
        ;;

    explain)
        read -r input
        json_load "$input" 2>/dev/null || fail "неразбираемый запрос"
        json_get_var address address
        [ -n "$address" ] || fail "не указан адрес"
        json_init
        json_add_string text "$("$STEER" explain "$address" --spec "$SPEC" 2>&1)"
        json_dump
        ;;

    lists)
        # Манифест отдаётся как есть — превращать его в форму интерфейса здесь значило
        # бы держать разбор в shell, где он дороже и хуже проверяем.
        if [ ! -s "$MANIFEST" ]; then
            mkdir -p "$(dirname "$MANIFEST")"
            download "$(manifest_url)" "$MANIFEST" ||
                fail "манифест не скачался${FETCH_NOTE:+: $FETCH_NOTE}"
        fi
        cat "$MANIFEST"
        ;;

    list_fetch)
        read -r input
        json_load "$input" 2>/dev/null || fail "неразбираемый запрос"
        json_get_var id id
        [ -n "$id" ] || fail "не указан список"
        [ -s "$MANIFEST" ] || fail "манифест не загружен"
        json_get_var kind kind
        base="$(jsonfilter -i "$MANIFEST" -e '@.base_url')"
        file="$(manifest_file "$id" "$kind")"
        [ -n "$file" ] || fail "списка $id нет в манифесте"
        [ -n "$base" ] || fail "в манифесте нет base_url"
        dest="$(local_path "$file")" || fail "издатель прислал недопустимый путь списка: $file"
        mkdir -p "$(dirname "$dest")"
        download "$base/$file" "$dest" || fail "список не скачался${FETCH_NOTE:+: $FETCH_NOTE}"
        json_init
        json_add_boolean ok 1
        json_add_int count "$(grep -c . "$dest")"
        json_add_string path "$dest"
        # Каким путём приехало. Пусто — прямым; иначе строка объясняет обход, и интерфейсу
        # есть что показать вместо молчаливой паузы в полминуты.
        [ -n "$FETCH_NOTE" ] && json_add_string via "$FETCH_NOTE"
        json_dump
        ;;

    lists_update)
        # Обновить всё, что используется, прямо сейчас — кнопка в каталоге.
        #
        # Зовётся ТОТ ЖЕ скрипт, что ходит по расписанию, а не своя укладка рядом. Он
        # один знает всё, что к обновлению прилагается: подгонку адресных списков под
        # память (`steer fit`), проверку скачанного до подмены, откат на прежние копии,
        # если движок отверг новое, и apply в конце. Вторая реализация разошлась бы с
        # первой на первом же изменении, а расходиться ей есть где.
        #
        # Скрипт умеет только syslog: его log() печатает в stdout лишь под терминалом, а
        # здесь терминала нет. Поэтому ему передаётся REPORT — файл, куда он дублирует те
        # же строки. Отправлять человека в журнал за ответом на нажатие кнопки нельзя.
        [ -x "$UPDATE_LISTS" ] || fail "обновлятор списков не найден"
        rep="/tmp/splify2-lists-update.$$"
        rm -f "$rep"
        : > "$rep"
        REPORT="$rep" "$UPDATE_LISTS" >/dev/null 2>&1
        lu_rc=$?
        lu_changed="$(grep -c ': обновлён' "$rep" 2>/dev/null)"
        lu_failed="$(grep -c 'оставлен прежний\|не скачался' "$rep" 2>/dev/null)"
        json_init
        # ok=0 только тогда, когда что-то не обновилось. Прогон без изменений — успех:
        # значит списки уже свежие.
        json_add_boolean ok "$([ "$lu_rc" = 0 ] && echo 1 || echo 0)"
        json_add_int updated "${lu_changed:-0}"
        json_add_int failed "${lu_failed:-0}"
        json_add_array lines
        while read -r lu_line; do
            [ -n "$lu_line" ] && json_add_string "" "$lu_line"
        done < "$rep"
        json_close_array
        json_dump
        rm -f "$rep"
        ;;

    list_put)
        # Свой список: текстом, по ссылке или файлом.
        #
        # Вопрос пришёл снаружи: маршрутизировать можно было только то, что опубликовал
        # издатель. Движок сопоставляет исключительно по файлам, а каталог рисуется из
        # манифеста, поэтому свой .lst, положенный в /etc/steer/lists руками, был виден
        # local_lists — и не предлагался ни одному правилу.
        #
        # Файл — тем же методом по частям (append), а не отдельным транспортом: ubus не
        # резиновый, а cgi-io означал бы второй путь загрузки со своими правами и своей
        # проверкой формата. Один вход — одна проверка.
        read -r input
        json_load "$input" 2>/dev/null || fail "неразбираемый запрос"
        json_get_var name name
        json_get_var kind kind
        json_get_var text text
        json_get_var url url
        json_get_var append append
        # ОТКУДА список. Спрашивается явно, а не выводится из того, что пришло: `text` без
        # ссылки означает и «набрал руками», и «выбрал файл» — файл интерфейс шлёт тем же
        # полем, порциями по тысяче строк (см. CustomLists). Различить их здесь нечем, а
        # различать надо: правят их разными способами.
        #
        # Поля нет вовсе (старый интерфейс) — считаем по тому, что пришло: ссылка значит
        # ссылку, текст значит «руками». Это ровно то, что и было раньше, только теперь
        # записано.
        json_get_var source source
        json_get_var filename filename
        # Имя — часть пути на диске, поэтому проверяется до всего остального. Без этого
        # «../../etc/passwd» было бы законным именем списка.
        case "$name" in
            ''|*[!A-Za-z0-9_-]*) fail "имя списка: латиница, цифры, дефис и подчёркивание" ;;
        esac
        case "$kind" in
            domains|prefixes) ;;
            *) fail "вид списка: domains (домены) или prefixes (подсети)" ;;
        esac
        raw="/tmp/splify2-put.$$"
        rm -f "$raw" "$raw.clean" "$raw.stat"
        if [ -n "$url" ]; then
            case "$url" in
                http://*|https://*) ;;
                *) fail "ссылка должна начинаться с http:// или https://" ;;
            esac
            download "$url" "$raw" || fail "не скачалось: $url${FETCH_NOTE:+ ($FETCH_NOTE)}"
        else
            [ -n "$text" ] || fail "пустой список"
            printf '%s\n' "$text" > "$raw"
        fi
        sz="$(wc -c 2>/dev/null < "$raw" || echo 0)"
        if [ "$sz" -gt "$LIST_MAX_BYTES" ]; then
            rm -f "$raw"
            fail "список больше $((LIST_MAX_BYTES / 1024)) КБ — столько на роутер не кладём"
        fi
        sanitize_list "$kind" "$raw" "$raw.clean" "$raw.stat"
        rm -f "$raw"
        read -r kept dropped < "$raw.stat"
        rm -f "$raw.stat"
        if [ "${kept:-0}" -eq 0 ]; then
            rm -f "$raw.clean"
            fail "не разобрано ни одной строки: для $kind ждём $([ "$kind" = prefixes ] && echo 'подсети вида 10.0.0.0/8' || echo 'имена вида example.org')"
        fi
        # Доменные — в подкаталог, адресные — рядом: ровно та же раскладка, что у
        # издателя. Вид списка обязан читаться из пути, иначе `mine.lst` доменный и
        # `mine.lst` адресный неразличимы, а интерфейсу надо положить их в РАЗНЫЕ поля
        # правила. На схлопывании двух списков в один проект уже обжигался (I-011).
        dest="$(custom_path "$name" "$kind")"
        mkdir -p "$(dirname "$dest")"
        # Предел считается по ИТОГОВОМУ файлу, а не по одной порции.
        #
        # Проверка выше смотрит только на то, что пришло этим вызовом, а интерфейс грузит
        # файл кусками по тысяче строк с append, и число кусков ничем не ограничено. То
        # есть предел, заведённый ради overlay в 6,9 МБ, обходился самым обычным способом
        # им пользоваться: выбрал файл на 40 МБ — сорок вызовов по мегабайту, ни один не
        # превысил предел, а флеш забит, и дальше не пишется ни спека, ни конфиг, ни
        # журнал, причём без единого слова о причине.
        if [ "$append" = 1 ] || [ "$append" = true ]; then
            have="$(wc -c 2>/dev/null < "$dest" || echo 0)"
            add="$(wc -c 2>/dev/null < "$raw.clean" || echo 0)"
            if [ "$((have + add))" -gt "$LIST_MAX_BYTES" ]; then
                rm -f "$raw.clean"
                fail "список «$name» дорос бы до $(( (have + add) / 1024 )) КБ, а предел $((LIST_MAX_BYTES / 1024)) КБ — столько на роутер не кладём"
            fi
        fi
        case "$append" in
            1|true) cat "$raw.clean" >> "$dest" || { rm -f "$raw.clean"; fail "не дописалось — кончилось место?"; } ;;
            # Замена через mv, а не через «> файл»: оборванная запись поверх рабочего
            # списка оставила бы канал маршрутизировать половину.
            #
            # Но сам mv атомарен только ВНУТРИ одной файловой системы, а $raw лежит в
            # /tmp (tmpfs), тогда как списки — на overlay. Между ФС busybox копирует, то
            # есть обрыв оставляет ровно тот обрубок, от которого mv и должен был спасти.
            # Поэтому сначала переносим рядом с целью, и только потом переименовываем.
            *)      mv "$raw.clean" "$dest.new.$$" &&
                    mv "$dest.new.$$" "$dest" ||
                    { rm -f "$raw.clean" "$dest.new.$$"; fail "не записалось — кончилось место?"; } ;;
        esac
        rm -f "$raw.clean"
        # Происхождение запоминается на ПЕРВОЙ порции, а не на каждой: порции — это один и
        # тот же файл, и запись при каждой означала бы `at` последнего куска вместо времени
        # выбора файла. Плюс лишняя запись на overlay за каждую тысячу строк.
        case "$append" in
            1|true) ;;
            *)
                case "$source" in
                    text|file|url) ;;
                    *) [ -n "$url" ] && source=url || source=text ;;
                esac
                # Имя файла — только для показа человеку («выбран blocked.txt»), поэтому от
                # него нужна ровно читаемость. Чистится тем же доводом, что заголовки HWID:
                # строка приходит из браузера и уедет в JSON и на экран.
                filename="$(printf '%s' "$filename" | tr -d '\r\n\t"\\/' | cut -c1-64)"
                custom_meta_put "$name" "$kind" "$source" \
                    "$([ "$source" = url ] && printf '%s' "$url")" "$filename"
                ;;
        esac
        json_init
        json_add_boolean ok 1
        json_add_string path "$dest"
        json_add_int count "$(grep -c . "$dest")"
        json_add_int dropped "${dropped:-0}"
        json_dump
        ;;

    list_remove)
        read -r input
        json_load "$input" 2>/dev/null || fail "неразбираемый запрос"
        json_get_var id id
        json_get_var kind kind
        json_get_var name name
        # Свой список ищется по имени, а не через манифест: в манифесте его нет и быть
        # не может, поэтому прежний код удалить его не мог вовсе.
        if [ -n "$name" ]; then
            case "$name" in
                *[!A-Za-z0-9_-]*) fail "имя списка: латиница, цифры, дефис и подчёркивание" ;;
            esac
            dest="$(custom_path "$name" "${kind:-}")"
            # Вид могли не указать — тогда ищем оба, но удаляем ровно один: имя внутри
            # своих списков уникально по виду, как и у издателя.
            if [ ! -f "$dest" ]; then
                dest="$(custom_path "$name" domains)"
                [ -f "$dest" ] || dest="$(custom_path "$name" prefixes)"
            fi
            [ -f "$dest" ] || fail "своего списка $name нет"
            if [ -s "$SPEC" ] && grep -q "$dest" "$SPEC"; then
                fail "список используется каналом — сначала снимите галочку"
            fi
            # Вместе со списком снимается и запись о его происхождении: оставленная, она
            # переехала бы на СЛЕДУЮЩИЙ список того же имени и рассказала бы про него
            # чужую правду — «выбран blocked.txt» на списке, набранном руками.
            rm -f "$dest" "$dest.src"
            json_init; json_add_boolean ok 1; json_dump
            exit 0
        fi
        [ -n "$id" ] || fail "не указан список"
        file="$(manifest_file "$id" "$kind")"
        [ -n "$file" ] || fail "списка $id нет в манифесте"
        dest="$(local_path "$file")" || fail "издатель прислал недопустимый путь списка: $file"
        # Канал, указывающий на файл, после удаления не скомпилируется: движок читает
        # список при сборке правил и падает на отсутствующем. Поэтому удаление
        # ОТКАЗЫВАЕТСЯ, пока список кем-то используется, вместо того чтобы оставить
        # спеку, которая перестанет применяться при следующей перезагрузке.
        #
        # Ищем ПОЛНЫЙ путь, а не имя файла: `hodca.lst` встречается и в адресном канале, и
        # внутри `domains/hodca.lst`, и поиск по имени запрещал бы удаление одного из-за
        # другого.
        if [ -s "$SPEC" ] && grep -q "$dest" "$SPEC"; then
            fail "список используется каналом — сначала снимите галочку"
        fi
        rm -f "$dest"
        json_init; json_add_boolean ok 1; json_dump
        ;;

    list_custom)
        # СВОИ списки с происхождением: что правится и чем.
        #
        # Отдельным методом, а не полем local_lists, и это разделение по цене: local_lists
        # считается одним awk по всему каталогу (46 файлов на роутере) и зовётся на каждое
        # открытие настроек, а происхождение нужно только своим спискам — их единицы — и
        # только там, где их правят. Складывать одно в другое значило бы читать по файлу
        # происхождения на каждый список издателя, которого у него нет и быть не может.
        #
        # Печатает jshn, а не awk: записей единицы, а в ответе есть строки от человека
        # (ссылка, имя файла), которым экранирование обязательно.
        json_init
        json_add_array lists
        for f in "$LISTS/$CUSTOM"/*.lst "$LISTS/$CUSTOM"/domains/*.lst; do
            [ -f "$f" ] || continue
            n="${f##*/}"; n="${n%.lst}"
            # Имя проверяется и здесь, на ВЫХОДЕ: в каталог мог положить файл не интерфейс,
            # а руки, и тогда имя уедет в JSON и обратно в list_put как путь. Тот же довод,
            # по которому имя проверяется в backup_build.
            case "$n" in ''|*[!A-Za-z0-9_-]*) continue ;; esac
            case "$f" in *"/$CUSTOM/domains/"*) k=domains ;; *) k=prefixes ;; esac
            custom_meta_get "$n" "$k" || true
            json_add_object ""
            json_add_string name "$n"
            json_add_string kind "$k"
            json_add_string path "$f"
            json_add_int count "$(grep -c . "$f" 2>/dev/null || echo 0)"
            json_add_int bytes "$(wc -c 2>/dev/null < "$f" || echo 0)"
            # Происхождение. Пустой `source` значит «неизвестно»: список завели до появления
            # этой записи, положили в каталог руками или вернули из архива настроек. Врать
            # тут нельзя — интерфейс тогда предлагает все три способа правки, как предлагал
            # всегда, а не один неверный.
            json_add_string source "${CM_SOURCE:-}"
            json_add_string url "${CM_URL:-}"
            json_add_string filename "${CM_FILE:-}"
            json_add_int at "${CM_AT:-0}"
            json_close_object
        done
        json_close_array
        json_dump
        ;;

    list_get)
        # Записи своего списка обратно, порциями.
        #
        # ЗАЧЕМ. Редактор списка, набранного руками, обязан показать то, что лежит на
        # роутере. Пустое поле вместо записей — это не «начни заново», а предложение
        # незаметно потерять то, что человек набирал: он допишет одну строку, нажмёт
        # «Сохранить», и остальные исчезнут.
        #
        # ПОРЦИЯМИ, по тому же доводу, что list_put и backup_get: ubus не резиновый, а свой
        # список разрешён до LIST_MAX_BYTES. Нарезка по БАЙТАМ, а не по строкам, и ровно на
        # границе: смещение приходит от вызывающего, и делить его на строки означало бы
        # второй счёт того же места.
        #
        # Читаются только СВОИ списки. Список издателя правке не подлежит: он приезжает по
        # расписанию, и всякая правка была бы стёрта следующим обновлением молча.
        read -r input
        json_load "$input" 2>/dev/null || fail "неразбираемый запрос"
        json_get_var name name
        json_get_var kind kind
        json_get_var offset offset
        case "$name" in
            ''|*[!A-Za-z0-9_-]*) fail "имя списка: латиница, цифры, дефис и подчёркивание" ;;
        esac
        case "$kind" in
            domains|prefixes) ;;
            *) fail "вид списка: domains (домены) или prefixes (подсети)" ;;
        esac
        case "${offset:-0}" in ''|*[!0-9]*) offset=0 ;; esac
        src="$(custom_path "$name" "$kind")"
        [ -f "$src" ] || fail "своего списка $name нет"
        total="$(wc -c 2>/dev/null < "$src" || echo 0)"
        # Нарезка ровно та же, что у архива настроек, вместе с заплаткой: подстановка команды
        # съедает ЗАВЕРШАЮЩИЕ переводы строки, а кусок обязан приехать байт в байт — иначе на
        # границе куска пропадает перевод строки и две записи списка склеиваются в одну.
        # Склеенная запись не отбрасывается санитайзером, а МОЛЧА теряет обе: «10.0.0.0/810.1.0.0/8»
        # это не подсеть, и обе исчезают из канала.
        text="$(tail -c "+$((offset + 1))" "$src" | head -c "$LIST_CHUNK"; printf X)"
        text="${text%X}"
        got="$(printf '%s' "$text" | wc -c)"
        next=$((offset + got))
        eof=0
        [ "$next" -ge "$total" ] && eof=1
        json_init
        json_add_boolean ok 1
        json_add_string name "$name"
        json_add_string kind "$kind"
        json_add_int total "$total"
        json_add_int offset "$offset"
        # Сколько СЧИТАНО, а не сколько просили: длина куска считается от него самого, иначе
        # смещение уезжало бы на каждой границе.
        json_add_int next "$next"
        json_add_boolean eof "$eof"
        json_add_string text "$text"
        json_dump
        ;;

    local_lists)
        # Что уже лежит на диске. Без этого интерфейс не может отличить скачанный
        # список от невыбранного: кнопка «Загрузить» висела и над готовым, а выбрать
        # можно было то, чего на роутере нет.
        #
        # ТРИ ПРОЦЕССА НА ВЕСЬ КАТАЛОГ, А НЕ ДВА НА КАЖДЫЙ ФАЙЛ. Было `grep -c .` и `date -r`
        # в подстановке на каждый файл: на роутере со всем каталогом это 46 файлов, то есть
        # 92 запуска процессов. Замер на стенде 10.8.1.87 (mipsel 24kc, 880 МГц): 1197 мс на
        # вызов — самый дорогой метод объекта, и платит его человек каждый раз, открывая
        # «Настройки» или каталог. Стало 390 мс: счёт строк одним grep по всем файлам, времена
        # одним ls, склейка и печать одним awk.
        #
        # `grep -c .`, а не `wc -l`: считаются НЕПУСТЫЕ строки, и это не придирка — свой
        # список человек правит руками, пустая строка в нём законна, а число на экране
        # обязано означать «столько записей». /dev/null в списке файлов — чтобы grep печатал
        # «путь:число» и на единственном файле тоже: без второго имени он печатает голое
        # число, и разобрать его было бы нечем.
        #
        # Время файла берётся из `ls -l --full-time` и переводится в секунды mktime(). Если
        # busybox собран без этого ключа, времена придут нулями, а счёт — нет: поле остаётся
        # в контракте (docs/rpcd-api.md), но его значение — лучшее из доступного, и это
        # честнее, чем 46 запусков `date` ради числа, которое на экране сейчас не показывает
        # никто.
        #
        # ПЕЧАТАЕТ awk, А НЕ jshn, и это единственное место в объекте, где так. Замер там же:
        # сборка тех же сорока шести записей через jshn — 187 мс, то есть половина нынешней
        # цены метода ушла бы на неё. Безопасно это ровно потому, что ключ здесь не
        # произвольная строка: имена списков чистит list_put, и awk ниже пропускает всё, что
        # не состоит из букв, цифр, точки, дефиса, подчёркивания и косой черты. Файл с
        # кавычкой в имени не наш, и промолчать о нём честнее, чем выдать поломанный JSON.
        _ll_files="$(find "$LISTS" -name '*.lst' -type f 2>/dev/null)"
        # Пути подставляются РАЗДЕЛЕНИЕМ СЛОВ, а не через xargs: конвейер с printf и xargs —
        # это ещё четыре запуска процессов, а на 880 МГц каждый стоит около двадцати
        # миллисекунд. Пробелов в наших именах не бывает (см. выше), а сорок шесть путей
        # далеко не упираются в предел длины командной строки.
        # shellcheck disable=SC2086
        { grep -c . /dev/null $_ll_files 2>/dev/null
          ls -l --full-time $_ll_files 2>/dev/null
        } | awk -v pfx="$LISTS/" '
            # Строки grep — «путь:число», в них нет пробелов. Строки ls — девять полей:
            # права, ссылки, владелец, группа, размер, дата, время, зона, путь.
            NF == 1 { i = index($0, ":"); if (i) c[substr($0, 1, i - 1)] = substr($0, i + 1); next }
            NF >= 9 {
                split($6, d, "-"); split($7, t, ":")
                m[$NF] = mktime(d[1] " " d[2] " " d[3] " " t[1] " " t[2] " " int(t[3]))
                next
            }
            END {
                printf "{\"files\":{"
                n = 0
                for (p in c) {
                    if (p == "/dev/null") continue
                    r = p; sub("^" pfx, "", r)
                    if (r !~ /^[A-Za-z0-9._\/-]+$/) continue
                    printf "%s\"%s\":{\"count\":%d,\"mtime\":%d}", (n++ ? "," : ""), r, c[p], (p in m ? m[p] : 0)
                }
                printf "}}\n"
            }'
        ;;

    devices)
        # Кандидаты в выход interface: только туннельные устройства.
        #
        # Отбор по /sys/class/net/*/type, а не по имени. Признак — ARPHRD_NONE (65534):
        # он у wireguard, amneziawg и tun, и его нет ни у мостов, ни у физических портов,
        # ни у wifi. 768 — ARPHRD_TUNNEL (ipip, gre), тоже туннель.
        #
        # Раньше отбор шёл по имени и отсекал eth*, но на современном OpenWrt порты
        # называются lan2, lan3, wan — и они попадали в список. Выход в физический порт
        # молча ничего не маршрутизирует: конфигурация выглядит настроенной, трафик
        # пропадает. Проверено на роутере — предлагались wan и три lan-порта.
        json_init
        json_add_array devices
        _dev_seen=" "
        # Файлы /sys читаются ВСТРОЕННЫМ read, а имя берётся подстановкой параметра.
        # Было четыре запуска процессов на устройство (basename и три cat, у одного из них
        # ещё sed с head в конвейере), устройств на типовой коробке десять — сорок с лишним
        # процессов на вызов. Замер на стенде 10.8.1.87: 287 мс, из которых сам ответ —
        # единицы миллисекунд. Тот же приём и по той же причине уже применён к счётчикам
        # устройств (см. fast.sh).
        for d in "$OUT_SYSNET"/*; do
            [ -d "$d" ] || continue
            n="${d##*/}"
            _t=''
            read -r _t < "$d/type" 2>/dev/null || continue
            case "$_t" in
                65534|768) ;;
                *) continue ;;
            esac
            # Физическое устройство туннелем не бывает: у него есть ссылка device.
            [ -e "$d/device" ] && continue
            _dev_seen="$_dev_seen$n "
            _op=''
            read -r _op < "$d/operstate" 2>/dev/null || _op=''
            # DEVTYPE стоит в uevent отдельной строкой; строк там единицы, поэтому перебор
            # встроенным read дешевле запуска sed.
            _kind=''
            while read -r _l; do
                case "$_l" in DEVTYPE=*) _kind="${_l#DEVTYPE=}"; break ;; esac
            done < "$d/uevent" 2>/dev/null
            json_add_object ""
            json_add_string name "$n"
            json_add_boolean up "$([ "$_op" = down ] && echo 0 || echo 1)"
            json_add_string kind "$_kind"
            json_close_object
        done
        # Устройства выходов, которые поднимает САМ ДВИЖОК (kind=vless, kind=xsteer).
        #
        # В /sys/class/net они появляются вместе со своим процессом, а не с настройкой,
        # поэтому выключенного сейчас туннеля в перечне не было вовсе — и законную форму
        # смешанного пула (устройство локации подписки рядом с wg0) с экрана было не собрать
        # (I-161). Перечень отвечает на «куда можно выпустить трафик», а это вопрос о
        # НАСТРОЙКЕ: локация, выключенная сегодня, завтра поднимется, и класть её в пул
        # человек вправе сейчас.
        #
        # Имена спрашиваются у движка (--devices), а не выводятся из имён выходов: устройство
        # выводится из имени выхода, НО может быть задано в спеке явно, и тогда «имя выхода» —
        # молча неверный список. Тот же довод, что у fw_devices_of, и та же функция.
        #
        # up здесь всегда 0: устройства нет, и это ровно то, что о нём известно.
        for n in $(fw_devices_of vless,xsteer); do
            case "$_dev_seen" in *" $n "*) continue ;; esac
            _dev_seen="$_dev_seen$n "
            json_add_object ""
            json_add_string name "$n"
            json_add_boolean up 0
            json_add_string kind ""
            json_close_object
        done
        json_close_array
        json_dump
        ;;

    client_nets)
        # Откуда приходят клиенты: устройства роутера, которые могут быть СЕТЬЮ КЛИЕНТОВ,
        # и подсети, которые из их адресов выводятся.
        #
        # ЗАЧЕМ. splify2#16. Роутер бывает выходной точкой не только для домашнего моста:
        # у автора обращения через него ходят ещё и хосты из Tailscale и ZeroTier, и правила
        # к ним хочется применять те же. В splify1 это был перечень интерфейсов через запятую
        # в /etc/config, здесь же выбирать было не из чего — перечня не существовало вовсе.
        # Соседний метод `devices` отвечает на противоположный вопрос (куда трафик выпустить)
        # и отбирает ровно туннели, поэтому переиспользовать его нельзя: домашнего моста в
        # его ответе нет и быть не должно.
        #
        # ЧТО ОТСЕИВАЕТСЯ И ПОЧЕМУ ИМЕНЕМ НЕ ОТСЕИВАЕТСЯ НИЧЕГО.
        #  * `lo` — единственное имя, зашитое здесь: петля клиентом не бывает ни на одном
        #    роутере, и объяснять её присутствие в списке пришлось бы каждому.
        #  * Порт внутри моста (есть ссылка `master`) — своей сетью не является: клиенты
        #    приходят через мост, и правило по `lan1` не увидело бы ни одного пакета.
        #  * wan НЕ отсеивается, а помечается. Отбор по имени тут особенно вреден: на одном
        #    роутере внешний интерфейс называется wan, на другом eth0.2, на третьем это
        #    вообще мост. Спрашиваем uci — он и есть ответ на «что здесь наружу». А выкинуть
        #    устройство совсем нельзя: человек ищет его глазами, не находит и решает, что
        #    перечень сломан. Помеченное он не выберет, и это разные вещи.
        #
        # ПОДСЕТЬ ЗДЕСЬ — ПОДСКАЗКА, А НЕ НАСТРОЙКА. Движок отвечает на «кто» правилом
        # `iifname` по именам устройств, и адреса в этом не участвуют вовсе; подсеть нужна
        # человеку, чтобы узнать, какое устройство какое. Именно поэтому клиентов и
        # описывают именем: у Tailscale адрес на роутере /32, то есть подсеть пиров из него
        # не выводится, а у клиентов за вторым роутером в LAN адреса чужой подсети при том
        # же интерфейсе.
        _cn_wan="$(uci -q get network.wan.device 2>/dev/null)"
        [ -n "$_cn_wan" ] || _cn_wan="$(uci -q get network.wan.ifname 2>/dev/null)"
        # Адреса ВСЕХ устройств одним запуском `ip`, а не по запуску на устройство.
        # Строки вида «br-lan 192.168.1.1/24»; второе поле после `inet` — адрес с префиксом,
        # хвост строки (brd, scope) отбрасывается. Было десять запусков на типовой коробке,
        # и каждый на 880 МГц стоит около двадцати миллисекунд (замер на стенде: 283 мс на
        # вызов при десяти мс на сам `ip`).
        _cn_addrs="$(ip -4 -o addr show 2>/dev/null |
                     awk '{ for (i = 1; i < NF; i++) if ($i == "inet") { print $2, $(i + 1); break } }')"
        json_init
        json_add_array nets
        for d in "$SYSNET"/*; do
            [ -d "$d" ] || continue
            n="${d##*/}"
            [ "$n" = lo ] && continue
            # Порт внутри моста: своя сеть у него не бывает, клиенты придут через мост.
            [ -e "$d/master" ] && continue
            _op=''
            read -r _op < "$d/operstate" 2>/dev/null || _op=''
            json_add_object ""
            json_add_string name "$n"
            json_add_boolean up "$([ "$_op" = down ] && echo 0 || echo 1)"
            json_add_boolean wan "$([ -n "$_cn_wan" ] && [ "$n" = "$_cn_wan" ] && echo 1 || echo 0)"
            json_add_array subnets
            # Устройство без адреса даёт пустой массив, а не пропуск: выбрать его законно,
            # адрес появится вместе с поднятием.
            _OIFS="$IFS"; IFS='
'
            for _row in $_cn_addrs; do
                IFS="$_OIFS"
                set -- $_row
                if [ "${1:-}" = "$n" ]; then
                    case "${2:-}" in
                        */*) json_add_string "" "$(cidr_net "$2")" ;;
                    esac
                fi
                IFS='
'
            done
            IFS="$_OIFS"
            json_close_array
            json_close_object
        done
        json_close_array
        json_dump
        ;;

    engine)
        # Что за движок стоит и умеет ли он VLESS.
        #
        # Спрашивается у самого движка, а не по имени пакета: пакет мог быть поставлен
        # руками, переименован или собран из исходников. Признак — отвечает ли `vless`
        # отказом «нужен steer-extended». Без этой проверки интерфейс предлагал бы выход
        # kind=vless на базовой сборке, и человек получал бы отказ уже при сохранении,
        # не понимая, чего от него хотят.
        # Сначала — есть ли движок вообще. Без этой проверки отсутствие steer выглядело бы
        # как «VLESS поддержан»: сообщение «команда не найдена» тоже не содержит слова
        # steer-extended, и признак по отсутствию сработал бы наоборот.
        # Состояние сервиса добывается ДО json_init: engine_running разбирает ответ ubus
        # через json_load, а он затирает документ, который мы бы в этот момент собирали.
        svc_enabled="$(engine_enabled)"
        svc_running="$(engine_running)"
        if [ ! -x "$STEER" ]; then
            json_init
            json_add_boolean present 0
            json_add_boolean vless 0
            json_add_boolean enabled "$svc_enabled"
            json_add_boolean running "$svc_running"
            json_dump
            exit 0
        fi
        vless=1
        out="$("$STEER" vless '' 2>&1)"
        case "$out" in *steer-extended*) vless=0 ;; esac
        json_init
        json_add_boolean present 1
        json_add_boolean vless "$vless"
        # Автозапуск и работа — разные вещи, и тумблеру нужны обе. Движок могли
        # остановить из консоли между двумя открытиями страницы, поэтому подпись обязана
        # читать состояние, а не помнить своё.
        json_add_boolean enabled "$svc_enabled"
        json_add_boolean running "$svc_running"
        json_add_string arch "$(pkg_arch)"
        # Версия любого из двух вариантов пакета. Через pkg_version, а не своим разбором
        # `apk list`: на opkg-роутере тот отдавал пустоту, и карточка движка показывала
        # установленный движок без версии.
        json_add_string version "$(v="$(pkg_version steer-extended)"; [ -n "$v" ] || v="$(pkg_version steer)"; printf '%s' "$v")"
        json_dump
        ;;

    engine_stop)
        # «Остановить всё» — одно действие вместо консоли.
        #
        # Просьба из публичного теста звучала дословно так: «жизненно необходима кнопка
        # Остановить, причём всё — и сервис, и движок». До неё вернуть роутер в состояние
        # «как будто не установлено» можно было только по ssh.
        #
        # disable, а не только stop. Разница не косметическая: без него перезагрузка
        # поднимает движок обратно, и человек, нажавший «остановить всё», получает его
        # снова — молча и без объяснения, почему кнопка «не сработала». Именно поэтому
        # обратное действие обязано быть рядом: снятый автозапуск сам не вернётся.
        #
        # Правила из ядра убирать отдельно не нужно: stop_service движка сносит таблицу
        # nft и вычищает ip rule сам.
        "$INITD" stop >/dev/null 2>&1
        "$INITD" disable >/dev/null 2>&1
        en="$(engine_enabled)"; run="$(engine_running)"
        json_init
        json_add_boolean ok 1
        json_add_boolean enabled "$en"
        json_add_boolean running "$run"
        json_dump
        ;;

    engine_start)
        # Обратная половина тумблера. enable перед start, а не после: иначе состояние
        # «работает, но после перезагрузки не поднимется» существует между двумя
        # вызовами, и увидеть его можно ровно в тот момент, когда роутер перезагрузили.
        "$INITD" enable >/dev/null 2>&1
        "$INITD" start >/dev/null 2>&1
        en="$(engine_enabled)"; run="$(engine_running)"
        json_init
        json_add_boolean ok 1
        json_add_boolean enabled "$en"
        json_add_boolean running "$run"
        json_dump
        ;;

    steer_versions)
        # Какие версии движка можно поставить и как они называются.
        gh_load xyzmean/steer
        json_init
        json_add_string arch "$(pkg_arch)"
        gh_add_releases
        json_dump
        ;;

    splify2_versions)
        # Какие версии САМОГО интерфейса можно поставить.
        #
        # Зачем это вообще нужно. Ни один из пакетов проекта не лежит в feeds OpenWrt,
        # поэтому `apk upgrade` их не видит и обновить интерфейс можно было только по
        # ssh — при том что движок из интерфейса ставится с первого дня. Асимметрия
        # заметная: обновлять умели то, что реже меняется.
        gh_load xyzmean/splify2
        json_init
        json_add_string current "$(pkg_version luci-app-splify2)"
        gh_add_releases
        json_dump
        ;;

    splify2_install)
        # Скачать и поставить интерфейс выбранной версии.
        #
        # Пакет один и он noarch: интерфейс — это собранный бандл и shell-скрипты, под
        # архитектуру здесь ничего не собирается. Поэтому ни выбора варианта, ни
        # pkg_arch тут нет, и единственный отказ до сети — по виду версии.
        read -r input
        ver="$(jsonfilter -s "$input" -e '@.version' 2>/dev/null)"
        json_init
        case "$ver" in
            ''|*[!0-9.]*) json_add_boolean ok 0; json_add_string error "в версии допустимы только цифры и точки"; json_dump; exit 0 ;;
        esac
        name="luci-app-splify2-${ver}-1_$(pkg_noarch)"
        url="https://github.com/xyzmean/splify2/releases/download/v${ver}/${name}"
        tmp="/tmp/${name}"
        rm -f "$tmp"
        # Через download(), а не своим wget: у этой ссылки тот же изъян, что у списков —
        # она перенаправляет на release-assets.githubusercontent.com, и там, где этот хост
        # закрыт, обновление из интерфейса не работало вовсе (splify2#15).
        if ! download "$url" "$tmp"; then
            rm -f "$tmp"
            json_add_boolean ok 0
            json_add_string error "не скачалось: $name (нет такой версии?)${FETCH_NOTE:+ — $FETCH_NOTE}"
            json_dump; exit 0
        fi
        [ -n "$FETCH_NOTE" ] && json_add_string via "$FETCH_NOTE"
        pkg_install "$tmp" luci-app-splify2
        rc=$?
        rm -f "$tmp"
        if [ "$rc" != 0 ]; then
            json_add_boolean ok 0
            json_add_string error "$PKG_OUT"
            json_add_boolean removed "$PKG_REMOVED"
            json_dump; exit 0
        fi
        # Перезапуск rpcd — обязательная часть, а не любезность: список методов ubus и
        # ACL читаются им при старте, поэтому без перезапуска новая версия интерфейса
        # обращается к методам, которых работающий rpcd ещё не знает. Выглядит это как
        # «обновился и всё сломалось».
        #
        # В фоне и с задержкой, потому что этот процесс — сам rpcd: перезапусти его
        # сейчас, и ответ, который мы вот-вот напечатаем, до браузера не доедет.
        ( sleep 2; "$RPCD_INITD" restart >/dev/null 2>&1 ) &
        json_add_boolean ok 1
        json_add_string installed "$name"
        # Вывод менеджера пакетов отдаётся и на УСПЕХЕ, а не только в отказе. Причина не в
        # полноте: в этом выводе печатает свои строки post-install пакета, и там сказано
        # единственное, чего интерфейс знать не может, — что netifd держит прежний набор
        # опций протокола и новые до `/etc/init.d/network restart` не действуют. Пока
        # $PKG_OUT на успехе выбрасывался, эта строка существовала только в терминале того,
        # кто ставит пакет руками, — то есть для человека с браузером её не было вовсе.
        json_add_string output "$PKG_OUT"
        # Страницу придётся перезагрузить: бандл у браузера в кеше, а его версия
        # читается из build-id.txt при загрузке документа (см. home.js).
        json_add_boolean reload_needed 1
        json_dump
        ;;

    steer_install)
        # Скачать и поставить движок выбранной версии и варианта.
        #
        # Ставит именно ЭТО, а не «что-нибудь»: вариант (базовый или расширенный) — выбор
        # человека, зависящий от того, поднимает ли туннель сам движок, и угадывать за него
        # значит либо положить лишнее, либо не положить нужное и получить «выход vless не
        # работает» без объяснения.
        read -r input
        ver="$(jsonfilter -s "$input" -e '@.version' 2>/dev/null)"
        ext="$(jsonfilter -s "$input" -e '@.extended' 2>/dev/null)"
        arch="$(pkg_arch)"
        json_init
        case "$ver" in
            ''|*[!0-9.]*) json_add_boolean ok 0; json_add_string error "в версии допустимы только цифры и точки"; json_dump; exit 0 ;;
        esac
        [ -n "$arch" ] || { json_add_boolean ok 0; json_add_string error "не определилась архитектура"; json_dump; exit 0; }

        case "$ext" in
            1|true) name="steer-extended-${ver}-1_${arch}.$(pkg_ext)" ;;
            *)      name="steer-${ver}-1_${arch}.$(pkg_ext)" ;;
        esac
        url="https://github.com/xyzmean/steer/releases/download/v${ver}/${name}"
        tmp="/tmp/${name}"
        rm -f "$tmp"
        if ! download "$url" "$tmp"; then
            rm -f "$tmp"
            json_add_boolean ok 0
            json_add_string error "не скачалось: $name (нет такой версии для $arch?)${FETCH_NOTE:+ — $FETCH_NOTE}"
            json_dump; exit 0
        fi
        [ -n "$FETCH_NOTE" ] && json_add_string via "$FETCH_NOTE"
        # Порядок apk и разбор конфликта — в pkg_install: он же обслуживает установку
        # самого интерфейса, и две копии этой логики означали бы два разных ответа на
        # вопрос «что делать, когда apk отказал».
        #
        # Снимаем оба имени: расширенный и базовый пакеты владеют одним /usr/sbin/steer
        # и объявлены конфликтующими, поэтому смена варианта иначе не проходит.
        pkg_install "$tmp" steer steer-extended
        rc=$?
        out="$PKG_OUT"
        removed="$PKG_REMOVED"
        rm -f "$tmp"
        if [ "$rc" != 0 ]; then
            json_add_boolean ok 0
            # Про снятый пакет обязан сказать ответ, а не журнал: человек видит только
            # его, а в stderr apk про снос нет ни слова. Молчание здесь означало бы, что
            # роутер стоит без движка, а сообщение говорит только «не удалось поставить».
            if [ "$removed" = 1 ]; then
                json_add_string error "$out
Прежний движок при этом снят: маршрутизации сейчас нет. Поставьте любую версию заново или перезагрузите роутер после установки."
            else
                json_add_string error "$out"
            fi
            json_add_boolean removed "$removed"
            json_dump; exit 0
        fi
        "$INITD" enable >/dev/null 2>&1 || true
        # Переинициализация — обязательная часть установки, а не любезность. Замена
        # пакета останавливает сервис (а на ветке с удалением pre-deinstall ещё и сносит
        # таблицу nft вместе с ip rule): без restart роутер после «обновить движок»
        # оставался без маршрутизации до ручного вмешательства или перезагрузки, и
        # выглядело это как «переустановил — всё сломалось». restart применяет спеку,
        # поднимает резолвер и туннели vless — то же, что происходит при загрузке.
        restarted=0
        if [ -f "$SPEC" ]; then
            "$INITD" restart >/dev/null 2>&1 && restarted=1
        fi
        json_add_boolean ok 1
        json_add_string installed "$name"
        json_add_boolean restarted "$restarted"
        # Слова менеджера пакетов — и на успехе тоже: именно там сказано, например, что
        # списки пакетов были пусты и их пришлось обновить. Без этой строки человек видит
        # «установлено» и не знает, что по дороге чинилось.
        [ -n "$out" ] && json_add_string output "$out"
        json_dump
        ;;

    sub_set)
        # Две формы одного и того же: ссылка на подписку и сами ссылки vless://.
        #
        # Движок различия не знает вовсе — он читает файл, где по строке на узел, и сам
        # разбирает base64, если это base64 (см. sub.c). Подписка это ровно такой файл,
        # который кто-то другой держит на сервере. Значит «вставить одну vless://» — не
        # новая возможность движка, а отсутствовавшая строчка ЗДЕСЬ: прежний код отвечал
        # «ссылка должна начинаться с http://», то есть человек с одним сервером от
        # знакомого не мог сделать вообще ничего.
        #
        # Ссылок может быть несколько — по одной на строку или через пробел. Пишем как
        # есть: разбирать их здесь значило бы держать вторую реализацию разбора vless://
        # в shell, а у движка она уже есть и она же будет применена.
        read -r input
        json_load "$input" 2>/dev/null || fail "неразбираемый запрос"
        json_get_var url url
        json_get_var sub_name name
        json_get_var sub_title title
        [ -n "$url" ] || fail "не указана ссылка"
        sub_use "$sub_name"
        mkdir -p "$(dirname "$SUB")"
        case "$url" in
            https://*|http://*)
                # Одним вызовом движка: скачать, разобрать заголовки, посчитать пригодные
                # узлы и, если их нет ни одного, перезапросить у панели другой формат. Здесь
                # остаётся взять из ответа то, что нужно учёту.
                sub_fetch "$url" || fail "подписка не скачалась${SUB_ANSWER:+: $(sub_answer error)}"
                dev_warn="$(sub_answer warn)"
                # Ссылка из ответа, а не та, что просили: движок мог перезапросить подписку с
                # суффиксом /json, и обновлять в следующий раз надо по ТОЙ ссылке. Прежде это
                # решение дублировалось здесь строкой `url="${url%/}/json"` — то есть
                # оболочка повторяла правило, которое применил не она.
                _u="$(sub_answer url)"
                [ -n "$_u" ] && url="$_u"
                kind=url
                ;;
            vless://*)
                # Пробелы между ссылками превращаем в переводы строк: из однострочного
                # поля ввода многострочная вставка приезжает склеенной пробелами.
                printf '%s\n' "$url" | tr ' \t' '\n\n' | grep '^vless://' > "$SUB.tmp" \
                    || fail "в тексте нет ссылок vless://"
                [ -s "$SUB.tmp" ] || { rm -f "$SUB.tmp"; fail "в тексте нет ссылок vless://"; }
                mv "$SUB.tmp" "$SUB"
                kind=links
                ;;
            *) fail "нужна ссылка на подписку (http:// или https://) либо ссылка vless://" ;;
        esac
        # Новая подписка — новые узлы, значит клиента надо перечитать. Иначе туннель
        # продолжает работать по узлу, которого в подписке может уже не быть.
        #
        # Словом, а не пустым файлом: пустой затирал накопленное «instances» (подписку
        # задают как раз при заведении выхода, до применения), и новый туннель оставался
        # без экземпляра. Повод здесь именно params — набор выходов подписка не меняет.
        dirty_mark "$VLESS_DIRTY" params
        # Ссылка сохраняется, чтобы её можно было обновить одной кнопкой и показать
        # человеку, откуда взялись узлы. В uci, а не в спеке: спека — вход движка, и
        # URL ему не нужен ни для чего.
        #
        # Файл конфигурации создаётся здесь: пакет его не кладёт, а `uci set` в
        # несуществующий файл молча ничего не делает — ссылка «сохранялась» и пропадала,
        # причём sub_set отвечал ok. Тихая потеря настройки хуже отказа.
        #
        # Для vless:// сохраняется ВИД, а не текст: показывать человеку обратно ссылку с
        # его же ключом незачем, а обновлять её нечем — обновляют подписку, не ссылку.
        uci_file || fail "не удалось создать $UCI_SPLIFY2 — кончилось место?"
        [ "$kind" = url ] && sub_put "$SUB_NAME" url "$url" || sub_put "$SUB_NAME" url ""
        sub_put "$SUB_NAME" kind "$kind"
        # Название: что дал человек, иначе то, что назвала панель. Своё имя переписывать
        # ответом панели нельзя — человек его для того и вписал.
        [ -n "$sub_title" ] || sub_title="$(sub_answer title)"
        [ -n "$sub_title" ] && sub_put "$SUB_NAME" title "$sub_title"
        uci -q commit splify2
        json_init
        json_add_boolean ok 1
        json_add_string kind "$kind"
        json_add_string name "$SUB_NAME"
        json_add_string title "${sub_title:-}"
        json_add_string path "$SUB"
        json_add_int bytes "$(wc -c 2>/dev/null < "$SUB" || echo 0)"
        # Сколько узлов движок счёл ПРИГОДНЫМИ. Считал он их тем же кодом, которым читает
        # подписку при подъёме туннеля, — значит это то самое число, по которому туннель и
        # поднимется. Прежде оболочка добывала его отдельным запуском движка и регулярным
        # выражением по его JSON, поэтому в ответ оно не попадало вовсе.
        [ -n "$(sub_answer usable)" ] && json_add_int usable "$(sub_answer usable)"
        # Сказанное панелью про устройство — в ответе, а не в журнале: человек нажал кнопку
        # и должен узнать там же, что скачалась заглушка, а не гадать позже по туннелю,
        # который «настроен и не работает».
        [ -n "${dev_warn:-}" ] && json_add_string warn "$dev_warn"
        json_add_string hwid "$(hwid)"
        # Остаток трафика — в ответе на ту же кнопку, которая ходила к панели. Иначе обзор
        # показывал бы прежние числа до следующего опроса, а человек только что нажал
        # «Обновить» именно затем, чтобы увидеть свежие.
        sub_userinfo_emit
        json_dump
        ;;

    sub_info)
        # `|| input=''` ЗДЕСЬ БЫЛО ОШИБКОЙ. ubus отдаёт JSON без завершающего перевода
        # строки, и `read` в этом случае возвращает ненулевой код, УЖЕ ЗАПОЛНИВ переменную.
        # Ветка `||` затирала прочитанное: имя подписки не доезжало, метод отвечал по
        # первой, и на экране у второй подписки стояли чужие числа. Остальные методы
        # читают вход простым `read -r input` — по той же причине.
        input=''
        read -r input 2>/dev/null || true
        sub_use "$(jsonfilter -s "${input:-{\}}" -e '@.name' 2>/dev/null)"
        json_init
        json_add_string url "$(sub_get "$SUB_NAME" url)"
        json_add_string name "$SUB_NAME"
        # Вид источника: url — подписка, которую можно обновить; links — вставленные
        # руками ссылки, обновлять которые нечем. Интерфейсу это нужно, чтобы не
        # предлагать «Обновить» там, где обновление ничего не значит.
        json_add_string kind "$(sub_kind_of "$SUB_NAME")"
        json_add_string path "$SUB"
        # Идентификатор устройства отдаётся ВСЕГДА, а не только после скачивания: человек
        # заводит роутер в панели заранее, и найти там свою коробку он может только по этой
        # строке. Пустая строка значит «не из чего считать» — ни одного физического порта с
        # постоянным MAC; тогда заголовок не уходит вовсе, и об этом говорит sub_set.
        json_add_string hwid "$(hwid)"
        if [ -s "$SUB" ]; then
            json_add_boolean present 1
            json_add_int bytes "$(wc -c 2>/dev/null < "$SUB" || echo 0)"
            json_add_int mtime "$(date -r "$SUB" +%s 2>/dev/null || echo 0)"
        else
            json_add_boolean present 0
        fi
        # Остаток трафика — тот, что запомнен с последнего обращения к панели. Сюда он
        # приходит БЕЗ запроса наружу: sub_info спрашивают по кругу вместе с остальным
        # состоянием, и ходить с роутера к панели каждые пять секунд нельзя. Обновляет
        # его отдельный метод sub_quota, который зовут по нажатию и по устареванию.
        #
        # Поля `quota` нет вовсе — значит панель остатка не сообщала: ни разу, либо в
        # последний раз промолчала. Интерфейс к этому готов и говорит об этом прямо.
        sub_userinfo_emit
        json_dump
        ;;

    sub_quota)
        # Спросить у панели остаток трафика. Отдельный метод, а не поле sub_info, и это
        # разделение по цене: sub_info спрашивают в общем опросе каждые пять секунд, а
        # здесь уходит запрос в интернет с таймаутом в двадцать секунд.
        #
        # Подписку метод НЕ подменяет — ни файл, ни узлы, ни выбранный узел. Поэтому его
        # можно звать при открытии обзора, ничем не рискуя: единственное следствие —
        # переписанный файл остатка.
        # `|| input=''` ЗДЕСЬ БЫЛО ОШИБКОЙ. ubus отдаёт JSON без завершающего перевода
        # строки, и `read` в этом случае возвращает ненулевой код, УЖЕ ЗАПОЛНИВ переменную.
        # Ветка `||` затирала прочитанное: имя подписки не доезжало, метод отвечал по
        # первой, и на экране у второй подписки стояли чужие числа. Остальные методы
        # читают вход простым `read -r input` — по той же причине.
        input=''
        read -r input 2>/dev/null || true
        sub_use "$(jsonfilter -s "${input:-{\}}" -e '@.name' 2>/dev/null)"
        url="$(sub_get "$SUB_NAME" url)"
        kind="$(sub_kind_of "$SUB_NAME")"
        json_init
        json_add_boolean ok 1
        json_add_string kind "$kind"
        json_add_string name "$SUB_NAME"
        if [ "$kind" != url ] || [ -z "$url" ]; then
            # Спрашивать некого: узлы вставлены ссылками vless:// (или их нет вовсе), а
            # ссылка не панель — заголовков у неё не бывает. Отказом это не считаем:
            # человек ничего не сделал не так.
            json_add_boolean asked 0
            json_add_string why "узлы заданы ссылками vless:// — остаток брать негде: его сообщает панель подписки, а не ссылка"
        elif sub_quota_ask "$url"; then
            json_add_boolean asked 1
        else
            json_add_boolean asked 1
            # Две разные причины одним полем намеренно: интерфейс в обоих случаях говорит
            # одно и то же («панель не сообщает остаток»), а различить их можно в журнале.
            json_add_string why "панель не сообщила остаток трафика"
        fi
        sub_userinfo_emit
        json_dump
        ;;

    sub_list)
        # Все подписки роутера одним ответом. Именно списком, а не по одной: экран VLESS
        # показывает их вместе, и десять вызовов ради десяти строк — это десять запусков
        # shell на роутере с 64 МБ.
        #
        # Остаток здесь приходит ЗАПОМНЕННЫЙ, как и в sub_info: наружу за ним ходит
        # отдельный sub_quota, который зовут по нажатию.
        json_init
        json_add_array subs
        for n in $(sub_names); do
            sub_use "$n"
            json_add_object ""
            json_add_string name "$SUB_NAME"
            json_add_string title "$(sub_get "$SUB_NAME" title)"
            json_add_string url "$(sub_get "$SUB_NAME" url)"
            json_add_string kind "$(sub_kind_of "$SUB_NAME")"
            json_add_string path "$SUB"
            if [ -s "$SUB" ]; then
                json_add_boolean present 1
                json_add_int bytes "$(wc -c 2>/dev/null < "$SUB" || echo 0)"
                json_add_int mtime "$(date -r "$SUB" +%s 2>/dev/null || echo 0)"
            else
                json_add_boolean present 0
            fi
            # Сколько выходов на неё ссылается: по этому числу интерфейс говорит, чем
            # занята подписка, и отказывается удалять занятую.
            json_add_int used "$(sub_used_by "$SUB")"
            sub_userinfo_emit
            json_close_object
        done
        json_close_array
        json_add_string hwid "$(hwid)"
        json_dump
        ;;

    sub_del)
        # Удалить подписку целиком: файл узлов, запомненный остаток и ключи uci.
        #
        # ЗАНЯТУЮ НЕ УДАЛЯЕМ. Выход читает файл узлов при подъёме, и снос файла под живым
        # выходом — это правило, которое ведёт в туннель без единого узла: маршрутизация
        # выглядит настроенной, а трафик не идёт никуда. Поэтому отказ со словами, чем она
        # занята, а не молчаливое удаление.
        read -r input
        json_load "$input" 2>/dev/null || fail "неразбираемый запрос"
        json_get_var sub_name name
        [ -n "$sub_name" ] || fail "не указано имя подписки"
        sub_use "$sub_name"
        used="$(sub_used_by "$SUB")"
        [ "${used:-0}" = 0 ] || fail "подписка занята выходами: $used"
        rm -f "$SUB" "$SUB_INFO"
        if [ "$SUB_NAME" = main ]; then
            uci -q delete splify2.main.sub_url 2>/dev/null
            uci -q delete splify2.main.sub_kind 2>/dev/null
            uci -q delete splify2.main.sub_title 2>/dev/null
        else
            uci -q delete "splify2.sub_$SUB_NAME" 2>/dev/null
        fi
        uci -q commit splify2
        # Узлы сменились для всех, кто их читал, — клиента надо перечитать.
        dirty_mark "$VLESS_DIRTY" params
        json_init
        json_add_boolean ok 1
        json_add_string name "$SUB_NAME"
        json_dump
        ;;

    backup_get)
        # Архив уезжает СТРОКОЙ и по кускам, а файл собирается в браузере. Готового способа
        # отдать файл в проекте нет (экспорта логов или диагностики не было), а cgi-io
        # означал бы второй путь наружу со своими правами и своей проверкой — ровно тот
        # довод, по которому и свой список грузится через ubus, а не загрузкой файла.
        read -r input
        off="$(jsonfilter -s "$input" -e '@.offset' 2>/dev/null)"
        case "$off" in ''|*[!0-9]*) off=0 ;; esac
        # Пересобирается только на первом куске: пересборка на каждом означала бы, что
        # куски приезжают из разных мгновений и склеиваются в файл, которого не было.
        if [ "$off" = 0 ]; then
            backup_build > "$BACKUP_OUT" || { rm -f "$BACKUP_OUT"; fail "не удалось собрать архив"; }
        fi
        [ -s "$BACKUP_OUT" ] || fail "архив не собран — запросите его с начала"
        total="$(wc -c 2>/dev/null < "$BACKUP_OUT" || echo 0)"
        # Отказ на СОБСТВЕННОМ пределе восстановления, а не молчаливая отдача. Иначе экспорт
        # выдавал бы файл, который его же импорт откажется принять, — а узнать об этом
        # человек смог бы только в тот день, когда бекап понадобился.
        if [ "$total" -gt "$BACKUP_MAX_BYTES" ]; then
            rm -f "$BACKUP_OUT"
            fail "настройки со своими списками не влезают в архив: $((total / 1024)) КБ при пределе $((BACKUP_MAX_BYTES / 1024)) КБ"
        fi
        # Заплатка `printf X` и срезание её обратно: подстановка команды съедает
        # ЗАВЕРШАЮЩИЕ переводы строки, а кусок обязан приехать байт в байт — иначе на
        # границе куска пропадает перевод строки и две строки настроек склеиваются в одну.
        text="$(tail -c "+$((off + 1))" "$BACKUP_OUT" | head -c "$BACKUP_CHUNK"; printf X)"
        text="${text%X}"
        got="$(printf '%s' "$text" | wc -c)"
        next=$((off + got))
        eof=0
        [ "$next" -ge "$total" ] && eof=1
        json_init
        json_add_boolean ok 1
        json_add_int format "$BACKUP_FORMAT"
        json_add_int total "$total"
        json_add_int offset "$off"
        json_add_int next "$next"
        json_add_boolean eof "$eof"
        json_add_string text "$text"
        json_dump
        # Через `if`, а не через `&&`: последняя команда ветки задаёт код возврата всего
        # скрипта, и на непоследнем куске он оказался бы ненулевым без всякой ошибки.
        if [ "$eof" = 1 ]; then rm -f "$BACKUP_OUT"; fi
        ;;

    backup_put)
        # Восстановление. Присланный файл — НЕДОВЕРЕННЫЙ ВВОД, и это главная мысль всей
        # ветки: до сих пор спеку писал только root через spec_set, а теперь её содержимое
        # приносит человек файлом, взятым неизвестно откуда (I-003: движок подставляет
        # lan_device в popen без фильтрации, и до импорта это была теоретическая слабость).
        # Поэтому порядок такой: принять по кускам с пределом на размер → разложить строгим
        # разборщиком по разделам → проверить КАЖДЫЙ раздел отдельно → и только потом
        # писать на диск.
        #
        # Применения здесь нет и быть не должно: восстановленное человек видит как
        # неприменённое и применяет сам (модель «сохранено ≠ применено», ApplyPill).
        read -r input
        json_load "$input" 2>/dev/null || fail "неразбираемый запрос"
        text=''; append=''; final=''
        json_get_var text text
        json_get_var append append
        json_get_var final final
        case "$append" in 1|true) ;; *) rm -f "$BACKUP_IN" ;; esac
        # Размер накопленного — через проверку существования И с верным порядком
        # перенаправлений (подробно — у backup_check_spec): отсутствующий файл иначе печатает
        # жалобу самой оболочки рядом с ответом, а пустое значение уезжает в json_add_int.
        have=0
        [ -f "$BACKUP_IN" ] && have="$(wc -c 2>/dev/null < "$BACKUP_IN" || echo 0)"
        add="$(printf '%s' "$text" | wc -c)"
        # Предел считается по НАКОПЛЕННОМУ, а не по куску: иначе он обходится самым обычным
        # способом им пользоваться — прислать двадцать кусков по пределу каждый. Ровно эта
        # ошибка уже была в list_put и стоила отдельной правки.
        if [ "$((have + add))" -gt "$BACKUP_MAX_BYTES" ]; then
            rm -f "$BACKUP_IN"
            fail "архив больше $((BACKUP_MAX_BYTES / 1024)) КБ — столько настроек не бывает"
        fi
        printf '%s' "$text" >> "$BACKUP_IN" || { rm -f "$BACKUP_IN"; fail "не записалось — кончилось место?"; }
        case "$final" in
            1|true) ;;
            *)  json_init; json_add_boolean ok 1; json_add_int bytes "$((have + add))"; json_dump; exit 0 ;;
        esac
        [ -s "$BACKUP_IN" ] || { rm -f "$BACKUP_IN"; fail "пустой архив"; }
        # Управляющие байты — отдельной проверкой на весь файл и до разбора: перевод строки
        # и табуляция законны, всё прочее в текстовом файле настроек означает либо двоичный
        # мусор, либо попытку спрятать строку от построчного разборщика.
        if [ "$(LC_ALL=C tr -d '\11\12\40-\377' < "$BACKUP_IN" | wc -c)" != 0 ]; then
            rm -f "$BACKUP_IN"
            fail "в архиве двоичные данные — это не файл настроек"
        fi
        D="/tmp/splify2-restore.$$"
        rm -rf "$D"
        mkdir -p "$D/clean" || fail "не удалось развернуть архив"
        why="$(backup_split "$BACKUP_IN" "$D")" || backup_giveup "${why:-архив не разбирается}"
        any=0
        for f in "$D/spec" "$D/sub" "$D/options" "$D"/list.*; do [ -f "$f" ] && any=1; done
        [ "$any" = 1 ] || backup_giveup "в архиве нет ни настроек, ни списков"
        if [ -f "$D/spec" ]; then
            why="$(backup_check_spec "$D/spec")" || backup_giveup "спека из архива: ${why:-не годится}"
        fi
        if [ -f "$D/sub" ]; then
            why="$(backup_check_sub "$D/sub")" || backup_giveup "${why:-подписка из архива не годится}"
        fi
        if [ -f "$D/options" ]; then
            why="$(backup_check_options "$D/options")" || backup_giveup "${why:-настройки из архива не годятся}"
        fi
        # Свои списки — ТЕМ ЖЕ санитайзером, что и list_put. Второй проверки формата здесь
        # быть не должно: расхождение между «что принимает загрузка» и «что принимает
        # восстановление» означало бы список, который нельзя вернуть на свой же роутер.
        # Одна строка на список, поля через двоеточие: в имени списка двоеточия быть не
        # может (проверено разборщиком), поэтому разбирается обратно однозначно.
        entries=''
        for f in "$D"/list.*; do
            [ -f "$f" ] || continue
            b="${f##*/}"; rest="${b#list.}"; k="${rest%%.*}"; nm="${rest#*.}"
            sz="$(wc -c 2>/dev/null < "$f" || echo 0)"
            [ "$sz" -le "$LIST_MAX_BYTES" ] ||
                backup_giveup "список «$nm» больше $((LIST_MAX_BYTES / 1024)) КБ — столько на роутер не кладём"
            sanitize_list "$k" "$f" "$D/clean/$b" "$D/clean/$b.stat"
            kept=0; dropped=0
            read -r kept dropped < "$D/clean/$b.stat"
            entries="$entries $k:$nm:${kept:-0}:${dropped:-0}"
        done
        # ---- с этого места пишем на диск ----
        # Списки и подписка ложатся ДО проверки спеки движком, и это не небрежность: спека
        # из архива ссылается на них путями, а движок при --dry-run читает и файлы списков,
        # и файл подписки. Положив спеку первой, мы получили бы отказ компилятора на
        # файлах, которые едут в том же архиве.
        warn=''
        for e in $entries; do
            k="${e%%:*}"; rest="${e#*:}"; nm="${rest%%:*}"
            dest="$(custom_path "$nm" "$k")"
            mkdir -p "$(dirname "$dest")"
            # Перенос внутри одной ФС, как в list_put: между /tmp (tmpfs) и overlay busybox
            # копирует, и обрыв оставил бы на месте рабочего списка обрубок.
            cp "$D/clean/list.$k.$nm" "$dest.new.$$" && mv "$dest.new.$$" "$dest" ||
                { rm -f "$dest.new.$$"; warn="${warn}список $nm не записался; "; }
        done
        sub_done=0
        if [ -f "$D/sub" ]; then
            mkdir -p "$(dirname "$SUB")"
            cp "$D/sub" "$SUB.new.$$" && mv "$SUB.new.$$" "$SUB" ||
                { rm -f "$SUB.new.$$"; backup_giveup "подписка не записалась — кончилось место?"; }
            sub_done=1
        fi
        if [ -f "$D/options" ]; then
            # Файл конфигурации создаётся здесь по той же причине, что и в sub_set: `uci set`
            # в несуществующий файл молча ничего не делает, и настройка «восстанавливалась»
            # бы, отчитываясь успехом.
            #
            # Почему через uci_file, а не перенаправлением, — в объяснении у самой функции:
            # отказ перенаправления у встроенной команды уносит оболочку целиком, и метод
            # умирает без ответа. Стенд это и поймал — сначала здесь.
            uci_file || backup_giveup "не удалось создать $UCI_SPLIFY2 — кончилось место?"
            uci -q get splify2.main >/dev/null 2>&1 || uci -q set splify2.main=splify2
            while IFS= read -r ln; do
                [ -n "$ln" ] || continue
                uci -q set "splify2.main.${ln%%=*}=${ln#*=}"
            done < "$D/options"
            uci -q commit splify2
        fi
        spec_done=0
        if [ -f "$D/spec" ]; then
            mkdir -p "$(dirname "$SPEC")"
            # Списки издателя доскачиваются перед проверкой — ровно как в spec_set: движок
            # умирает на отсутствующем файле списка, а восстановление на чистый роутер тем и
            # отличается, что зеркал категорий там ещё нет (в архив они не едут намеренно).
            fetch_warn="$(fetch_missing_lists "$D/spec")"
            if ! err="$("$STEER" apply --dry-run --spec "$D/spec" 2>&1 >/dev/null)"; then
                backup_giveup "${fetch_warn:+$fetch_warn; }${err:-движок отверг спеку из архива}. Списки и подписка из архива при этом уже восстановлены."
            fi
            [ -n "$fetch_warn" ] && warn="$warn$fetch_warn; "
            # Снимок применённого — ДО подмены. Иначе восстановленное выглядело бы
            # применённым: applied_get при отсутствии снимка отдаёт саму спеку, и пилюля
            # «Применить · N» показала бы ноль на только что заменённой настройке.
            if [ ! -s "$APPLIED" ]; then
                if [ -s "$SPEC" ]; then cp "$SPEC" "$APPLIED" 2>/dev/null
                else printf '{"schema":1,"outputs":{},"channels":[]}\n' > "$APPLIED"
                fi
            fi
            cp "$D/spec" "$SPEC.new.$$" && mv "$SPEC.new.$$" "$SPEC" ||
                { rm -f "$SPEC.new.$$"; backup_giveup "спека не записалась — кончилось место?"; }
            spec_done=1
        fi
        # Восстановление меняет и подписку, и САМ НАБОР выходов, а клиент vless с
        # обфускатором читают своё один раз при старте. Признак поэтому instances, а не
        # params: экземпляра для появившегося выхода ещё нет, и сигналить некому.
        dirty_mark "$VLESS_DIRTY" instances
        dirty_mark "$VLESS_DIRTY" params
        dirty_mark "$OBFS_DIRTY" instances
        dirty_mark "$OBFS_DIRTY" params
        json_init
        json_add_boolean ok 1
        json_add_boolean spec "$spec_done"
        json_add_boolean sub "$sub_done"
        json_add_array lists
        for e in $entries; do
            k="${e%%:*}"; rest="${e#*:}"; nm="${rest%%:*}"; rest="${rest#*:}"
            json_add_object ""
            json_add_string name "$nm"
            json_add_string kind "$k"
            json_add_int count "${rest%%:*}"
            json_add_int dropped "${rest#*:}"
            json_close_object
        done
        json_close_array
        [ -n "$warn" ] && json_add_string warn "$warn"
        json_dump
        rm -rf "$D"
        rm -f "$BACKUP_IN"
        ;;

    xsteer_state)
        # Живое состояние туннелей xsteer: разгрузка, рукопожатие, восстановления, счётчики.
        #
        # ЗАЧЕМ ОТДЕЛЬНЫЙ МЕТОД, А НЕ ПОЛЕ live. Туннель xsteer, поднятый через netifd, движку не
        # принадлежит: в спеке он — обычный `kind: interface`, и `status` про него знает ровно то,
        # что знает про любое устройство (поднято ли, счётчики). Всё остальное — какой хаб, сколько
        # секунд назад было рукопожатие, встала ли разгрузка сегментации, сколько раз соединение
        # переподнималось и почему в последний раз — знает только сам процесс пира, и он пишет это в
        # свой файл состояния. Складывать это в `live` значило бы платить чтением файлов на каждый
        # круг опроса всем, у кого xsteer нет вовсе.
        #
        # Ответ ОТДАЁТСЯ ПЕЧАТЬЮ, а не собирается jshn: содержимое файла — уже готовый JSON от
        # движка, и разобрать его, чтобы тут же собрать заново, значило бы переписывать чужую схему
        # у себя. Так же поступает метод `status` — и по той же причине.
        #
        # Имена секций uci ограничены [A-Za-z0-9_], но проверяются всё равно: правило I-003 гласит,
        # что имя, попадающее в путь или в командную строку, проверяет тот, кто его подставляет, а
        # не тот, кто его записал.
        _now=$(date +%s)
        printf '{"ok":true,"tunnels":{'
        _first=1
        for _s in $(uci -q show network 2>/dev/null | sed -n \
                    "s/^network\.\([^.]*\)\.proto='xsteer'$/\1/p"); do
            backup_safe_word "$_s" || continue
            _dev=$(uci -q get "network.$_s.device_name")
            [ -n "$_dev" ] || _dev="xs-$_s"
            backup_safe_word "$_dev" || continue
            _f="$XS_STATE_DIR/xsteer-$_dev.json"
            [ "$_first" = 1 ] || printf ','
            _first=0
            printf '"%s":{"device":"%s"' "$_s" "$_dev"
            if [ -f "$_f" ]; then
                # ВОЗРАСТ ФАЙЛА, а не «свежий/несвежий»: порог решает интерфейс, потому что он
                # знает, как часто спрашивает. Процесс, которого убили, оставляет файл лежать
                # навсегда — и без возраста его последнее «up: true» выглядело бы живым.
                _mt=$(date -r "$_f" +%s 2>/dev/null || echo "$_now")
                printf ',"age":%s,"state":%s' "$((_now - _mt))" "$(cat "$_f" 2>/dev/null)"
            else
                # Файла нет — туннель не поднимался в этой загрузке. Это НЕ ошибка и не пустое
                # состояние: разница между «не поднимался» и «поднят и молчит» ровно та, за которой
                # человек сюда и пришёл.
                printf ',"state":null'
            fi
            printf '}'
        done
        printf '}}\n'
        ;;

    xsteer_link)
        # Ссылка xs:// в обе стороны, и направление выбирает ВХОД, а не отдельный метод.
        #
        #   {"iface":"home"}     → ссылка на этот туннель: тот же доступ перенести на телефон.
        #   {"link":"xs://…"}    → текст конфигурации из ссылки: им заполняет поля страница сети.
        #
        # Так же устроена и подкоманда движка (`steer xsteer-link`), и по той же причине: человек
        # здесь всегда хочет «дай мне другой вид того же самого», и спрашивать его, какой именно,
        # значило бы заставлять называть то, что уже видно из запроса.
        #
        # ПЕЧАТАЕТ И РАЗБИРАЕТ ДВИЖОК, а не этот скрипт. Формат описан один раз (steer,
        # src/ext/xslink.c) и сверяется побайтово с половиной на Go; своя сборка или разбор строки
        # здесь были бы третьей реализацией одного формата — и первой, у которой нет стенда. Ровно
        # поэтому страница сети, умеющая разбирать файл в стиле wg своим кодом, ссылку разбирать
        # сама НЕ должна: она приводит её сюда и получает файл.
        read -r input
        json_load "$input" 2>/dev/null || fail "неразбираемый запрос"
        json_get_var iface iface
        json_get_var link link
        if [ -n "$link" ]; then
            case "$link" in
                xs://*) ;;
                *) fail "это не ссылка xs:// — она начинается с «xs://»" ;;
            esac
            # Ссылка уходит движку СТАНДАРТНЫМ ВВОДОМ, а не аргументом: аргументы видны в списке
            # процессов всякому, кто есть на роутере, а в ссылке лежит приватный ключ.
            conf="$(printf '%s\n' "$link" | "$STEER" xsteer-link - 2>&1)"
            case "$conf" in
                '[Interface]'*) json_init; json_add_boolean ok 1
                                json_add_string conf "$conf"; json_dump ;;
                *) fail "ссылка не принята: $conf" ;;
            esac
            exit 0
        fi
        [ -n "$iface" ] || fail "нужно имя интерфейса или ссылка"
        backup_safe_word "$iface" || fail "негодное имя интерфейса"
        [ "$(uci -q get "network.$iface.proto")" = xsteer ] || \
            fail "интерфейс $iface не xsteer"
        # ИСТОЧНИК — ГОТОВЫЙ ФАЙЛ, собранный обработчиком протокола из uci. Собирать конфигурацию
        # здесь во второй раз нельзя: два места, превращающие uci в настройку, однажды разойдутся,
        # и разойдутся молча. Отсюда следствие, которое названо человеку прямо: у выключенного
        # интерфейса файла нет, и ссылку отдать неоткуда.
        conf="$XS_RUN/$iface.conf"
        [ -f "$conf" ] || fail "интерфейс $iface выключен — ссылку печатать не из чего: она \
собирается из той же настройки, которой поднят туннель. Включите интерфейс."
        link="$("$STEER" xsteer-link "$conf" --name "$iface" 2>&1)"
        case "$link" in
            xs://*) json_init; json_add_boolean ok 1; json_add_string link "$link"; json_dump ;;
            *) fail "движок не напечатал ссылку: $link" ;;
        esac
        ;;

    xsteer_link_put)
        # Принять ссылку: положить её содержимое в настройку СУЩЕСТВУЮЩЕГО интерфейса xsteer.
        #
        # ПОЧЕМУ НЕ СОЗДАЁТ ИНТЕРФЕЙС. У интерфейса есть то, чего в ссылке нет и быть не может:
        # зона фаервола, имя устройства, участие в спеке движка. Созданный здесь туннель без зоны
        # выглядел бы настроенным и не вёз бы трафик — то есть мы бы своими руками сделали ровно то
        # состояние, отличать которое учит весь остальной этот файл. Создание остаётся за страницей
        # сети, а этот метод заполняет уже созданное.
        #
        # РАЗБИРАЕТ ССЫЛКУ ДВИЖОК, и он же её проверяет. Ссылка приходит от человека, то есть это
        # недоверенный ввод; разбирать её здесь на sed значило бы держать третью реализацию формата
        # и надеяться, что она отвергает то же самое. Движок отвечает текстом конфигурации, и уже
        # из него берутся значения — по строкам, а не по позициям.
        read -r input
        json_load "$input" 2>/dev/null || fail "неразбираемый запрос"
        json_get_var iface iface
        json_get_var link link
        [ -n "$iface" ] || fail "нужно имя интерфейса"
        backup_safe_word "$iface" || fail "негодное имя интерфейса"
        [ -n "$link" ] || fail "нужна ссылка xs://"
        case "$link" in xs://*) ;; *) fail "это не ссылка xs:// — она начинается с «xs://»" ;; esac
        [ "$(uci -q get "network.$iface.proto")" = xsteer ] || \
            fail "интерфейс $iface не xsteer — создайте его в настройках сети и выберите протокол xsteer"
        # Ссылка уходит движку СТАНДАРТНЫМ ВВОДОМ, а не аргументом: аргументы видны в списке
        # процессов всякому, кто есть на роутере, а в ссылке лежит приватный ключ.
        conf="$(printf '%s\n' "$link" | "$STEER" xsteer-link - 2>&1)"
        case "$conf" in
            '[Interface]'*) ;;
            *) fail "ссылка не принята: $conf" ;;
        esac
        priv=$(printf '%s\n' "$conf" | sed -n 's/^PrivateKey = //p')
        addr=$(printf '%s\n' "$conf" | sed -n 's/^Address = //p')
        sni=$(printf '%s\n' "$conf" | sed -n 's/^SNI = //p')
        mtu=$(printf '%s\n' "$conf" | sed -n 's/^MTU = //p')
        pub=$(printf '%s\n' "$conf" | sed -n 's/^PublicKey = //p')
        allowed=$(printf '%s\n' "$conf" | sed -n 's/^AllowedIPs = //p')
        ep=$(printf '%s\n' "$conf" | sed -n 's/^Endpoint = //p')
        ka=$(printf '%s\n' "$conf" | sed -n 's/^PersistentKeepalive = //p')
        [ -n "$priv" ] && [ -n "$addr" ] && [ -n "$pub" ] && [ -n "$ep" ] || \
            fail "движок вернул конфигурацию без обязательных полей — это ошибка движка, не ссылки"
        uci -q set "network.$iface.private_key=$priv"
        uci -q delete "network.$iface.addresses"
        uci -q add_list "network.$iface.addresses=$addr"
        if [ -n "$sni" ]; then uci -q set "network.$iface.sni=$sni"
        else uci -q delete "network.$iface.sni"; fi
        if [ -n "$mtu" ]; then uci -q set "network.$iface.mtu=$mtu"
        else uci -q delete "network.$iface.mtu"; fi
        # Пиры интерфейса ЗАМЕЩАЮТСЯ целиком: ссылка описывает доступ, а не добавку к нему, и
        # оставленный рядом прежний пир означал бы туннель к двум хабам сразу — состояние, которого
        # в звезде не бывает.
        # Секция пира ищется ПО ТИПУ, а не по имени: страница сети создаёт её безымянной
        # (uci.add), и такая секция называется по-разному в разных выпусках uci — cfg0d1234 у
        # одного, @xsteer_home[0] у другого. Тип же записан ровно один.
        for _p in $(uci -q show network 2>/dev/null | sed -n \
                    "s/^network\.\([^.]*\)=xsteer_$iface\$/\1/p"); do
            uci -q delete "network.$_p"
        done
        _sec=$(uci -q add network "xsteer_$iface")
        [ -n "$_sec" ] || fail "не удалось создать секцию пира — кончилось место в overlay?"
        uci -q set "network.$_sec.public_key=$pub"
        uci -q set "network.$_sec.endpoint_host=${ep%:*}"
        uci -q set "network.$_sec.endpoint_port=${ep##*:}"
        [ -n "$allowed" ] && {
            uci -q delete "network.$_sec.allowed_ips"
            _old_ifs="$IFS"; IFS=','
            for _a in $allowed; do
                _a=$(echo "$_a" | tr -d ' ')
                [ -n "$_a" ] && uci -q add_list "network.$_sec.allowed_ips=$_a"
            done
            IFS="$_old_ifs"
        }
        [ -n "$ka" ] && uci -q set "network.$_sec.persistent_keepalive=$ka"
        uci -q commit network || fail "не удалось записать настройку сети"
        # Интерфейс поднимается заново СРАЗУ: человек вставил ссылку, чтобы туннель заработал, а не
        # чтобы получить запись в файле. ifup не ждёт результата, поэтому дальше интерфейс
        # рассказывает о себе сам — через xsteer_state.
        ifup "$iface" >/dev/null 2>&1 || true
        json_init
        json_add_boolean ok 1
        json_add_string iface "$iface"
        json_add_string hub "$ep"
        json_dump
        ;;

    zm_fix|zm_fix_set)
        # Фикс Zapret Manager: уводить ли адреса GitHub в туннель. Включён по умолчанию — он
        # нужен именно тем, кто ещё ничего не настроил и до GitHub не дошёл.
        uci_file || fail "не удалось создать $UCI_SPLIFY2 — кончилось место?"
        uci -q get splify2.main >/dev/null 2>&1 || uci -q set splify2.main=splify2
        if [ "$2" = zm_fix_set ]; then
            read -r input
            json_load "$input" 2>/dev/null || fail "неразбираемый запрос"
            json_get_var on on
            case "$on" in
                1|true) uci -q set splify2.main.zm_fix=1 ;;
                0|false) uci -q set splify2.main.zm_fix=0 ;;
                *) fail "нужно true или false" ;;
            esac
            uci -q commit splify2
            json_init; json_add_boolean ok 1
            zm_fix_on && json_add_boolean on 1 || json_add_boolean on 0
            json_dump
        else
            json_init
            zm_fix_on && json_add_boolean on 1 || json_add_boolean on 0
            # Имя канала — чтобы интерфейс мог показать, что именно появится в правилах.
            json_add_string channel "$ZM_CHANNEL"
            json_dump
        fi
        ;;

    fetch_mode|fetch_mode_set)
        # Качать списки и пакеты через туннель или нет. Два состояния, и других быть не
        # должно: переключатель значит то, что на нём написано, а не «мы сами решим, если не
        # вышло». Умолчание — нет.
        #
        # Имя выхода отдаётся вместе с состоянием: без поднятого выхода включать нечего, и
        # знать это надо до выбора, а не после. Считает его та же функция, что и само
        # скачивание, — иначе интерфейс обещал бы один выход, а файл ехал бы через другой.
        uci_file || fail "не удалось создать $UCI_SPLIFY2 — кончилось место?"
        uci -q get splify2.main >/dev/null 2>&1 || uci -q set splify2.main=splify2
        if [ "$2" = fetch_mode_set ]; then
            read -r input
            json_load "$input" 2>/dev/null || fail "неразбираемый запрос"
            json_get_var mode mode
            case "$mode" in
                always|off) ;;
                *) fail "режим бывает always или off" ;;
            esac
            uci -q set splify2.main.fetch_via_tunnel="$mode"
            uci -q commit splify2
            json_init; json_add_boolean ok 1; json_add_string mode "$mode"; json_dump
        else
            json_init
            fetch_tunnel_on && json_add_string mode always || json_add_string mode off
            json_add_string out "$(fetch_out | cut -d' ' -f1)"
            json_dump
        fi
        ;;

    ui_get|ui_set)
        # Память мастера: какие выходы он создал, как человек их назвал, что в каждом.
        #
        # Отдельно от спеки, и это принципиально. Спека — вход движка, и «как человек назвал
        # outbound» ему не нужно ни для чего; дописать туда своё поле значило бы, что движок
        # обязан его сохранять при любой правке, то есть управляющий слой протёк в модель.
        #
        # А знать это надо, иначе мастер не отличит свои записи от чужих. Прежде он узнавал их
        # по зашитым именам («сервисы», выход «vpn»), и на живом роутере это провалилось сразу:
        # там канал назывался funny и выход vless, настроенные руками. Мастер их не увидел и
        # предложил создать рядом второй туннель — то есть тихо развёл настройку на две.
        #
        # Хранится как непрозрачная строка: разбирать её здесь нечем и незачем, а формат
        # принадлежит интерфейсу и будет меняться вместе с ним.
        uci_file || fail "не удалось создать $UCI_SPLIFY2 — кончилось место?"
        uci -q get splify2.main >/dev/null 2>&1 || uci -q set splify2.main=splify2
        if [ "$2" = ui_set ]; then
            read -r input
            json_load "$input" 2>/dev/null || fail "неразбираемый запрос"
            json_get_var state state
            uci -q set splify2.main.wizard="$state"
            uci -q commit splify2
            json_init; json_add_boolean ok 1; json_dump
        else
            json_init
            json_add_string state "$(uci -q get splify2.main.wizard)"
            json_dump
        fi
        ;;

    dev_stats)
        # Счёт устройств живёт в /usr/lib/splify2/fast.sh — там же, откуда его берёт круг
        # опроса. Одна реализация на два входа: копия здесь означала бы два места, где
        # считаются одни и те же числа, и они разошлись бы молча.
        #
        # Метод остался ради совместимости: страница спрашивает его отдельно только на
        # движке без метода `live` (старый пакет интерфейса), а вызывать его есть кому и
        # снаружи — контракт docs/rpcd-api.md объявлен и не отзывается.
        . "${FAST_SH:-/usr/lib/splify2/fast.sh}"
        fast_devices
        ;;

    diag)
        # Проверки состояния — движок печатает JSON сам. Отдаём дословно по той же причине,
        # что и status: свой разбор здесь означал бы вторую модель проверок в shell, которая
        # начнёт расходиться с движком при первой же новой проверке.
        #
        # Ненулевой код возврата — НЕ повод для ошибки: движок возвращает 1, когда нашёл
        # поломку, и это ровно тот ответ, который надо показать. Проверяем по виду вывода.
        out="$("$STEER" diag --spec "$SPEC" 2>/dev/null)"
        case "$out" in
            '{'*) printf '%s\n' "$out" ;;
            *) fail "движок не умеет diag — обновите steer" ;;
        esac
        ;;

    net_info)
        # Сведения о сети считает /usr/lib/splify2/fast.sh — тот же довод, что у dev_stats:
        # одна реализация на два входа. Там же записано, почему внешнего адреса здесь нет.
        . "${FAST_SH:-/usr/lib/splify2/fast.sh}"
        printf '{%s}\n' "$(fast_net)"
        ;;

    outbound_geo)
        # Где выходит трафик этого выхода: страна и адрес, как их видит внешняя сторона.
        #
        # ЗАЧЕМ МЕРИТЬ, А НЕ ЧИТАТЬ. Имя узла подписки («🇩🇪 Германия №2») пишет продавец, и
        # это подпись, а не факт: узел мог переехать, а у выходов поверх WireGuard и xsteer
        # имени нет вовсе. Поэтому спрашиваем у внешней стороны — и спрашиваем ЧЕРЕЗ САМ
        # ВЫХОД, привязав запрос к его устройству (`curl --interface`). Тогда ответ описывает
        # ровно ту точку, из которой роутер выходит в интернет, и способ один на все виды
        # выходов: у vless устройство создаёт сам движок, у остальных оно и так есть.
        #
        # ПОЧЕМУ ОТВЕТ ЗАПОМИНАЕТСЯ. Обращение наружу стоит секунд, а страница открывается
        # часто. Свежее измерение отдаётся из файла мгновенно, и только устаревшее (старше
        # GEO_TTL) заставляет сходить в сеть. Интерфейс к тому же рисует запомненное ещё до
        # ответа метода — вместе это и убирает паузу на открытии.
        read -r input
        json_load "$input" 2>/dev/null || fail "неразбираемый запрос"
        json_get_var output output
        json_get_var fresh fresh
        [ -n "$output" ] || fail "не указан выход"
        case "$output" in *[!a-zA-Z0-9_-]*) fail "недопустимое имя выхода" ;; esac

        _geo_f="$GEO_DIR/geo-$output"
        _geo_now="$(date +%s)"
        _geo_ip=''; _geo_cc=''; _geo_at=0; _geo_ms=''
        if [ -s "$_geo_f" ]; then
            read -r _geo_at _geo_cc _geo_ip _geo_id _geo_ms < "$_geo_f"
            case "${_geo_at:-}" in ''|*[!0-9]*) _geo_at=0 ;; esac
            # Прочерк в файле означает «страну не назвали»: поле в строке обязано быть,
            # иначе следующее (адрес) прочиталось бы на его место.
            [ "${_geo_cc:-}" = "-" ] && _geo_cc=''
            # Выход с тех пор пересоздали — значит и выходим мы теперь в другом месте.
            # Прежнее измерение не отдаём вовсе: «Эстония» рядом с только что выбранной
            # Польшей хуже пустоты, потому что выглядит как ответ.
            if [ -n "${_geo_id:-}" ] && [ "$_geo_id" != "$(geo_ident "$output")" ]; then
                _geo_at=0; _geo_cc=''; _geo_ip=''; _geo_ms=''
            fi
        fi
        _geo_age=$(( _geo_now - _geo_at ))

        # БЕЗ `fresh` МЕТОД НЕ ХОДИТ В СЕТЬ ВООБЩЕ — и это главное в нём.
        #
        # LuCI складывает вызовы страницы в ОДИН запрос к ubus и выполняет их подряд, поэтому
        # медленный вызов задерживает все остальные: пока этот метод ждал ответа из сети,
        # обзор восемь секунд писал «Загрузка…», хотя состояние движка было готово через
        # четверть секунды. Замерено на роутере: пакет вызовов занимал 5,6 с при 150-250 мс
        # на каждый вызов по отдельности.
        #
        # Поэтому обычный вызов отвечает тем, что запомнено (пусть даже пустотой), а
        # устаревшее измерение обновляется В ФОНЕ и приедет к следующему опросу. Поток
        # фонового процесса уводится в /dev/null нарочно: иначе он держал бы открытой
        # трубу, из которой rpcd читает ответ, и вызов не завершился бы до конца curl.
        if [ "$fresh" != "1" ] && [ "$fresh" != "true" ]; then
            if [ "$_geo_at" -le 0 ] || [ "$_geo_age" -ge "$GEO_TTL" ]; then
                geo_refresh "$output" >/dev/null 2>&1 &
            fi
            json_init
            json_add_string output "$output"
            [ -n "$_geo_ip" ] && json_add_string ip "$_geo_ip"
            [ -n "$_geo_cc" ] && json_add_string cc "$_geo_cc"
            # Время ответа того же запроса. Ноль означает «не мерили» — так читаются и
            # строки, записанные прежней версией, где пятого поля не было вовсе.
            [ "${_geo_ms:-0}" -gt 0 ] 2>/dev/null && json_add_int ms "$_geo_ms"
            [ "$_geo_at" -gt 0 ] && json_add_int at "$_geo_at"
            json_add_boolean cached 1
            json_dump
            exit 0
        fi

        json_init
        json_add_string output "$output"
        if geo_refresh "$output"; then
            read -r _geo_at _geo_cc _geo_ip _geo_id _geo_ms < "$GEO_DIR/geo-$output"
            [ "${_geo_cc:-}" = "-" ] && _geo_cc=''
            unset _geo_id
            json_add_string ip "$_geo_ip"
            [ -n "$_geo_cc" ] && json_add_string cc "$_geo_cc"
            [ "${_geo_ms:-0}" -gt 0 ] 2>/dev/null && json_add_int ms "$_geo_ms"
            json_add_int at "$_geo_at"
            json_add_boolean cached 0
        else
            # Измерить не вышло. Прежнее измерение всё равно отдаём: «где мы выходили в
            # прошлый раз» полезнее пустоты, а его возраст виден по полю at.
            [ -n "$_geo_ip" ] && json_add_string ip "$_geo_ip"
            [ -n "$_geo_cc" ] && json_add_string cc "$_geo_cc"
            [ "${_geo_ms:-0}" -gt 0 ] 2>/dev/null && json_add_int ms "$_geo_ms"
            [ "$_geo_at" -gt 0 ] && json_add_int at "$_geo_at"
            json_add_string why "через выход не ответили — выход не поднят, нет curl или молчит адрес проверки"
        fi
        json_dump
        ;;

    outbound_probe)
        # Отклик по ОДНОМУ выходу за вызов — по той же причине, что у vless_probe: проверка
        # упирается в таймаут, и «проверить все» не уложилось бы в срок жизни вызова ubus.
        #
        # Два разных способа, потому что это два разных вопроса. У vless отклик мерит сам
        # движок: ICMP через TUN не ходит вовсе, и ping показал бы «нет ответа» у исправного
        # туннеля. У обычного устройства меряем ping через него.
        read -r input
        json_load "$input" 2>/dev/null || fail "неразбираемый запрос"
        json_get_var output output
        [ -n "$output" ] || fail "не указан выход"
        kind=''
        for o in $("$STEER" outputs --kind vless --spec "$SPEC" 2>/dev/null); do
            [ "$o" = "$output" ] && kind=vless
        done
        json_init
        json_add_string output "$output"
        if [ "$kind" = vless ]; then
            out="$("$STEER" vless-probe "$output" --node -1 --timeout 6 --spec "$SPEC" 2>/dev/null)"
            ms="$(printf '%s' "$out" | sed -n 's/.*"ttfb_ms":[ ]*\([0-9]*\).*/\1/p')"
            case "$ms" in
                ''|*[!0-9]*) json_add_string state 'нет ответа'; json_add_int ms -1 ;;
                *) json_add_string state ok; json_add_int ms "$ms" ;;
            esac
            json_add_string how 'через туннель: ICMP по нему не ходит, меряет движок'
        else
            dev="$("$STEER" status --spec "$SPEC" 2>/dev/null |
                   sed -n "s/.*\"$output\":{[^}]*\"device\":\"\([^\"]*\)\".*/\1/p" | head -1)"
            if [ -z "$dev" ]; then
                json_add_string state 'нет устройства'; json_add_int ms -1
            else
                r="$(ping -c 1 -W 3 -I "$dev" 1.1.1.1 2>/dev/null | sed -n 's/.*time=\([0-9.]*\).*/\1/p' | head -1)"
                case "$r" in
                    '') json_add_string state 'нет ответа'; json_add_int ms -1 ;;
                    *)  json_add_string state ok; json_add_int ms "${r%%.*}" ;;
                esac
            fi
            json_add_string how 'ping через устройство выхода'
        fi
        json_dump
        ;;

    leases)
        # Аренды DHCP — чтобы «кого касается» выбирали из имён устройств, а не набирали MAC
        # руками. Опечатка в MAC не совпадёт ни с чем и не пожалуется: правило просто не будет
        # действовать, и объяснить это человеку будет нечем.
        json_init
        json_add_array leases
        while read -r _exp mac ip name _rest; do
            [ -n "$mac" ] || continue
            json_add_object
            json_add_string mac "$mac"
            json_add_string ip "$ip"
            # «*» в файле аренд значит «имени не сообщил». Показывать звёздочку человеку
            # незачем — пусть будет пусто, а интерфейс подставит адрес.
            [ "$name" = '*' ] && name=''
            json_add_string name "$name"
            json_close_object
        done < /tmp/dhcp.leases 2>/dev/null
        json_close_array
        json_dump
        ;;

    engine_state)
        # Состояние экземпляров движка и его последние слова.
        #
        # Понадобилось из-за того, что «выход настроен» и «туннель несёт трафик» — разные
        # вещи, а до сих пор интерфейс различал их только по наличию устройства. Устройство
        # у vless создаёт сам процесс туннеля, поэтому мёртвый туннель виден как пропавшее
        # устройство — но НЕ видно, почему он умер, и человеку оставалось лезть в logread.
        #
        # Движок теперь завершается с ненулевым кодом, когда туннель перестал нести трафик
        # (раньше в этом случае возвращался ноль, и procd с интерфейсом считали, что всё
        # прошло успешно). Значит procd знает про отказ, и это знание можно показать.
        #
        # Текст сообщений движка здесь НЕ разбирается, и это осознанно: их формулировки
        # меняются вместе с движком, а разбор на стороне интерфейса означал бы, что каждая
        # правка сообщения тихо ломает показ. Отдаём последние строки дословно — человек
        # прочитает их сам, а согласовывать нечего.
        # Собираем ДО json_init своего ответа: json_load затирает разбираемый документ,
        # и смешивать чужой разбор со своей сборкой в одном наборе нельзя.
        names=''
        state="$(ubus call service list '{"name":"steer","verbose":true}' 2>/dev/null)"
        if [ -n "$state" ] && json_load "$state" 2>/dev/null &&
           json_select steer 2>/dev/null && json_select instances 2>/dev/null; then
            json_get_keys inames
            for nm in $inames; do
                json_select "$nm" 2>/dev/null || continue
                json_get_var r running
                json_get_var p pid
                # Имя экземпляра — vless_<выход>, а выход проверен движком при apply:
                # пробелов и кавычек в нём быть не может, поэтому список через пробел.
                names="$names $nm:${r:-0}:${p:-0}"
                json_select ..
            done
        fi
        # Последние слова движка. Дословно и без разбора — см. пояснение выше.
        lines="$(logread -l 300 2>/dev/null | grep 'steer' | tail -12)"

        json_init
        json_add_object instances
        for e in $names; do
            nm="${e%%:*}"; rest="${e#*:}"
            json_add_object "$nm"
            json_add_boolean running "${rest%%:*}"
            json_add_int pid "${rest##*:}"
            json_close_object
        done
        json_close_object
        json_add_array log
        # Перебор построчно: в строках журнала есть пробелы, кавычки и что угодно ещё,
        # поэтому только IFS-разделение по переводу строки, а экранирование — на json_add_string.
        OIFS="$IFS"; IFS='
'
        for l in $lines; do json_add_string "" "$l"; done
        IFS="$OIFS"
        json_close_array
        json_dump
        ;;

    vless_nodes)
        read -r input
        json_load "$input" 2>/dev/null || fail "неразбираемый запрос"
        json_get_var output output
        [ -n "$output" ] || fail "не указан выход"
        # Движок печатает JSON сам — отдаём дословно. Разбирать его здесь значило бы
        # держать вторую модель узла в shell, а имена узлов приходят из подписки и
        # содержат что угодно, включая кавычки.
        raw="$("$STEER" vless-nodes "$output" --spec "$SPEC" 2>&1)"
        out="$(json_tail "$raw")"
        [ -n "$out" ] || fail "${raw:-движок не ответил}"
        printf '%s\n' "$out"
        ;;

    vless_probe)
        read -r input
        json_load "$input" 2>/dev/null || fail "неразбираемый запрос"
        json_get_var output output
        json_get_var node node
        [ -n "$output" ] || fail "не указан выход"
        # По одному узлу за вызов: проверка упирается в таймаут, и «проверить все» на
        # подписке из двадцати шести узлов заняло бы дольше, чем живёт вызов ubus.
        # Интерфейс спрашивает по одному и заполняет таблицу постепенно.
        [ -n "$node" ] || node=-1
        raw="$("$STEER" vless-probe "$output" --node "$node" --timeout 6 --spec "$SPEC" 2>&1)"
        out="$(json_tail "$raw")"
        [ -n "$out" ] || fail "${raw:-движок не ответил}"
        printf '%s\n' "$out"
        ;;

    # ================ DNS over HTTPS ==========================================
    doh_state)
        # Всё, что нужно вкладке, одним вызовом: без этого она делала бы четыре — за
        # состоянием службы, за каталогом, за выбранным и за туннелем, — а каждый вызов
        # это запуск скрипта объекта (см. шапку файла про 126 мс платы).
        json_init
        doh_installed && json_add_boolean installed 1 || json_add_boolean installed 0
        doh_running   && json_add_boolean running 1   || json_add_boolean running 0
        doh_enabled   && json_add_boolean enabled 1   || json_add_boolean enabled 0
        # Выбранный пункт каталога. Пусто — законное состояние: либо ничего не настроено,
        # либо в конфигурации стоит чужая ссылка (вписана руками, взята из версии менеджера
        # новее нашей). Второй случай отличается от первого непустым urls.
        json_add_string active "$(doh_active 2>/dev/null)"
        # БЕЗ КОНВЕЙЕРА, и это не стиль. `... | while read` исполняет тело в ПОДОБОЛОЧКЕ, а
        # jshn накапливает ответ в переменных оболочки: из подоболочки они не возвращаются
        # никуда. Массив выходил ПУСТЫМ при полностью исправном на вид коде — то есть вкладка
        # DoH открывалась без единого резолвера в списке, и выбрать было нечего. Поймано
        # стендом rpcdmatch. Поэтому строки перебираются подстановкой с IFS по переводу
        # строки: сама подстановка происходит в этой же оболочке.
        _dl_ifs="$IFS"
        json_add_array urls
        IFS='
'
        for u in $(doh_urls 2>/dev/null); do
            IFS="$_dl_ifs"
            [ -n "$u" ] && json_add_string "" "$u"
            IFS='
'
        done
        IFS="$_dl_ifs"
        json_close_array
        json_add_array providers
        IFS='
'
        for row in $(doh_items 2>/dev/null); do
            IFS="$_dl_ifs"
            pid="${row%%|*}"; ptitle="${row#*|}"
            if [ -n "$pid" ]; then
                json_add_object
                json_add_string id "$pid"
                json_add_string title "$ptitle"
                json_close_object
            fi
            IFS='
'
        done
        IFS="$_dl_ifs"
        json_close_array
        doh_tunnel_on && json_add_boolean via_tunnel 1 || json_add_boolean via_tunnel 0
        # Через какой выход пойдёт (или уже идёт) DoH. Называется он здесь ровно затем,
        # чтобы человек не думал, будто есть отдельный выбор: выбора нет, это первый
        # ПОДНЯТЫЙ выход с устройством. Считает его та же функция, что ставит маршрут, —
        # иначе интерфейс обещал бы один выход, а трафик шёл бы через другой.
        json_add_string out "$(doh_out 2>/dev/null | cut -d' ' -f1)"
        # force_dns — ключ, который заворачивает весь DNS сети на роутер. Мы его выключаем,
        # когда движку нужен свой резолвер доменных каналов: два перенаправления на порт 53
        # в одной точке дают гонку, и проиграв, наш резолвер молча перестаёт видеть запросы
        # (доменные правила действуют «через раз»). Показывается, потому что иначе это
        # выглядит как «включил force_dns в файле, а splify2 его сбросил».
        doh_needs_dnsd && json_add_boolean needs_dnsd 1 || json_add_boolean needs_dnsd 0
        json_add_string force_dns "$(doh_force_dns)"
        json_dump
        ;;

    doh_set)
        read -r input
        json_load "$input" 2>/dev/null || fail "неразбираемый запрос"
        json_get_var provider provider
        [ -n "$provider" ] || fail "не выбран резолвер"
        doh_installed || fail "https-dns-proxy не установлен"
        doh_has "$provider" || fail "нет такого резолвера в каталоге: $provider"
        doh_write "$provider" || fail "не удалось записать $DOH_CONF — кончилось место?"
        doh_apply || fail "настройка записана, но служба не перезапустилась"
        # Правила «через туннель» пересобираются здесь же: пользователь службы задаётся той
        # же записью настройки, и правило ссылается на него. Порядок обратный оставил бы
        # правило, отбирающее трафик пользователя, которого в настройке уже нет.
        doh_rules_sync
        json_init
        json_add_boolean ok 1
        json_add_string active "$(doh_active 2>/dev/null)"
        json_add_string force_dns "$(doh_force_dns)"
        json_dump
        ;;

    doh_off)
        doh_installed || fail "https-dns-proxy не установлен"
        doh_off
        doh_rules_sync
        json_init; json_add_boolean ok 1; json_dump
        ;;

    doh_tunnel_set)
        read -r input
        json_load "$input" 2>/dev/null || fail "неразбираемый запрос"
        json_get_var on on
        uci_file || fail "не удалось создать $UCI_SPLIFY2 — кончилось место?"
        uci -q get splify2.main >/dev/null 2>&1 || uci -q set splify2.main=splify2
        case "$on" in
            1|true) uci -q set splify2.main.doh_via_tunnel=1 ;;
            0|false) uci -q set splify2.main.doh_via_tunnel=0 ;;
            *) fail "нужно true или false" ;;
        esac
        uci -q commit splify2
        doh_rules_sync
        json_init
        json_add_boolean ok 1
        doh_tunnel_on && json_add_boolean on 1 || json_add_boolean on 0
        json_add_string out "$(doh_out 2>/dev/null | cut -d' ' -f1)"
        json_dump
        ;;

    # ================ обход DPI (zapret) ======================================
    zapret_state)
        json_init
        zp_installed && json_add_boolean installed 1 || json_add_boolean installed 0
        zp_running   && json_add_boolean running 1   || json_add_boolean running 0
        json_add_string version "$(zp_version 2>/dev/null)"
        # Чем проверять стратегии. Без curl проверка невозможна, и сказать об этом надо ДО
        # того, как человек нажмёт кнопку: ключи, которыми меряет Zapret Manager (сроки,
        # предел скорости, диапазон байт), у uclient-fetch выразить нечем, а мерить другим
        # инструментом значило бы получить числа, несравнимые с его числами.
        command -v curl >/dev/null 2>&1 && json_add_boolean curl 1 || json_add_boolean curl 0
        json_add_int strategies "$(zp_count)"
        json_add_int updated "$(cat "$ZP_STAMP" 2>/dev/null || echo 0)"
        json_add_string active "$(zp_active_global 2>/dev/null)"
        # Разошлась ли активная стратегия с тем, что теперь в каталоге. Ночное обновление
        # активную НЕ трогает (требование владельца), поэтому расхождение — законное
        # состояние, и единственный способ узнать о нём — спросить.
        _za="$(zp_active_global 2>/dev/null)"
        if [ -n "$_za" ] && zp_drifted "$_za" /dev/null 2>/dev/null; then
            json_add_boolean drifted 1
        else
            json_add_boolean drifted 0
        fi
        json_dump
        ;;

    zapret_install)
        # Ставится ОТСЮДА, а не зависимостью пакета, и это решение: обход нужен не всем, а
        # архив релиза весит под полмегабайта на архитектуру и приезжает не из репозитория
        # OpenWrt, а из GitHub Releases — жёсткая зависимость сделала бы splify2
        # неустанавливаемым у тех, кто ставит интерфейс первым. Тот же довод, по которому в
        # depends нет самого движка (см. шапку build.sh).
        zp_installed && { json_init; json_add_boolean ok 1
                          json_add_string note "обход DPI уже установлен"; json_dump; exit 0; }
        arch="$(awk -F\' '/DISTRIB_ARCH/ { print $2 }' /etc/openwrt_release 2>/dev/null)"
        [ -n "$arch" ] || fail "не определилась архитектура роутера"
        ver="${ZAPRET_VERSION:-72.20260307}"
        url="https://github.com/remittor/zapret-openwrt/releases/download/v$ver/zapret_v${ver}_${arch}.zip"
        tmpd="$(mktemp -d /tmp/splify2-zapret-pkg.XXXXXX)" || fail "нет места в /tmp"
        if ! download "$url" "$tmpd/z.zip"; then
            rm -rf "$tmpd"
            fail "не удалось скачать $url${FETCH_NOTE:+ ($FETCH_NOTE)}"
        fi
        command -v unzip >/dev/null 2>&1 || pkg_add_name unzip
        command -v unzip >/dev/null 2>&1 || { rm -rf "$tmpd"; fail "нужен unzip, поставить не удалось"; }
        unzip -oq "$tmpd/z.zip" -d "$tmpd" 2>/dev/null || { rm -rf "$tmpd"; fail "архив не распаковался"; }
        # apk на 24.10+ и opkg на 23.05 и старше: в архиве лежат оба формата, и брать нужно
        # тот, который понимает менеджер этого роутера.
        # Порядок важен: сам обход первым, страница LuCI второй — она от него зависит.
        # Ставится через pkg_add_file, а не своим вызовом менеджера: там уже разобрано и
        # различие ключей у apk и opkg, и повтор после `opkg update` на свежей прошивке,
        # где списков пакетов нет вовсе.
        err=""
        if [ "$PM" = apk ]; then zglob="$tmpd/apk/zapret-*.apk $tmpd/apk/luci-app-zapret-*.apk"
        else zglob="$tmpd/zapret_*.ipk $tmpd/luci-app-zapret_*.ipk"
        fi
        for f in $zglob; do
            [ -f "$f" ] || continue
            pkg_add_file "$f" >/dev/null 2>&1 || err="$err $(basename "$f")"
        done
        rm -rf "$tmpd"
        zp_installed || fail "пакеты не встали:${err:- неизвестно почему}"
        # curl нужен проверке стратегий, и ставится он ЗДЕСЬ, а не при нажатии «Проверить»:
        # там человек ждёт результата, а не установки пакета. Неудача не отменяет установки
        # обхода — она только лишает проверки, о чём скажет zapret_state.
        command -v curl >/dev/null 2>&1 || pkg_add_name curl
        # Каталог стратегий сразу: без него вкладка открывается пустой, и человек не понимает,
        # установилось ли что-нибудь.
        zp_sync >/dev/null 2>&1
        json_init
        json_add_boolean ok 1
        json_add_string version "$(zp_version 2>/dev/null)"
        json_add_int strategies "$(zp_count)"
        command -v curl >/dev/null 2>&1 && json_add_boolean curl 1 || json_add_boolean curl 0
        json_dump
        ;;

    zapret_remove)
        zp_installed || { json_init; json_add_boolean ok 1; json_dump; exit 0; }
        # Проверка снимается первой: она держит своё правило nftables и свой обработчик, и
        # снести пакет под ними значило бы оставить очередь, в которую никто не смотрит.
        start-stop-daemon -K -p "$ZP_PIDFILE" >/dev/null 2>&1
        "$ZP_INIT" stop >/dev/null 2>&1
        # Через pkg_del, а не своим вызовом менеджера: различие ключей у apk и opkg
        # разобрано там, и второй его разбор здесь разошёлся бы с первым. Порядок обратный
        # установке — страница LuCI первой, обход вторым: она от него зависит.
        pkg_del luci-app-zapret
        pkg_del zapret
        # Каталог и результаты остаются: они ничего не занимают, а поставить обход заново —
        # обычное дело, и терять из-за этого результаты часовой проверки незачем.
        json_init
        zp_installed && json_add_boolean ok 0 || json_add_boolean ok 1
        json_dump
        ;;

    zapret_sync)
        zp_installed || fail "обход DPI не установлен"
        zp_sync || fail "каталог стратегий обновить не удалось${FETCH_NOTE:+: $FETCH_NOTE}"
        json_init
        json_add_boolean ok 1
        json_add_int strategies "$(zp_count)"
        json_add_int updated "$(cat "$ZP_STAMP" 2>/dev/null || echo 0)"
        [ -n "$FETCH_NOTE" ] && json_add_string note "$FETCH_NOTE"
        json_dump
        ;;

    zapret_strategies)
        # Имена и семейства — здесь; числа проверки — отдельным методом (zapret_results),
        # дословным файлом. Соединяет их интерфейс: разбирать пятьдесят объектов JSON в
        # shell ради того же самого JSON — работа ради работы.
        #
        # Семейство печатается, а не выводится в интерфейсе из имени: правило «начинается
        # с Yv» — это знание о чужом каталоге, и держать его на двух сторонах значило бы
        # переименование у автора ломает разбор молча.
        json_init
        json_add_string active "$(zp_active_global 2>/dev/null)"
        json_add_int updated "$(cat "$ZP_STAMP" 2>/dev/null || echo 0)"
        # Без конвейера — по той же причине, что в doh_state выше: тело конвейера идёт в
        # подоболочке, и накопленный jshn из неё не возвращается. Массив выходил пустым, то
        # есть каталог в интерфейсе был пуст при полном каталоге на диске.
        _zs_ifs="$IFS"
        json_add_array strategies
        IFS='
'
        for n in $(zp_names 2>/dev/null); do
            IFS="$_zs_ifs"
            if [ -n "$n" ]; then
                json_add_object
                json_add_string name "$n"
                case "$n" in
                    general*) json_add_string family flowseal ;;
                    Yv*)      json_add_string family yv ;;
                    v[0-9]*)  json_add_string family v ;;
                    *)        json_add_string family other ;;
                esac
                json_close_object
            fi
            IFS='
'
        done
        IFS="$_zs_ifs"
        json_close_array
        # Какие выходы kind=zapret есть и что у каждого применено. Спрашивается у движка
        # (`steer status`), а не у файлов: имя выхода и его вид знает он, а мы знаем только
        # содержимое файла ключей — и файл, оставшийся от удалённого выхода, выглядел бы
        # как живой выход.
        json_add_array outputs
        st="$("$STEER" status --spec "$SPEC" 2>/dev/null)"
        for o in $("$STEER" outputs --kind zapret --spec "$SPEC" 2>/dev/null); do
            json_add_object
            json_add_string name "$o"
            json_add_string strategy "$(zp_active_out "$o" 2>/dev/null)"
            json_add_int queue "$(printf '%s' "$st" | jsonfilter -e "@.outputs.$o.queue" 2>/dev/null || echo 0)"
            case "$(printf '%s' "$st" | jsonfilter -e "@.outputs.$o.up" 2>/dev/null)" in
                true) json_add_boolean up 1 ;;
                *)    json_add_boolean up 0 ;;
            esac
            json_close_object
        done
        json_close_array
        json_dump
        ;;

    zapret_apply)
        read -r input
        json_load "$input" 2>/dev/null || fail "неразбираемый запрос"
        json_get_var name name
        json_get_var out out
        [ -n "$name" ] || fail "не выбрана стратегия"
        zp_installed || fail "обход DPI не установлен"
        zp_has "$name" || fail "нет такой стратегии в каталоге: $name"
        if [ -n "$out" ]; then
            # Выход обязан существовать И быть нужного вида: файл ключей, положенный для
            # выхода kind=interface, никто никогда не прочитает, а в интерфейсе стратегия
            # будет выглядеть применённой.
            "$STEER" outputs --kind zapret --spec "$SPEC" 2>/dev/null |
                grep -qxF "$out" || fail "нет выхода kind=zapret с именем $out"
            zp_apply_out "$out" "$name" || fail "стратегия $name не записалась (её не принял nfqws?)"
            # Сигнал, а не перезапуск движка: перезапуск снял бы правила и уронил туннели,
            # то есть каждая проба другой стратегии стоила бы секунд без интернета.
            /etc/init.d/steer reload_zapret >/dev/null 2>&1
        else
            zp_apply_global "$name" || fail "стратегия $name не записалась в $ZP_CONF"
            zp_restart || fail "стратегия записана, но обход не перезапустился"
        fi
        json_init
        json_add_boolean ok 1
        json_add_string name "$name"
        [ -n "$out" ] && json_add_string out "$out"
        json_dump
        ;;

    zapret_test_start)
        read -r input 2>/dev/null || input='{}'
        json_load "${input:-{\}}" 2>/dev/null
        json_get_var scope scope 2>/dev/null
        case "${scope:-all}" in
            all|flowseal|v|yv) ;;
            *) fail "набор бывает all, flowseal, v или yv" ;;
        esac
        zp_installed || fail "обход DPI не установлен"
        [ -s "$ZP_CATALOG" ] || fail "каталог стратегий пуст — обновите его"
        command -v curl >/dev/null 2>&1 || fail "нужен curl: без него проверять нечем"
        [ -x "$ZAPRET_TEST" ] || fail "нет $ZAPRET_TEST"
        # Уже идёт — не запускаем вторую: две проверки поделили бы одну очередь и один
        # диапазон портов, и числа обеих оказались бы неверны, ни разу об этом не сказав.
        if start-stop-daemon -K -t -p "$ZP_PIDFILE" >/dev/null 2>&1; then
            fail "проверка уже идёт"
        fi
        # ФОНОМ, и в этом весь смысл: у вызова ubus свой срок жизни, а проверка идёт
        # десятки минут, и человек имеет право закрыть окно роутера. Ход и результат
        # проверка пишет в файлы, страница их читает.
        start-stop-daemon -S -b -m -p "$ZP_PIDFILE" -x "$ZAPRET_TEST" -- \
            --scope "${scope:-all}" >/dev/null 2>&1 || fail "проверку не удалось запустить"
        json_init; json_add_boolean ok 1; json_add_string scope "${scope:-all}"; json_dump
        ;;

    zapret_test_stop)
        start-stop-daemon -K -p "$ZP_PIDFILE" >/dev/null 2>&1
        # Правила изоляции и обработчик проверка снимает сама (trap на выходе). Но если её
        # убили жёстко, снять их некому — поэтому убираем и здесь: оставленная таблица
        # уводила бы в мёртвую очередь всё, что сядет на её диапазон портов.
        nft delete table inet "${ZT_TABLE:-splify2_ztest}" 2>/dev/null
        rm -f "$ZP_PROGRESS"
        json_init; json_add_boolean ok 1; json_dump
        ;;

    zapret_test)
        # Ход проверки. Дёшево нарочно: этот метод опрашивают раз в две секунды, пока
        # проверка идёт, поэтому здесь только чтение одного файла в /var — ни пакетного
        # менеджера, ни движка, ни каталога.
        json_init
        if [ -s "$ZP_PROGRESS" ]; then
            while IFS='=' read -r k v; do
                case "$k" in
                    state|scope|current) json_add_string "$k" "$v" ;;
                    started|total|done|targets) json_add_int "$k" "${v:-0}" ;;
                    error) json_add_string error_text "$v" ;;
                esac
            done < "$ZP_PROGRESS"
        else
            json_add_string state idle
        fi
        # Жив ли процесс НА САМОМ ДЕЛЕ. Файл хода мог остаться от проверки, которую убили
        # (снятие питания, OOM): без этой проверки страница показывала бы «идёт» вечно и не
        # давала запустить новую.
        start-stop-daemon -K -t -p "$ZP_PIDFILE" >/dev/null 2>&1 &&
            json_add_boolean running 1 || json_add_boolean running 0
        json_add_int results_at "$(sed -n 's/.*"at":\([0-9]*\).*/\1/p' "$ZP_RESULTS" 2>/dev/null | head -1 || echo 0)"
        json_dump
        ;;

    zapret_results)
        # ДОСЛОВНО тем файлом, который написала проверка. Файл — уже JSON нашего формата, и
        # пересборка его через jshn означала бы разбор и сборку пятидесяти объектов ради того
        # же самого текста. Тот же приём, что с `status` движка.
        if [ -s "$ZP_RESULTS" ]; then
            cat "$ZP_RESULTS"
        else
            printf '{"at":0,"targets":0,"baseline":0,"results":[]}\n'
        fi
        ;;

    *) fail "неизвестный метод" ;;
    esac
    ;;
esac
