{
  "luci-app-splify2": {
    "description": "Управление движком steer: каналы, выходы, списки, подписка VLESS",
    "read": {
      "uci": [
        "splify2",
        "network"
      ],
      "ubus": {
        "splify2": [
          "status",
          "spec_get",
          "explain",
          "lists",
          "devices",
          "local_lists",
          "engine",
          "sub_info",
          "vless_nodes",
          "vless_probe",
          "dev_stats",
          "diag",
          "engine_state",
          "ui_get",
          "steer_versions",
          "net_info",
          "outbound_probe",
          "leases",
          "splify2_versions"
        ]
      }
    },
    "write": {
      "uci": [
        "splify2",
        "firewall"
      ],
      "ubus": {
        "splify2": [
          "spec_set",
          "apply",
          "list_fetch",
          "list_remove",
          "sub_set",
          "ui_set",
          "steer_install",
          "engine_stop",
          "engine_start",
          "splify2_install",
          "list_put"
        ]
      }
    }
  }
}
